# -----------------------------------------------------------------------------
# KonXC Portfolio - Environment Variables Template
# -----------------------------------------------------------------------------
# Copy this file to .env and fill in the values.
# DO NOT commit the actual .env file to version control.

# --- App Configuration ---
# The base URL of your application
BETTER_AUTH_BASE_URL=http://localhost:4321
# Comma-separated allowed origins (optional, but recommended for production)
# Example: https://www.konxc.space,https://konxc.space,http://localhost:4321
BETTER_AUTH_TRUSTED_ORIGINS=
# A random secret string for session encryption
BETTER_AUTH_SECRET=your_secret_here

# --- Database (Turso / LibSQL) ---
# For Local: file:local.db
# For Production: libsql://your-db-name.turso.io
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# --- Authentication (OAuth) ---
# GitHub OAuth Credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Monitoring & Analytics (Optional) ---
# Public Google Analytics ID
PUBLIC_GA_ID=

# Site Mode (corporate | portfolio)
PUBLIC_SITE_MODE=corporate

