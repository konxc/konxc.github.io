---
// Header Component
import Logo from "@components/ui/Logo.astro";
import ThemeToggle from "@components/ui/ThemeToggle.astro";

export interface Props {
  className?: string;
  variant?: "default" | "transparent" | "minimal";
  showSearch?: boolean;
  showMobileMenu?: boolean;
}

const {
  className = "",
  variant = "default",
  showSearch = true,
  showMobileMenu = true,
} = Astro.props;

// Navigation links
const navigationLinks = [
  { name: "Beranda", href: "/", current: false },
  { name: "Layanan", href: "/services", current: false },
  { name: "Blog", href: "/blog", current: false },
  { name: "Kontributor", href: "/contributors", current: false },
  { name: "Tentang", href: "/about", current: false },
];

// Service dropdown links
const serviceLinks = [
  {
    name: "IT Support",
    href: "/services/it-support",
    description: "Dukungan teknis 24/7",
  },
  {
    name: "Software Development",
    href: "/services/software-development",
    description: "Pengembangan aplikasi custom",
  },
  {
    name: "Digital Branding",
    href: "/services/digital-branding",
    description: "Strategi branding digital",
  },
  {
    name: "Retail Technology",
    href: "/services/retail-tech",
    description: "Solusi teknologi retail",
  },
  {
    name: "Cloud & SaaS",
    href: "/services/cloud-saas",
    description: "Layanan cloud dan SaaS",
  },
];
---

<header class={`header ${variant} ${className}`} role="banner">
  <nav
    class="nav-container"
    role="navigation"
    aria-label="Main navigation"
    id="navigation"
  >
    <div class="container">
      <div class="nav-content">
        <!-- Logo -->
        <div class="nav-brand">
          <a href="/" class="brand-link">
            <Logo size="md" variant="default" />
          </a>
        </div>

        <!-- Desktop Navigation -->
        <div class="nav-desktop">
          <ul class="nav-links" role="menubar">
            {
              navigationLinks.map((link) => (
                <li class="nav-item" role="none">
                  {link.name === "Layanan" ? (
                    <div class="nav-dropdown">
                      <button
                        class="nav-link dropdown-trigger"
                        aria-expanded="false"
                        aria-haspopup="true"
                        aria-controls="services-menu"
                        role="menuitem"
                      >
                        {link.name}
                        <i
                          class="i-mdi-chevron-down dropdown-icon"
                          aria-hidden="true"
                        />
                      </button>
                      <div
                        class="dropdown-menu"
                        id="services-menu"
                        role="menu"
                        aria-labelledby="services-trigger"
                      >
                        <div class="dropdown-content">
                          {serviceLinks.map((service) => (
                            <a
                              href={service.href}
                              class="dropdown-item"
                              role="menuitem"
                            >
                              <div class="dropdown-item-content">
                                <h4 class="dropdown-item-title">
                                  {service.name}
                                </h4>
                                <p class="dropdown-item-description">
                                  {service.description}
                                </p>
                              </div>
                            </a>
                          ))}
                        </div>
                      </div>
                    </div>
                  ) : (
                    <a href={link.href} class="nav-link" role="menuitem">
                      {link.name}
                    </a>
                  )}
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Right Side Actions -->
        <div class="nav-actions">
          <!-- Search -->
          {
            showSearch && (
              <div class="search-container">
                <button
                  class="search-toggle"
                  aria-label="Toggle search"
                  aria-expanded="false"
                  aria-controls="search-dropdown"
                  aria-haspopup="true"
                >
                  <i class="i-mdi-magnify" aria-hidden="true" />
                </button>
                <div
                  class="search-dropdown"
                  id="search-dropdown"
                  role="search"
                  aria-label="Search form"
                >
                  <form class="search-form" role="search">
                    <div class="search-input-group">
                      <label for="search-input" class="sr-only">
                        Search articles and services
                      </label>
                      <input
                        type="search"
                        id="search-input"
                        placeholder="Cari artikel, layanan..."
                        class="search-input"
                        aria-label="Search articles and services"
                        autocomplete="off"
                      />
                      <button
                        type="submit"
                        class="search-submit"
                        aria-label="Submit search"
                      >
                        <i class="i-mdi-magnify" aria-hidden="true" />
                      </button>
                    </div>
                  </form>
                  <div class="search-suggestions">
                    <div class="search-suggestion-item">
                      <i class="i-mdi-clock-outline" />
                      <span>Pencarian terbaru</span>
                    </div>
                    <div class="search-suggestion-item">
                      <i class="i-mdi-trending-up" />
                      <span>Artikel populer</span>
                    </div>
                  </div>
                </div>
              </div>
            )
          }

          <!-- CTA Button -->
          <a href="/contact" class="cta-button">
            <span>Hubungi Kami</span>
            <i class="i-mdi-arrow-right"></i>
          </a>

          <!-- Theme Toggle -->
          <ThemeToggle size="md" variant="icon" />

          <!-- Mobile Menu Toggle -->
          {
            showMobileMenu && (
              <button
                class="mobile-menu-toggle"
                aria-label="Toggle mobile menu"
                aria-expanded="false"
                aria-controls="mobile-menu"
                aria-haspopup="true"
              >
                <span class="hamburger-line" aria-hidden="true" />
                <span class="hamburger-line" aria-hidden="true" />
                <span class="hamburger-line" aria-hidden="true" />
              </button>
            )
          }
        </div>
      </div>
    </div>

    <!-- Mobile Menu -->
    {
      showMobileMenu && (
        <div
          class="mobile-menu"
          id="mobile-menu"
          role="dialog"
          aria-modal="true"
          aria-labelledby="mobile-menu-title"
        >
          <div class="mobile-menu-content">
            <div class="mobile-menu-header">
              <Logo size="sm" variant="default" />
              <button class="mobile-menu-close" aria-label="Close mobile menu">
                <i class="i-mdi-close" />
              </button>
            </div>

            <div class="mobile-menu-body">
              <ul class="mobile-nav-links">
                {navigationLinks.map((link) => (
                  <li class="mobile-nav-item">
                    {link.name === "Layanan" ? (
                      <div class="mobile-nav-dropdown">
                        <button class="mobile-nav-link mobile-dropdown-trigger">
                          {link.name}
                          <i class="i-mdi-chevron-down" />
                        </button>
                        <div class="mobile-dropdown-content">
                          {serviceLinks.map((service) => (
                            <a href={service.href} class="mobile-dropdown-item">
                              <div class="mobile-dropdown-item-content">
                                <h4 class="mobile-dropdown-item-title">
                                  {service.name}
                                </h4>
                                <p class="mobile-dropdown-item-description">
                                  {service.description}
                                </p>
                              </div>
                            </a>
                          ))}
                        </div>
                      </div>
                    ) : (
                      <a href={link.href} class="mobile-nav-link">
                        {link.name}
                      </a>
                    )}
                  </li>
                ))}
              </ul>

              <div class="mobile-menu-actions">
                <a href="/contact" class="mobile-cta-button">
                  <span>Hubungi Kami</span>
                  <i class="i-mdi-arrow-right" />
                </a>
                <div class="mt-4 flex items-center gap-2 text-sm text-neutral-600 dark:text-neutral-400">
                  <span>Tema:</span>
                  <ThemeToggle size="sm" variant="icon" />
                </div>
              </div>
            </div>
          </div>
        </div>
      )
    }
  </nav>
</header>

<style is:global>
  @reference "@/styles/global.css";
  .header {
    @apply sticky top-0 z-50 border-b border-neutral-200/70 bg-white/95 backdrop-blur-md transition-all duration-300;
  }

  /* Default variant link colors */
  .header:not(.transparent) .nav-link,
  .header:not(.transparent) .search-toggle,
  .header:not(.transparent) .mobile-menu-toggle {
    @apply hover:text-primary-600 text-neutral-600;
  }

  .header:not(.transparent) .logo-text {
    @apply text-neutral-900;
  }

  /* Transparent variant - Overlay over dark heroes */
  .header.transparent:not(.scrolled) {
    @apply absolute top-0 left-0 w-full border-transparent bg-transparent;
  }

  .header.transparent:not(.scrolled) .nav-link,
  .header.transparent:not(.scrolled) .search-toggle,
  .header.transparent:not(.scrolled) .mobile-menu-toggle {
    @apply hover:text-primary-300 text-white;
  }

  .header.transparent:not(.scrolled) .logo-text {
    @apply text-white;
  }

  /* Scrolled state */
  .header.scrolled {
    @apply border-neutral-200/50 bg-white/80 shadow-lg backdrop-blur-md;
  }

  .header.transparent.scrolled .nav-link,
  .header.transparent.scrolled .search-toggle,
  .header.transparent.scrolled .mobile-menu-toggle {
    @apply hover:text-primary-600 text-neutral-700;
  }

  .header.transparent.scrolled .logo-text {
    @apply text-neutral-900;
  }

  /* Dark mode overrides */
  .dark .header {
    @apply border-site bg-header-site backdrop-blur-md;
  }

  .dark .header.scrolled {
    @apply border-site bg-header-site shadow-[0_4px_24px_rgba(0,0,0,0.4)];
  }

  .dark .header:not(.transparent) .nav-link,
  .dark .header:not(.transparent) .search-toggle,
  .dark .header:not(.transparent) .mobile-menu-toggle {
    @apply text-on-muted hover:text-white;
  }
  .header.scrolled {
    @apply border-b-2;
    background-color: var(--bg-base);
    border-color: var(--border-base);
  }

  /* Navigation */
  .nav-container {
    @apply mx-auto max-w-[1400px];
  }

  .nav-content {
    @apply flex h-20 items-center justify-between px-4 lg:px-8;
  }

  .nav-brand {
    @apply flex h-full items-center pr-8 lg:border-r-2;
    border-color: var(--border-base);
  }

  .brand-link {
    @apply flex items-center gap-2;
  }

  .nav-desktop {
    @apply hidden h-full flex-1 items-center pl-8 lg:flex;
  }

  .nav-links {
    @apply flex h-full items-center gap-6;
  }

  .nav-item {
    @apply relative flex h-full items-center;
  }

  .nav-link {
    @apply hover:text-primary-600 flex items-center gap-1 px-2 font-mono text-sm font-bold tracking-widest uppercase transition-colors;
    color: var(--text-base);
  }

  /* Dropdown styles */
  .nav-dropdown {
    @apply relative flex h-full items-center;
  }

  .dropdown-trigger {
    @apply cursor-pointer;
  }

  .dropdown-icon {
    @apply text-[1.25em] transition-transform duration-200;
  }

  .dropdown-trigger[aria-expanded="true"] .dropdown-icon {
    @apply rotate-180;
  }

  .dropdown-menu {
    @apply invisible absolute top-full left-0 mt-0 w-[480px] border-2 border-t-0 opacity-0 shadow-2xl transition-all duration-200;
    background-color: var(--bg-base);
    border-color: var(--border-base);
  }

  .dropdown-content {
    @apply grid grid-cols-1 p-0 md:grid-cols-2;
  }

  .dropdown-item {
    @apply hover:bg-primary-600 flex items-start gap-3 border-r-2 border-b-2 p-6 transition-colors last:border-b-0 hover:text-white;
    border-color: var(--border-base);
  }
  .dropdown-item:nth-child(even) {
    @apply border-r-0;
  }

  .dropdown-item-content {
    @apply flex flex-col;
  }

  .dropdown-item-title {
    @apply mb-1 font-mono text-sm font-bold uppercase;
    color: inherit;
  }

  .dropdown-item-description {
    @apply font-sans text-xs;
    color: inherit;
    opacity: 0.8;
  }

  .nav-actions {
    @apply flex h-full items-center gap-4 border-l-2 pl-4;
    border-color: var(--border-base);
  }

  .search-container {
    @apply relative flex h-full items-center border-r-2 pr-4;
    border-color: var(--border-base);
  }

  .search-toggle {
    @apply hover:text-primary-600 p-2 text-neutral-600 transition-colors;
  }

  .search-dropdown {
    @apply invisible absolute top-full right-0 mt-0 w-80 border-2 border-t-0 opacity-0 transition-all duration-200;
    background-color: var(--bg-base);
    border-color: var(--border-base);
  }

  .search-toggle[aria-expanded="true"] + .search-dropdown {
    @apply visible opacity-100;
  }

  .search-form {
    @apply border-b-2 p-4;
    background-color: var(--bg-base);
    border-color: var(--border-base);
  }

  .search-input-group {
    @apply border-border-site flex items-center border-2;
  }

  .search-input {
    @apply flex-1 border-0 bg-transparent px-3 py-2 font-mono text-sm outline-none;
    color: var(--text-base);
    &::placeholder {
      color: var(--text-placeholder);
    }
  }

  .search-submit {
    @apply hover:text-primary-600 bg-surface border-border-site border-l-2 p-2 text-neutral-600 transition-colors;
  }

  .search-suggestions {
    @apply space-y-2 p-4;
  }

  .search-suggestion-item {
    @apply flex cursor-pointer items-center gap-2 px-3 py-2 font-mono text-sm tracking-wider uppercase;
    color: var(--text-muted);
    &:hover {
      background-color: var(--primary-600);
      color: white;
    }
  }

  .cta-button {
    @apply hover:bg-primary-600 dark:hover:bg-primary-500 hidden items-center gap-2 border-2 border-black bg-black px-6 py-3 font-mono font-bold tracking-wider text-white uppercase transition-colors sm:flex dark:border-white dark:bg-white dark:text-black;
  }

  .mobile-menu-toggle {
    @apply hover:text-primary-600 p-2 text-neutral-600 transition-colors lg:hidden;
  }

  .hamburger-line {
    @apply mb-1 block h-0.5 w-5 bg-current transition-all duration-200 last:mb-0;
  }

  .mobile-menu-toggle[aria-expanded="true"] .hamburger-line:nth-child(1) {
    @apply translate-y-1.5 rotate-45;
  }

  .mobile-menu-toggle[aria-expanded="true"] .hamburger-line:nth-child(2) {
    @apply opacity-0;
  }

  .mobile-menu-toggle[aria-expanded="true"] .hamburger-line:nth-child(3) {
    @apply -translate-y-1.5 -rotate-45;
  }

  .mobile-menu {
    @apply invisible fixed inset-0 z-50 opacity-0 transition-all duration-300 lg:hidden;
  }

  .mobile-menu.active {
    @apply visible opacity-100;
  }

  .mobile-menu-content {
    @apply border-border-site flex h-full flex-col border-l-2;
    background-color: var(--bg-base);
  }

  .mobile-menu-header {
    @apply flex items-center justify-between border-b-2 p-6;
    border-color: var(--border-base);
  }

  .mobile-menu-close {
    @apply hover:text-primary-600 border-border-site border-2 p-2 text-neutral-600 transition-colors;
  }

  .mobile-menu-body {
    @apply flex-1 overflow-y-auto p-6;
  }

  .mobile-nav-links {
    @apply border-border-site space-y-0 border-2 border-b-0;
  }

  .mobile-nav-item {
    @apply border-b-2;
    border-color: var(--border-base);
  }

  .mobile-nav-link {
    @apply hover:bg-primary-600 block p-4 font-mono font-bold tracking-widest uppercase transition-colors hover:text-white;
    color: var(--text-base);
  }

  .mobile-dropdown-item-title {
    @apply font-mono text-sm font-bold uppercase;
    color: var(--text-base);
  }

  .mobile-dropdown-item-description {
    @apply mt-1 text-xs;
    color: var(--text-muted);
  }

  .mobile-menu-actions {
    @apply mt-6;
  }

  .mobile-cta-button {
    @apply hover:bg-primary-600 dark:hover:bg-primary-500 flex items-center justify-center gap-2 border-2 border-black bg-black px-4 py-4 font-mono font-bold tracking-wider text-white uppercase transition-colors dark:border-white dark:bg-white dark:text-black;
  }
</style>

<script>
  // Header functionality
  document.addEventListener("DOMContentLoaded", function () {
    const header = document.querySelector(".header");
    if (header) {
      window.addEventListener("scroll", () => {
        if (window.scrollY > 50) {
          header.classList.add("scrolled");
        } else {
          header.classList.remove("scrolled");
        }
      });
    }

    // Mobile menu toggle
    const mobileMenuToggle = document.querySelector(".mobile-menu-toggle");
    const mobileMenu = document.querySelector(".mobile-menu");
    const mobileMenuClose = document.querySelector(".mobile-menu-close");

    if (mobileMenuToggle && mobileMenu) {
      mobileMenuToggle.addEventListener("click", function (this: HTMLElement) {
        const isExpanded = this.getAttribute("aria-expanded") === "true";
        this.setAttribute("aria-expanded", String(!isExpanded));
        mobileMenu.classList.toggle("active");
      });
    }

    if (mobileMenuClose && mobileMenu) {
      mobileMenuClose.addEventListener("click", function () {
        mobileMenuToggle?.setAttribute("aria-expanded", "false");
        mobileMenu.classList.remove("active");
      });
    }

    // Search toggle
    const searchToggle = document.querySelector(".search-toggle");
    const searchDropdown = document.querySelector(".search-dropdown");

    if (searchToggle && searchDropdown) {
      searchToggle.addEventListener("click", function (this: HTMLElement) {
        const isExpanded = this.getAttribute("aria-expanded") === "true";
        this.setAttribute("aria-expanded", String(!isExpanded));
        searchDropdown.classList.toggle("opacity-100");
        searchDropdown.classList.toggle("visible");
      });
    }

    // Dropdown menus
    const dropdownTriggers = document.querySelectorAll(".dropdown-trigger");

    dropdownTriggers.forEach((trigger) => {
      trigger.addEventListener("click", function (this: HTMLElement, e: Event) {
        e.preventDefault();
        const isExpanded = this.getAttribute("aria-expanded") === "true";

        // Close all other dropdowns
        dropdownTriggers.forEach((otherTrigger) => {
          if (otherTrigger !== this) {
            otherTrigger.setAttribute("aria-expanded", "false");
            const otherMenu = otherTrigger.nextElementSibling;
            if (otherMenu) {
              otherMenu.classList.remove("opacity-100", "visible");
            }
          }
        });

        // Toggle current dropdown
        this.setAttribute("aria-expanded", String(!isExpanded));
        const menu = this.nextElementSibling;
        if (menu) {
          menu.classList.toggle("opacity-100");
          menu.classList.toggle("visible");
        }
      });
    });

    // Mobile dropdown menus
    const mobileDropdownTriggers = document.querySelectorAll(
      ".mobile-dropdown-trigger",
    );

    mobileDropdownTriggers.forEach((trigger) => {
      trigger.addEventListener("click", function (this: HTMLElement, e: Event) {
        e.preventDefault();
        const content = this.nextElementSibling;
        if (content) {
          content.classList.toggle("hidden");
        }
      });
    });

    // Close dropdowns when clicking outside
    document.addEventListener("click", function (e) {
      const target = e.target as HTMLElement;
      if (!target?.closest(".nav-dropdown")) {
        dropdownTriggers.forEach((trigger) => {
          trigger.setAttribute("aria-expanded", "false");
          const menu = trigger.nextElementSibling;
          if (menu) {
            menu.classList.remove("opacity-100", "visible");
          }
        });
      }

      if (!target?.closest(".search-container")) {
        if (searchToggle && searchDropdown) {
          searchToggle.setAttribute("aria-expanded", "false");
          searchDropdown.classList.remove("opacity-100", "visible");
        }
      }
    });

    // Search functionality
    const searchForm = document.querySelector(".search-form");
    const searchInput = document.querySelector(".search-input");

    if (searchForm && searchInput) {
      searchForm.addEventListener("submit", function (e) {
        e.preventDefault();
        const query = (searchInput as HTMLInputElement).value.trim();
        if (query) {
          // Redirect to search page or perform search
          window.location.href = `/search?q=${encodeURIComponent(query)}`;
        }
      });
    }
  });
</script>
