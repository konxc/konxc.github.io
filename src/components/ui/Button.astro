---
export interface Props {
  variant?: "primary" | "secondary" | "outline";
  size?: "sm" | "md" | "lg";
  href?: string;
  type?: "button" | "submit";
  class?: string;
}

const {
  variant = "primary",
  size = "md",
  href,
  type = "button",
  class: className = "",
  ...props
} = Astro.props;

const baseClasses =
  "inline-flex items-center justify-center font-mono font-bold uppercase tracking-wider transition-all duration-200 border-2 focus:outline-none active:translate-y-1";

const variantClasses = {
  primary:
    "bg-primary-600 text-white border-primary-600 hover:bg-black hover:border-black dark:hover:bg-white dark:hover:text-black dark:hover:border-white shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] dark:shadow-[4px_4px_0px_0px_rgba(255,255,255,1)] hover:shadow-none",
  secondary:
    "bg-black text-white dark:bg-white dark:text-black border-black dark:border-white hover:bg-primary-600 hover:border-primary-600 hover:text-white dark:hover:bg-primary-500 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] dark:shadow-[4px_4px_0px_0px_rgba(255,255,255,1)] hover:shadow-none",
  outline:
    "bg-transparent text-on-site border-border-site hover:bg-primary-600 hover:text-white hover:border-primary-600 hover:shadow-none shadow-[4px_4px_0px_0px_rgba(0,0,0,0.2)] dark:shadow-[4px_4px_0px_0px_rgba(255,255,255,0.2)]",
};

const sizeClasses = {
  sm: "px-4 py-2 text-xs rounded-none",
  md: "px-6 py-3 text-sm rounded-none",
  lg: "px-8 py-4 text-base rounded-none",
};

const classes = `${baseClasses} ${variantClasses[variant]} ${sizeClasses[size]} ${className}`;
---

{
  href ? (
    <a href={href} class={classes} {...props}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} {...props}>
      <slot />
    </button>
  )
}
