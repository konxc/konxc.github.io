---
export interface Props {
  variant?: "default" | "featured" | "outline";
  class?: string;
}

const { variant = "default", class: className = "", ...props } = Astro.props;

const baseClasses =
  "transition-all duration-300 hover:-translate-y-2 hover:shadow-xl";

const variantClasses = {
  default:
    "bg-[var(--bg-base)] rounded-2xl p-6 shadow-[var(--shadow-base)] border border-[var(--border-base)]",
  featured:
    "card-featured rounded-2xl p-8 shadow-lg border border-primary-100 dark:border-primary-800/30",
  outline:
    "bg-transparent rounded-2xl p-6 border-2 border-[var(--border-base)] hover:border-primary-300 dark:hover:border-primary-700",
};

const classes = `${baseClasses} ${variantClasses[variant]} ${className}`;
---

<div class={classes} {...props}>
  <slot />
</div>
