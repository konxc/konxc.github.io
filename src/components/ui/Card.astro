---
export interface Props {
  variant?: "default" | "featured" | "outline";
  class?: string;
}

const { variant = "default", class: className = "", ...props } = Astro.props;

const baseClasses =
  "transition-all duration-300 relative border-2 border-border-site rounded-none";

const variantClasses = {
  default: "bg-surface p-6 hover:bg-site",
  featured:
    "bg-primary-600 text-white p-8 border-primary-600 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] dark:shadow-[8px_8px_0px_0px_rgba(255,255,255,0.1)]",
  outline: "bg-transparent p-6 hover:border-primary-600",
};

const classes = `${baseClasses} ${variantClasses[variant]} ${className}`;
---

<div class={classes} {...props}>
  <slot />
</div>
