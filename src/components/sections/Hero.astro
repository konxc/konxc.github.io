---
import Button from "../ui/Button.astro";
---

<section
  class="section from-primary-50 to-secondary-50 bg-gradient-to-br via-white"
>
  <div class="container">
    <div class="grid items-center gap-12 lg:grid-cols-2">
      <!-- Content -->
      <div class="space-y-8">
        <div class="space-y-4">
          <h1 class="text-4xl leading-tight font-bold lg:text-5xl">
            Menyederhanakan Teknologi untuk
            <span class="text-gradient">Pertumbuhan Bisnis</span>
          </h1>
          <p class="text-xl leading-relaxed text-neutral-600">
            Solusi teknologi terintegrasi untuk UMKM hingga Enterprise. 5 divisi
            dengan 1 komitmen: kesuksesan bisnis Anda.
          </p>
        </div>

        <div class="flex flex-col gap-4 sm:flex-row">
          <Button variant="primary" size="lg" href="#contact">
            Konsultasi Gratis
          </Button>
          <Button variant="secondary" size="lg" href="#services">
            Lihat Layanan
          </Button>
        </div>

        <!-- Trust Indicators -->
        <div class="flex items-center gap-8 pt-8">
          <div class="text-center">
            <div class="text-primary-600 text-2xl font-bold">500+</div>
            <div class="text-sm text-neutral-600">Klien Puas</div>
          </div>
          <div class="text-center">
            <div class="text-primary-600 text-2xl font-bold">10+</div>
            <div class="text-sm text-neutral-600">Tahun Pengalaman</div>
          </div>
          <div class="text-center">
            <div class="text-primary-600 text-2xl font-bold">24/7</div>
            <div class="text-sm text-neutral-600">Support</div>
          </div>
        </div>
      </div>

      <!-- Visual -->
      <div class="relative">
        <div class="rounded-3xl bg-white p-8 shadow-2xl">
          <div class="grid grid-cols-2 gap-4">
            <!-- Service Icons -->
            <div class="bg-primary-50 rounded-xl p-4 text-center">
              <div class="mb-2 text-3xl">🖥️</div>
              <div class="text-primary-700 text-sm font-semibold">
                IT Support
              </div>
            </div>
            <div class="bg-secondary-50 rounded-xl p-4 text-center">
              <div class="mb-2 text-3xl">💻</div>
              <div class="text-secondary-700 text-sm font-semibold">
                Software
              </div>
            </div>
            <div class="bg-accent-50 rounded-xl p-4 text-center">
              <div class="mb-2 text-3xl">🎨</div>
              <div class="text-accent-700 text-sm font-semibold">Branding</div>
            </div>
            <div class="rounded-xl bg-neutral-100 p-4 text-center">
              <div class="mb-2 text-3xl">☁️</div>
              <div class="text-sm font-semibold text-neutral-700">Cloud</div>
            </div>
          </div>
        </div>

        <!-- Floating Elements -->
        <div
          class="bg-primary-500 absolute -top-4 -right-4 h-8 w-8 animate-pulse rounded-full"
        >
        </div>
        <div
          class="bg-secondary-500 absolute -bottom-4 -left-4 h-6 w-6 animate-pulse rounded-full delay-1000"
        >
        </div>
      </div>
    </div>
  </div>
</section>
