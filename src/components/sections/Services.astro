---
import Card from "../ui/Card.astro";
---

<section id="services" class="section bg-white">
  <div class="container">
    <div class="mb-16 text-center">
      <h2 class="mb-4 text-3xl font-bold lg:text-4xl">Layanan Kami</h2>
      <p class="mx-auto max-w-3xl text-xl text-neutral-600">
        5 divisi dengan 1 komitmen: kesuksesan bisnis Anda. Dari infrastruktur
        hingga branding, kami menyediakan solusi teknologi terintegrasi.
      </p>
    </div>

    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      <!-- IT Support & Infrastruktur -->
      <Card variant="featured" class="text-center">
        <div class="mb-6">
          <div class="mb-4 text-5xl">🖥️</div>
          <h3 class="mb-2 text-xl font-bold">IT Support & Infrastruktur</h3>
        </div>
        <p class="mb-6 text-neutral-600">
          Instalasi jaringan untuk kantor, sekolah, dan institusi. Setup CCTV,
          server, dan maintenance perangkat dengan tim fleksibel.
        </p>
        <ul class="mb-6 space-y-2 text-sm text-neutral-600">
          <li>✓ Instalasi jaringan kantor/sekolah</li>
          <li>✓ Setup CCTV & server</li>
          <li>✓ Maintenance perangkat</li>
          <li>✓ Tim fleksibel skala kecil-menengah</li>
        </ul>
        <a
          href="#contact"
          class="text-primary-600 hover:text-primary-700 font-semibold transition-colors"
        >
          Konsultasi Sekarang →
        </a>
      </Card>

      <!-- Software House -->
      <Card class="text-center">
        <div class="mb-6">
          <div class="mb-4 text-5xl">💻</div>
          <h3 class="mb-2 text-xl font-bold">Software House</h3>
        </div>
        <p class="mb-6 text-neutral-600">
          Pengembangan aplikasi web, mobile, dan desktop. Sistem informasi
          sekolah, POS, ERP, dan lainnya.
        </p>
        <ul class="mb-6 space-y-2 text-sm text-neutral-600">
          <li>✓ Aplikasi web, mobile, desktop</li>
          <li>✓ Sistem informasi sekolah</li>
          <li>✓ POS & ERP</li>
          <li>✓ Platform: kopikonfig.com</li>
        </ul>
        <a
          href="#contact"
          class="text-primary-600 hover:text-primary-700 font-semibold transition-colors"
        >
          Konsultasi Sekarang →
        </a>
      </Card>

      <!-- Branding & Media Digital (Fiera) -->
      <Card class="text-center">
        <div class="mb-6">
          <div class="mb-4 text-5xl">🎨</div>
          <h3 class="mb-2 text-xl font-bold">Branding & Media Digital</h3>
          <div class="text-accent-600 text-sm font-semibold">(Fiera)</div>
        </div>
        <p class="mb-6 text-neutral-600">
          Jasa pembuatan landing page profesional, desain media sosial, dan aset
          branding digital untuk UMKM, sekolah, dan startup.
        </p>
        <ul class="mb-6 space-y-2 text-sm text-neutral-600">
          <li>✓ Landing page profesional</li>
          <li>✓ Desain media sosial</li>
          <li>✓ Aset branding digital</li>
          <li>✓ Cocok untuk UMKM & startup</li>
        </ul>
        <a
          href="#contact"
          class="text-primary-600 hover:text-primary-700 font-semibold transition-colors"
        >
          Konsultasi Sekarang →
        </a>
      </Card>

      <!-- Retail Teknologi (Matrix Indonesia) -->
      <Card class="text-center">
        <div class="mb-6">
          <div class="mb-4 text-5xl">🛒</div>
          <h3 class="mb-2 text-xl font-bold">Retail Teknologi</h3>
          <div class="text-accent-600 text-sm font-semibold">
            (Matrix Indonesia)
          </div>
        </div>
        <p class="mb-6 text-neutral-600">
          Matrix Instrument: komponen elektronika, LED display, Arduino. Matrix
          Gadget: jual beli & servis laptop, smartphone, Apple.
        </p>
        <ul class="mb-6 space-y-2 text-sm text-neutral-600">
          <li>✓ Komponen elektronika</li>
          <li>✓ LED display & Arduino</li>
          <li>✓ Jual beli laptop & smartphone</li>
          <li>✓ Servis produk Apple</li>
        </ul>
        <a
          href="#contact"
          class="text-primary-600 hover:text-primary-700 font-semibold transition-colors"
        >
          Konsultasi Sekarang →
        </a>
      </Card>

      <!-- Cloud & SaaS (awankinton.io) -->
      <Card class="text-center">
        <div class="mb-6">
          <div class="mb-4 text-5xl">☁️</div>
          <h3 class="mb-2 text-xl font-bold">Cloud & SaaS</h3>
          <div class="text-accent-600 text-sm font-semibold">
            (awankinton.io)
          </div>
        </div>
        <p class="mb-6 text-neutral-600">
          Layanan hosting dan VPS dengan fokus pada kesederhanaan, kecepatan,
          dan efisiensi. Sistem SaaS yang disesuaikan kebutuhan bisnis.
        </p>
        <ul class="mb-6 space-y-2 text-sm text-neutral-600">
          <li>✓ Hosting & VPS</li>
          <li>✓ Sistem SaaS custom</li>
          <li>✓ Fokus kesederhanaan & kecepatan</li>
          <li>✓ Disesuaikan kebutuhan bisnis</li>
        </ul>
        <a
          href="#contact"
          class="text-primary-600 hover:text-primary-700 font-semibold transition-colors"
        >
          Konsultasi Sekarang →
        </a>
      </Card>
    </div>
  </div>
</section>
