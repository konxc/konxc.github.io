---
// Contributor Card Component - Re-engineered for Premium Aesthetics
import type { CollectionEntry } from "astro:content";
import Avatar from "@components/ui/Avatar.astro";

export interface Props {
  class?: string;
  contributor: CollectionEntry<"contributors">;
  showDetails?: boolean;
  variant?: "default" | "compact" | "featured";
}

const {
  class: className,
  contributor,
  showDetails = true,
  variant = "default",
} = Astro.props;

const { data } = contributor;
const totalContributions =
  data.contributions.blogPosts +
  data.contributions.openSourceProjects.reduce(
    (sum, project) => sum + (project.contributions || 0),
    0,
  ) +
  data.contributions.koneksiProjects.length +
  data.contributions.communityContributions.length;

const roleColors: Record<string, string> = {
  developer: "from-blue-500 to-indigo-600",
  designer: "from-pink-500 to-rose-600",
  writer: "from-amber-400 to-orange-600",
  researcher: "from-emerald-400 to-teal-600",
  mentor: "from-purple-500 to-violet-600",
  "community-leader": "from-cyan-400 to-blue-600",
  "open-source-contributor": "from-slate-400 to-slate-600",
};

const activeGradient =
  roleColors[data.role] || "from-primary-500 to-primary-700";
---

<div
  class={`group relative overflow-hidden rounded-3xl transition-all duration-500 hover:-translate-y-2 ${
    variant === "featured"
      ? "bg-neutral-800/95 backdrop-blur-md border border-white/15 p-8"
      : "bg-neutral-800/90 backdrop-blur-md border border-white/15 p-6 shadow-lg hover:shadow-xl shadow-black/20"
  } ${className || ""}`}
  data-contributor-id={contributor.slug}
>
  {/* Modern Background Decor for Featured */}
  {
    variant === "featured" && (
      <div class="bg-primary-600/20 absolute -top-20 -right-20 h-64 w-64 rounded-full opacity-50 blur-[100px] transition-opacity group-hover:opacity-100" />
    )
  }

  <div class="relative z-10">
    {/* Header Area */}
    <div
      class={`flex items-start gap-6 ${variant === "compact" ? "items-center" : "flex-col md:flex-row"}`}
    >
      <div class="relative shrink-0">
        <div
          class={`absolute inset-0 animate-pulse rounded-full bg-gradient-to-br opacity-20 blur-md ${activeGradient}`}
        >
        </div>
        <div
          class={`relative rounded-full p-1 bg-gradient-to-br ${activeGradient}`}
        >
          <div class="rounded-full bg-white p-1 dark:bg-neutral-900">
            <Avatar
              name={data.name}
              size={variant === "featured" ? 96 : 64}
              src={data.avatar}
              class="h-full w-full rounded-full object-cover"
            />
          </div>
        </div>
        <div
          class={`absolute bottom-1 right-1 h-4 w-4 rounded-full border-4 border-white dark:border-neutral-900 ${data.isActive ? "bg-green-500" : "bg-neutral-400"}`}
        >
        </div>
      </div>

      <div class="min-w-0 flex-1">
        <div class="mb-1 flex flex-wrap items-center gap-2">
          <h3
            class={`font-black tracking-tight ${variant === "featured" ? "text-3xl text-white" : "text-xl text-white"}`}
          >
            <a
              href={`/contributors/${contributor.slug}`}
              class="hover:text-primary-300 text-white transition-colors"
              >{data.name}</a
            >
          </h3>
          {
            variant === "featured" && (
              <span class="bg-primary-500/20 text-primary-400 ring-primary-500/50 rounded-full px-3 py-1 text-[10px] font-black tracking-widest uppercase ring-1">
                Elite
              </span>
            )
          }
        </div>
        <span
          class={`inline-block rounded-lg px-2.5 py-1 text-[10px] font-bold uppercase tracking-widest ${
            variant === "featured"
              ? "bg-primary-500/25 text-primary-200 ring-1 ring-primary-400/30"
              : "bg-white/15 text-neutral-200 ring-1 ring-white/20"
          }`}
        >
          {data.role.replace(/-/g, " ")}
        </span>
        {
          data.location && (
            <p class="mt-2 flex items-center gap-1 text-xs font-bold text-neutral-300">
              📍 {data.location}
            </p>
          )
        }
      </div>

      {
        variant === "featured" && (
          <div class="ml-4 hidden gap-8 border-l border-white/10 pl-8 lg:flex">
            <div class="text-center">
              <div class="text-2xl font-black text-white">
                {totalContributions}
              </div>
              <div class="text-[10px] font-black tracking-widest text-neutral-200 uppercase">
                Impact
              </div>
            </div>
            <div class="text-center">
              <div class="text-2xl font-black text-white">
                {data.socialProof.githubStars}
              </div>
              <div class="text-[10px] font-black tracking-widest text-neutral-200 uppercase">
                Stars
              </div>
            </div>
          </div>
        )
      }
    </div>

    {/* Content Area */}
    {
      variant !== "compact" && showDetails && (
        <div class="mt-8 space-y-6">
          <p
            class={`line-clamp-3 text-sm leading-relaxed ${variant === "featured" ? "text-neutral-200" : "text-neutral-200"}`}
          >
            {data.bio}
          </p>

          <div class="flex flex-wrap gap-2">
            {data.expertise.slice(0, 4).map((skill) => (
              <span
                class={`rounded-lg px-3 py-1 text-[10px] font-black tracking-wide uppercase ${
                  variant === "featured"
                    ? "bg-white/10 text-neutral-200 ring-1 ring-white/20"
                    : "bg-white/10 text-neutral-200 ring-1 ring-white/20"
                }`}
              >
                {skill}
              </span>
            ))}
          </div>
        </div>
      )
    }

    {/* Footer / Social - Dynamic Reveal on Featured, Static on Default */}
    <div
      class="mt-8 flex items-center justify-between border-t border-white/10 pt-6"
    >
      <div class="flex gap-3">
        {
          [
            {
              key: "github",
              icon: "M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.6.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z",
            },
            {
              key: "linkedin",
              icon: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
            },
          ].map(
            (s) =>
              data[s.key as keyof typeof data] && (
                <a
                  href={data[s.key as keyof typeof data] as string}
                  target="_blank"
                  class={`transition-all hover:scale-110 ${variant === "featured" ? "text-neutral-300 hover:text-white" : "hover:text-primary-400 text-neutral-300 dark:text-neutral-300"}`}
                >
                  <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24">
                    <path d={s.icon} />
                  </svg>
                </a>
              ),
          )
        }
      </div>

      <a
        href={`/contributors/${contributor.slug}`}
        class={`group/btn flex items-center gap-2 text-xs font-black tracking-widest uppercase transition-all ${
          variant === "featured"
            ? "text-white hover:text-primary-300"
            : "text-neutral-200 hover:text-white"
        }`}
      >
        Profile Details
        <svg
          class="h-3 w-3 transition-transform group-hover/btn:translate-x-1"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="3"
            d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg
        >
      </a>
    </div>
  </div>
</div>
