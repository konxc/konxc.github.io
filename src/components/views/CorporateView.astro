---
import UnifiedLayout from "../../layouts/UnifiedLayout.astro";
import Button from "../ui/Button.astro";
---

<UnifiedLayout title="PT Koneksi Jaringan Indonesia | Official">
  <div
    class="bg-site text-on-site selection:bg-primary-500 font-sans antialiased selection:text-white"
  >
    <!-- HEADER / HERO GRID (Industrial Aesthetic) -->
    <section
      class="border-border-site bg-surface relative overflow-hidden border-b-2"
    >
      <!-- Background structural lines -->
      <div
        class="pointer-events-none absolute inset-0 z-0 opacity-10"
        style="background-image: linear-gradient(var(--border-site) 1px, transparent 1px), linear-gradient(90deg, var(--border-site) 1px, transparent 1px); background-size: 40px 40px;"
      >
      </div>

      <div class="relative z-10 mx-auto max-w-[1400px]">
        <div class="grid lg:grid-cols-12">
          <!-- Hero Text Content -->
          <div
            class="border-border-site bg-site flex flex-col px-6 pt-12 pb-16 lg:col-span-8 lg:border-r-2 lg:pt-24 lg:pr-16 lg:pb-24 lg:pl-8"
          >
            <div class="mb-10 inline-flex items-center gap-3">
              <span class="bg-primary-600 h-3 w-3 animate-pulse rounded-none"
              ></span>
              <span
                class="text-primary-600 font-mono text-xs font-bold tracking-widest uppercase"
                >Sistem Operasional Aktif</span
              >
            </div>

            <h1
              class="mb-10 text-5xl leading-[1.05] font-black tracking-tight uppercase lg:text-7xl xl:text-8xl"
            >
              ARSITEKTUR DIGITAL <br />
              <span class="text-primary-600">UNTUK MASA DEPAN</span>
            </h1>

            <p
              class="text-on-muted mb-12 max-w-2xl font-mono text-xl leading-relaxed lg:text-2xl"
            >
              PT Koneksi Jaringan Indonesia adalah fondasi teknologi bisnis
              Anda. Kami merancang, membangun, dan mengelola ekosistem digital
              skala enterprise hingga UMKM.
            </p>

            <div class="mt-auto flex flex-col gap-4 sm:flex-row">
              <a
                href="#layanan"
                class="bg-primary-600 border-primary-600 inline-flex items-center justify-center border-2 px-8 py-5 font-mono font-bold tracking-wider text-white uppercase shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] transition-all hover:translate-y-1 hover:border-black hover:bg-black hover:shadow-none dark:shadow-[8px_8px_0px_0px_rgba(255,255,255,1)] dark:hover:border-white dark:hover:bg-white dark:hover:text-black"
              >
                Eksplorasi Layanan
              </a>
              <a
                href="#contact"
                class="text-on-site border-border-site hover:bg-primary-600 hover:border-primary-600 inline-flex items-center justify-center border-2 bg-transparent px-8 py-5 font-mono font-bold tracking-wider uppercase shadow-[8px_8px_0px_0px_var(--border-site)] transition-all hover:translate-y-1 hover:text-white hover:shadow-none"
              >
                Hubungi Engineering
              </a>
            </div>
          </div>

          <!-- Metrics / Data Panel -->
          <div
            class="border-border-site flex flex-col border-t-2 lg:col-span-4 lg:border-t-0"
          >
            <div
              class="border-border-site bg-surface flex flex-1 flex-col justify-center border-b-2 p-10"
            >
              <div
                class="text-on-muted mb-2 font-mono text-sm font-bold uppercase"
              >
                Runtime / Durasi
              </div>
              <div class="text-primary-600 font-mono text-6xl font-black">
                10+
              </div>
              <div class="mt-2 text-xl font-bold tracking-wide uppercase">
                Tahun Pengalaman
              </div>
            </div>
            <div
              class="border-border-site bg-site flex flex-1 flex-col justify-center border-b-2 p-10"
            >
              <div
                class="text-on-muted mb-2 font-mono text-sm font-bold uppercase"
              >
                Kapasitas Sektoral
              </div>
              <div class="text-secondary-600 font-mono text-6xl font-black">
                5
              </div>
              <div class="mt-2 text-xl font-bold tracking-wide uppercase">
                Divisi Khusus
              </div>
            </div>
            <div class="bg-surface flex flex-1 flex-col justify-center p-10">
              <div
                class="text-on-muted mb-6 font-mono text-xs font-bold uppercase"
              >
                Status Infrastruktur
              </div>
              <div class="space-y-4">
                <div
                  class="border-border-site flex items-center justify-between border-b-2 pb-3"
                >
                  <span class="font-mono text-sm font-bold uppercase"
                    >Cloud Native</span
                  >
                  <span class="font-mono text-sm font-bold text-green-500"
                    >ONLINE</span
                  >
                </div>
                <div
                  class="border-border-site flex items-center justify-between border-b-2 pb-3"
                >
                  <span class="font-mono text-sm font-bold uppercase"
                    >Sistem Keamanan</span
                  >
                  <span class="font-mono text-sm font-bold text-green-500"
                    >SECURE</span
                  >
                </div>
                <div class="flex items-center justify-between">
                  <span class="font-mono text-sm font-bold uppercase"
                    >Dukungan 24/7</span
                  >
                  <span class="text-primary-600 font-mono text-sm font-bold"
                    >ACTIVE</span
                  >
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SERVICES GRID -->
    <section id="layanan" class="border-border-site bg-site border-b-2">
      <div class="mx-auto max-w-[1400px]">
        <div class="border-border-site border-x-2 p-8 pt-24 lg:p-16 lg:pt-32">
          <div class="mb-16">
            <h2
              class="mb-6 text-5xl font-black tracking-tight uppercase lg:text-7xl"
            >
              Kapasitas<br />Layanan
            </h2>
            <div class="bg-primary-600 h-2 w-32"></div>
          </div>

          <!-- Industrial Grid Cards -->
          <div
            class="border-border-site bg-surface grid border-2 md:grid-cols-2 lg:grid-cols-3"
          >
            <!-- Card 1 -->
            <div
              class="border-border-site group hover:bg-primary-600 border-b-2 p-10 transition-colors md:border-r-2 lg:border-b-0"
            >
              <div
                class="text-primary-600 mb-8 font-mono text-5xl font-bold group-hover:text-white"
              >
                01
              </div>
              <h3
                class="mb-4 text-2xl font-black uppercase group-hover:text-white"
              >
                Infrastruktur & Cloud
              </h3>
              <p
                class="text-on-muted mb-8 font-mono text-sm leading-relaxed group-hover:text-white/80"
              >
                Arsitektur server terdistribusi, manajemen load balancing, dan
                sistem kontainerisasi tingkat enterprise.
              </p>
              <div class="mt-auto">
                <a
                  href="/services/infrastructure"
                  class="text-primary-600 inline-flex items-center gap-2 border-b-2 border-transparent font-mono text-sm font-bold uppercase transition-colors group-hover:border-white group-hover:text-white"
                >
                  Spesifikasi Teknis
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"
                    ></path></svg
                  >
                </a>
              </div>
            </div>

            <!-- Card 2 -->
            <div
              class="border-border-site group hover:bg-primary-600 border-b-2 p-10 transition-colors md:border-r-2 md:border-b-0 lg:border-b-0"
            >
              <div
                class="text-primary-600 mb-8 font-mono text-5xl font-bold group-hover:text-white"
              >
                02
              </div>
              <h3
                class="mb-4 text-2xl font-black uppercase group-hover:text-white"
              >
                Pengembangan Ekosistem
              </h3>
              <p
                class="text-on-muted mb-8 font-mono text-sm leading-relaxed group-hover:text-white/80"
              >
                Pembuatan aplikasi web dan mobile dengan arsitektur
                microservices dan performa tinggi (Qwik, Astro, Go).
              </p>
              <div class="mt-auto">
                <a
                  href="/services/development"
                  class="text-primary-600 inline-flex items-center gap-2 border-b-2 border-transparent font-mono text-sm font-bold uppercase transition-colors group-hover:border-white group-hover:text-white"
                >
                  Spesifikasi Teknis
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"
                    ></path></svg
                  >
                </a>
              </div>
            </div>

            <!-- Card 3 -->
            <div class="group hover:bg-primary-600 p-10 transition-colors">
              <div
                class="text-primary-600 mb-8 font-mono text-5xl font-bold group-hover:text-white"
              >
                03
              </div>
              <h3
                class="mb-4 text-2xl font-black uppercase group-hover:text-white"
              >
                Cyber Security
              </h3>
              <p
                class="text-on-muted mb-8 font-mono text-sm leading-relaxed group-hover:text-white/80"
              >
                Audit keamanan sistem, mitigasi DDoS, dan hardening
                infrastruktur sesuai standar industri (ISO 27001).
              </p>
              <div class="mt-auto">
                <a
                  href="/services/security"
                  class="text-primary-600 inline-flex items-center gap-2 border-b-2 border-transparent font-mono text-sm font-bold uppercase transition-colors group-hover:border-white group-hover:text-white"
                >
                  Spesifikasi Teknis
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"
                    ></path></svg
                  >
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- PORTFOLIO / KNOWLEDGE BASE BANNER -->
    <section
      class="border-border-site border-b-2 bg-black text-white dark:bg-white dark:text-black"
    >
      <div class="mx-auto max-w-[1400px]">
        <div class="border-border-site grid border-x-2 md:grid-cols-2">
          <div
            class="border-border-site border-b-2 p-12 md:border-r-2 md:border-b-0 lg:p-20"
          >
            <h2 class="mb-6 text-4xl font-black uppercase lg:text-5xl">
              Database<br />Pengetahuan
            </h2>
            <p class="mb-10 font-mono text-sm leading-relaxed opacity-80">
              Akses repositori terbuka kami, baca studi kasus teknis, dan
              dokumentasi arsitektur dari berbagai proyek PT Koneksi Jaringan
              Indonesia.
            </p>
            <div>
              <a
                href="https://konxc.space"
                class="bg-primary-600 inline-flex items-center gap-4 border-2 border-transparent px-8 py-4 font-mono font-bold text-white uppercase transition-colors hover:border-black hover:bg-white hover:text-black dark:hover:border-white dark:hover:bg-black dark:hover:text-white"
              >
                Eksplorasi Knowledge Base
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"
                  ></path></svg
                >
              </a>
            </div>
          </div>
          <div
            class="bg-primary-600 relative flex items-center justify-center border-l-2 border-black p-20 dark:border-white"
          >
            <div
              class="absolute inset-0 opacity-20"
              style="background-image: repeating-linear-gradient(45deg, #000 25%, transparent 25%, transparent 75%, #000 75%, #000), repeating-linear-gradient(45deg, #000 25%, transparent 25%, transparent 75%, #000 75%, #000); background-position: 0 0, 20px 20px; background-size: 40px 40px;"
            >
            </div>
            <div class="relative z-10 text-9xl font-black text-black">
              &lt;/&gt;
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CONTACT FORM TERMINAL -->
    <section id="contact" class="bg-surface border-border-site border-b-2">
      <div class="mx-auto max-w-[1400px]">
        <div class="border-border-site border-x-2 p-8 pt-24 lg:p-16 lg:pt-32">
          <div
            class="border-border-site bg-site grid gap-0 border-2 shadow-[16px_16px_0px_0px_var(--border-site)] lg:grid-cols-5"
          >
            <!-- Contact Info -->
            <div
              class="bg-surface border-border-site border-b-2 p-10 lg:col-span-2 lg:border-r-2 lg:border-b-0 lg:p-16"
            >
              <h2 class="mb-10 text-4xl font-black uppercase">
                Terminal<br />Komunikasi
              </h2>

              <div class="space-y-10 font-mono">
                <div>
                  <div class="text-on-muted mb-2 text-xs font-bold uppercase">
                    Status / Lokasi
                  </div>
                  <div class="flex items-center gap-3 text-lg font-bold">
                    <span class="bg-primary-600 h-3 w-3"></span> Jakarta, Indonesia
                  </div>
                </div>

                <div>
                  <div class="text-on-muted mb-2 text-xs font-bold uppercase">
                    Secure Channel
                  </div>
                  <div class="text-lg font-bold">info@konxc.space</div>
                </div>

                <div>
                  <div class="text-on-muted mb-2 text-xs font-bold uppercase">
                    Direct Line
                  </div>
                  <div class="text-2xl font-black">+62 882-0079-52010</div>
                </div>
              </div>
            </div>

            <!-- The Form -->
            <div class="p-10 lg:col-span-3 lg:p-16">
              <form id="contact-form" class="space-y-6">
                <div class="grid gap-6 sm:grid-cols-2">
                  <div class="space-y-2">
                    <label
                      class="text-on-muted font-mono text-xs font-bold uppercase"
                      >Nama Depan</label
                    >
                    <input
                      type="text"
                      name="first_name"
                      required
                      class="bg-surface border-border-site text-on-site focus:border-primary-600 w-full border-2 px-4 py-4 font-mono font-bold uppercase shadow-[4px_4px_0px_0px_var(--border-site)] transition-colors outline-none focus:shadow-[4px_4px_0px_0px_var(--color-primary-600)] focus:ring-0"
                    />
                  </div>
                  <div class="space-y-2">
                    <label
                      class="text-on-muted font-mono text-xs font-bold uppercase"
                      >Nama Belakang</label
                    >
                    <input
                      type="text"
                      name="last_name"
                      class="bg-surface border-border-site text-on-site focus:border-primary-600 w-full border-2 px-4 py-4 font-mono font-bold uppercase shadow-[4px_4px_0px_0px_var(--border-site)] transition-colors outline-none focus:shadow-[4px_4px_0px_0px_var(--color-primary-600)] focus:ring-0"
                    />
                  </div>
                </div>

                <div class="space-y-2">
                  <label
                    class="text-on-muted font-mono text-xs font-bold uppercase"
                    >Email Bisnis</label
                  >
                  <input
                    type="email"
                    name="email"
                    required
                    class="bg-surface border-border-site text-on-site focus:border-primary-600 w-full border-2 px-4 py-4 font-mono font-bold uppercase shadow-[4px_4px_0px_0px_var(--border-site)] transition-colors outline-none focus:shadow-[4px_4px_0px_0px_var(--color-primary-600)] focus:ring-0"
                  />
                </div>

                <div class="space-y-2">
                  <label
                    class="text-on-muted font-mono text-xs font-bold uppercase"
                    >Departemen / Tujuan</label
                  >
                  <select
                    name="subject"
                    class="bg-surface border-border-site text-on-site focus:border-primary-600 w-full cursor-pointer appearance-none rounded-none border-2 px-4 py-4 font-mono font-bold uppercase shadow-[4px_4px_0px_0px_var(--border-site)] transition-colors outline-none focus:shadow-[4px_4px_0px_0px_var(--color-primary-600)] focus:ring-0"
                  >
                    <option value="consultation"
                      >Konsultasi Infrastruktur & Layanan</option
                    >
                    <option value="collaboration">Kerjasama Partnership</option>
                    <option value="other">Pertanyaan Umum</option>
                  </select>
                </div>

                <div class="space-y-2">
                  <label
                    class="text-on-muted font-mono text-xs font-bold uppercase"
                    >Transmisi Pesan</label
                  >
                  <textarea
                    name="message"
                    rows="5"
                    required
                    class="bg-surface border-border-site text-on-site focus:border-primary-600 w-full resize-none border-2 px-4 py-4 font-mono font-bold shadow-[4px_4px_0px_0px_var(--border-site)] transition-colors outline-none focus:shadow-[4px_4px_0px_0px_var(--color-primary-600)] focus:ring-0"
                  ></textarea>
                </div>

                <button
                  type="submit"
                  class="hover:bg-primary-600 dark:hover:bg-primary-500 mt-8 flex w-full items-center justify-center gap-3 border-2 border-black bg-black py-6 font-mono font-black text-white uppercase shadow-[8px_8px_0px_0px_var(--border-site)] transition-all hover:translate-y-1 hover:text-white hover:shadow-none dark:border-white dark:bg-white dark:text-black"
                >
                  Kirim via Protokol WhatsApp
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"
                    ></path></svg
                  >
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</UnifiedLayout>

<script>
  // WhatsApp form handling strictly preserved
  const form = document.getElementById("contact-form") as HTMLFormElement;
  if (form) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const data = Object.fromEntries(formData);

      const phoneNumber = "62882007952010";
      const fullName = `${data.first_name} ${data.last_name || ""}`.trim();

      const message = `*Halo KonXC!*\n\n*Nama:* ${fullName}\n*Email:* ${data.email}\n*Subjek:* ${data.subject}\n\n*Pesan:*\n${data.message}`;

      const whatsappUrl = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(message)}`;
      window.open(whatsappUrl, "_blank");

      const button = form.querySelector('button[type="submit"]');
      if (button) {
        button.innerHTML = "MENGARAHKAN...";
        setTimeout(() => {
          button.innerHTML =
            'KIRIM VIA PROTOKOL WHATSAPP <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>';
          form.reset();
        }, 2000);
      }
    });
  }
</script>
