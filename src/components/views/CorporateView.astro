---
import UnifiedLayout from "../../layouts/UnifiedLayout.astro";
import Button from "../ui/Button.astro";
---

<UnifiedLayout title="PT Koneksi Jaringan Indonesia | Official">
  <div
    class="bg-site text-on-site selection:bg-primary-500 font-sans antialiased selection:text-white"
  >
    <!-- HEADER / HERO GRID (Industrial Aesthetic) -->
    <section class="border-border-site relative overflow-hidden border-b-2">
      <!-- Background structural lines -->
      <div
        class="pointer-events-none absolute inset-0 z-0 opacity-10"
        style="background-image: linear-gradient(var(--border-site) 1px, transparent 1px), linear-gradient(90deg, var(--border-site) 1px, transparent 1px); background-size: 40px 40px;"
      >
      </div>

      <div class="relative z-10 container mx-auto px-4 lg:px-8">
        <div class="grid min-h-[90vh] lg:grid-cols-12">
          <!-- Hero Text Content -->
          <div
            class="border-border-site flex flex-col justify-center py-20 lg:col-span-8 lg:border-r-2 lg:py-0 lg:pr-16"
          >
            <div class="mb-8 inline-flex items-center gap-3">
              <span class="bg-primary-600 h-3 w-3 animate-pulse rounded-none"
              ></span>
              <span
                class="text-primary-600 font-mono text-xs font-bold tracking-widest uppercase"
                >Sistem Operasional Aktif</span
              >
            </div>

            <h1
              class="mb-8 text-5xl leading-[1.05] font-black tracking-tight lg:text-7xl xl:text-8xl"
            >
              ARSITEKTUR DIGITAL <br />
              <span
                class="from-primary-600 to-secondary-600 bg-gradient-to-r bg-clip-text text-transparent"
                >UNTUK MASA DEPAN</span
              >
            </h1>

            <p
              class="text-on-muted mb-12 max-w-2xl text-xl leading-relaxed font-light lg:text-2xl"
            >
              PT Koneksi Jaringan Indonesia adalah fondasi teknologi bisnis
              Anda. Kami merancang, membangun, dan mengelola ekosistem digital
              skala enterprise hingga UMKM.
            </p>

            <div class="flex flex-col gap-4 sm:flex-row">
              <a
                href="#layanan"
                class="group bg-primary-600 hover:bg-primary-700 relative inline-flex items-center justify-center px-8 py-4 font-mono font-bold tracking-wider text-white uppercase transition-all"
              >
                <span
                  class="border-primary-600 absolute inset-0 translate-x-1 translate-y-1 border-2 transition-transform group-hover:translate-x-0 group-hover:translate-y-0"
                ></span>
                <span class="relative">Eksplorasi Layanan</span>
              </a>
              <a
                href="#contact"
                class="group bg-surface text-on-site border-border-site relative inline-flex items-center justify-center border-2 px-8 py-4 font-mono font-bold tracking-wider uppercase transition-all hover:bg-neutral-100 dark:hover:bg-neutral-900"
              >
                Hubungi Engineering
              </a>
            </div>
          </div>

          <!-- Metrics / Data Panel -->
          <div
            class="border-border-site flex flex-col border-t-2 lg:col-span-4 lg:border-t-0"
          >
            <div
              class="border-border-site flex flex-1 flex-col justify-center border-b-2 p-8"
            >
              <div class="text-on-muted mb-2 font-mono text-sm uppercase">
                Runtime / Durasi
              </div>
              <div class="text-primary-600 text-6xl font-black">10+</div>
              <div class="mt-2 text-xl font-bold">Tahun Pengalaman</div>
            </div>
            <div
              class="border-border-site bg-surface flex flex-1 flex-col justify-center border-b-2 p-8"
            >
              <div class="text-on-muted mb-2 font-mono text-sm uppercase">
                Kapasitas Sektoral
              </div>
              <div class="text-secondary-600 text-6xl font-black">5</div>
              <div class="mt-2 text-xl font-bold">Divisi Khusus</div>
            </div>
            <div class="flex flex-1 flex-col justify-center p-8">
              <div class="text-on-muted mb-4 font-mono text-xs uppercase">
                Status Infrastruktur
              </div>
              <div class="space-y-3">
                <div
                  class="border-border-site flex items-center justify-between border-b pb-2"
                >
                  <span class="font-mono text-sm">Cloud Native</span>
                  <span class="font-mono text-sm text-green-500">ONLINE</span>
                </div>
                <div
                  class="border-border-site flex items-center justify-between border-b pb-2"
                >
                  <span class="font-mono text-sm">Sistem Keamanan</span>
                  <span class="font-mono text-sm text-green-500">SECURE</span>
                </div>
                <div class="flex items-center justify-between">
                  <span class="font-mono text-sm">Dukungan 24/7</span>
                  <span class="text-primary-600 font-mono text-sm">ACTIVE</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SERVICES GRID -->
    <section id="layanan" class="border-border-site bg-surface border-b-2">
      <div class="container mx-auto px-4 py-20 lg:px-8 lg:py-32">
        <div class="mb-16">
          <h2
            class="mb-4 text-4xl font-black tracking-tight uppercase lg:text-6xl"
          >
            Kapasitas<br />Layanan
          </h2>
          <div class="bg-primary-600 h-2 w-24"></div>
        </div>

        <!-- Industrial Grid Cards -->
        <div
          class="border-border-site grid border-2 md:grid-cols-2 lg:grid-cols-3"
        >
          <!-- Card 1 -->
          <div
            class="border-border-site group hover:bg-site border-b-2 p-10 transition-colors md:border-r-2 md:border-b-2 lg:border-b-0"
          >
            <div
              class="text-border-site group-hover:text-primary-600 mb-6 font-mono text-4xl transition-colors"
            >
              01
            </div>
            <h3 class="mb-4 text-2xl font-bold uppercase">Cloud & Server</h3>
            <p class="text-on-muted leading-relaxed">
              Manajemen infrastruktur server, optimasi arsitektur cloud (AWS,
              GCP, DigitalOcean), dan deployment sistem skala enterprise dengan
              jaminan uptime.
            </p>
          </div>

          <!-- Card 2 -->
          <div
            class="border-border-site bg-primary-600 group border-b-2 p-10 text-white lg:border-r-2 lg:border-b-0"
          >
            <div class="text-primary-300 mb-6 font-mono text-4xl">02</div>
            <h3 class="mb-4 text-2xl font-bold uppercase">
              Software Engineering
            </h3>
            <p class="text-primary-100 leading-relaxed">
              Pengembangan web application, sistem backend kompleks, dan
              integrasi API (Headless CMS) yang disesuaikan murni dengan alur
              kerja bisnis Anda.
            </p>
          </div>

          <!-- Card 3 -->
          <div
            class="border-border-site group hover:bg-site p-10 transition-colors"
          >
            <div
              class="text-border-site group-hover:text-primary-600 mb-6 font-mono text-4xl transition-colors"
            >
              03
            </div>
            <h3 class="mb-4 text-2xl font-bold uppercase">IT Support UMKM</h3>
            <p class="text-on-muted leading-relaxed">
              Digitalisasi bisnis dari akar. Dukungan teknis komprehensif, setup
              POS, manajemen inventaris, dan transformasi digital yang
              terjangkau.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- COMMUNITY BANNER -->
    <section class="border-border-site overflow-hidden border-b-2">
      <div class="container mx-auto px-4 lg:px-8">
        <div class="grid min-h-[50vh] lg:grid-cols-2">
          <div
            class="border-border-site flex flex-col justify-center border-b-2 bg-black p-12 text-white lg:border-r-2 lg:border-b-0 lg:p-20 dark:bg-neutral-900"
          >
            <h2 class="mb-6 text-4xl font-black uppercase lg:text-5xl">
              Membangun<br />Komunitas
            </h2>
            <p class="mb-10 max-w-md text-lg text-neutral-400">
              Membangun masa depan digital Indonesia melalui kekuatan komunitas.
              Kami mendukung penuh Open Source dan kolaborasi tanpa batas.
            </p>
            <div>
              <a
                href="/blog"
                class="inline-flex items-center gap-4 border-2 border-white px-8 py-4 font-mono font-bold uppercase transition-colors hover:bg-white hover:text-black"
              >
                Eksplorasi Knowledge Base
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"
                  ></path></svg
                >
              </a>
            </div>
          </div>
          <div
            class="bg-primary-600 relative flex items-center justify-center p-20"
          >
            <!-- Brutalist Pattern -->
            <div
              class="absolute inset-0 opacity-20"
              style="background-image: repeating-linear-gradient(45deg, #000 25%, transparent 25%, transparent 75%, #000 75%, #000), repeating-linear-gradient(45deg, #000 25%, transparent 25%, transparent 75%, #000 75%, #000); background-position: 0 0, 20px 20px; background-size: 40px 40px;"
            >
            </div>
            <div class="relative z-10 text-9xl font-black text-black">
              &lt;/&gt;
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CONTACT FORM TERMINAL -->
    <section id="contact" class="bg-site py-24 lg:py-40">
      <div class="container mx-auto max-w-6xl px-4 lg:px-8">
        <div
          class="border-border-site grid gap-0 border-2 shadow-2xl lg:grid-cols-5"
        >
          <!-- Contact Info -->
          <div
            class="bg-surface border-border-site border-b-2 p-10 lg:col-span-2 lg:border-r-2 lg:border-b-0 lg:p-16"
          >
            <h2 class="mb-8 text-3xl font-black uppercase">
              Terminal<br />Komunikasi
            </h2>

            <div class="space-y-8 font-mono">
              <div>
                <div class="text-on-muted mb-1 text-xs uppercase">
                  Status / Lokasi
                </div>
                <div class="flex items-center gap-3 font-bold">
                  <span class="bg-primary-600 h-2 w-2"></span> Jakarta, Indonesia
                </div>
              </div>

              <div>
                <div class="text-on-muted mb-1 text-xs uppercase">
                  Secure Channel
                </div>
                <div class="font-bold">info@konxc.space</div>
              </div>

              <div>
                <div class="text-on-muted mb-1 text-xs uppercase">
                  Direct Line
                </div>
                <div class="text-xl font-bold">+62 882-0079-52010</div>
              </div>
            </div>
          </div>

          <!-- The Form -->
          <div class="bg-site p-10 lg:col-span-3 lg:p-16">
            <form id="contact-form" class="space-y-6">
              <div class="grid gap-6 sm:grid-cols-2">
                <div class="space-y-2">
                  <label
                    class="text-on-muted font-mono text-xs font-bold uppercase"
                    >Nama Depan</label
                  >
                  <input
                    type="text"
                    name="first_name"
                    required
                    class="bg-surface border-border-site text-on-site focus:border-primary-600 w-full border-2 px-4 py-3 font-mono transition-colors focus:outline-none"
                  />
                </div>
                <div class="space-y-2">
                  <label
                    class="text-on-muted font-mono text-xs font-bold uppercase"
                    >Nama Belakang</label
                  >
                  <input
                    type="text"
                    name="last_name"
                    class="bg-surface border-border-site text-on-site focus:border-primary-600 w-full border-2 px-4 py-3 font-mono transition-colors focus:outline-none"
                  />
                </div>
              </div>

              <div class="space-y-2">
                <label
                  class="text-on-muted font-mono text-xs font-bold uppercase"
                  >Email Bisnis</label
                >
                <input
                  type="email"
                  name="email"
                  required
                  class="bg-surface border-border-site text-on-site focus:border-primary-600 w-full border-2 px-4 py-3 font-mono transition-colors focus:outline-none"
                />
              </div>

              <div class="space-y-2">
                <label
                  class="text-on-muted font-mono text-xs font-bold uppercase"
                  >Departemen / Tujuan</label
                >
                <select
                  name="subject"
                  class="bg-surface border-border-site text-on-site focus:border-primary-600 w-full cursor-pointer appearance-none rounded-none border-2 px-4 py-3 font-mono transition-colors focus:outline-none"
                >
                  <option value="consultation"
                    >Konsultasi Infrastruktur & Layanan</option
                  >
                  <option value="collaboration">Kerjasama Partnership</option>
                  <option value="other">Pertanyaan Umum</option>
                </select>
              </div>

              <div class="space-y-2">
                <label
                  class="text-on-muted font-mono text-xs font-bold uppercase"
                  >Transmisi Pesan</label
                >
                <textarea
                  name="message"
                  rows="4"
                  required
                  class="bg-surface border-border-site text-on-site focus:border-primary-600 w-full resize-none border-2 px-4 py-3 font-mono transition-colors focus:outline-none"
                ></textarea>
              </div>

              <button
                type="submit"
                class="hover:bg-primary-600 dark:hover:bg-primary-500 flex w-full items-center justify-center gap-3 border-2 border-black bg-black py-5 font-mono font-bold text-white uppercase transition-colors dark:border-white dark:bg-white dark:text-black"
              >
                Kirim via Protokol WhatsApp
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"
                  ></path></svg
                >
              </button>
            </form>
          </div>
        </div>
      </div>
    </section>
  </div>
</UnifiedLayout>

<script>
  // WhatsApp form handling strictly preserved
  const form = document.getElementById("contact-form") as HTMLFormElement;
  if (form) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const data = Object.fromEntries(formData);

      const phoneNumber = "62882007952010";
      const fullName = `${data.first_name} ${data.last_name || ""}`.trim();

      const message = `*Halo KonXC!*\n\n*Nama:* ${fullName}\n*Email:* ${data.email}\n*Subjek:* ${data.subject}\n\n*Pesan:*\n${data.message}`;

      const whatsappUrl = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(message)}`;
      window.open(whatsappUrl, "_blank");

      const button = form.querySelector('button[type="submit"]');
      if (button) {
        button.innerHTML = "MENGARAHKAN...";
        setTimeout(() => {
          button.innerHTML =
            'KIRIM VIA PROTOKOL WHATSAPP <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>';
          form.reset();
        }, 2000);
      }
    });
  }
</script>
