---
import UnifiedLayout from "@layouts/UnifiedLayout.astro";
import ModernHero from "@components/sections/ModernHero.astro";
import PlatformShowcase from "@components/sections/PlatformShowcase.astro";
import UmkmEmpowerment from "@components/sections/UmkmEmpowerment.astro";
import Services from "@components/sections/Services.astro";
import Button from "@components/ui/Button.astro";
---

<UnifiedLayout
  title="KonXC - Ekosistem Digital Mitra Terpercaya UMKM Indonesia"
  description="Solusi teknologi terintegrasi untuk UMKM. Platform diskusi, learning hub, dan layanan IT Support hingga Digital Branding terlengkap."
  showNewsletter={false}
  headerVariant="default"
  footerVariant="extended"
>
  <!-- Main Hero -->
  <ModernHero />

  <!-- Our Platforms -->
  <PlatformShowcase />

  <!-- Services Grid -->
  <section class="bg-site py-24" id="services">
    <div class="container">
      <div
        class="mb-16 flex flex-col justify-between gap-6 md:flex-row md:items-end"
      >
        <div class="max-w-2xl">
          <h2 class="text-on-site mb-4 text-3xl font-bold lg:text-5xl">
            Layanan Terintegrasi <br />
            <span class="text-gradient">End-to-End</span>
          </h2>
          <p class="text-on-muted text-xl">
            Dari pondasi infrastruktur hingga akselerasi branding digital. Kami
            hadir di setiap titik sentuh bisnis Anda.
          </p>
        </div>
        <Button variant="outline" href="#contact">Diskusi Project</Button>
      </div>
      <div data-aos="fade-up">
        <Services />
      </div>
    </div>
  </section>

  <!-- UMKM Focus -->
  <UmkmEmpowerment />

  <!-- About Highlight - Premium Community Section -->
  <section
    class="bg-site text-on-site border-border-site/30 relative overflow-hidden border-y py-24 dark:border-none"
  >
    <!-- Decorative Background Elements -->
    <div
      class="bg-primary-600/5 dark:bg-primary-600/10 absolute top-0 right-0 h-full w-1/2 rounded-full blur-[120px]"
    >
    </div>
    <div
      class="bg-secondary-600/5 dark:bg-secondary-600/10 absolute bottom-0 left-0 h-2/3 w-1/3 rounded-full blur-[120px]"
    >
    </div>

    <div class="relative z-10 container" data-aos="fade-up">
      <div class="grid items-center gap-16 lg:grid-cols-2">
        <div>
          <h2 class="mb-8 text-4xl font-bold tracking-tight lg:text-5xl">
            Rumah Bersama Komunitas <br />
            <span class="text-gradient">Teknologi Indonesia</span>
          </h2>
          <p class="text-on-muted mb-10 text-xl leading-relaxed">
            PT Koneksi Jaringan Indonesia (KonXC) bukan sekadar perusahaan IT.
            Kami adalah ekosistem yang menghubungkan developer, inovator, dan
            pebisnis untuk tumbuh bersama.
          </p>
          <div class="mb-12 grid grid-cols-2 gap-10">
            <div>
              <div
                class="text-primary-600 dark:text-primary-400 mb-2 text-4xl font-bold"
              >
                10+ Thn
              </div>
              <div
                class="text-on-muted text-sm font-semibold tracking-wider uppercase"
              >
                Pengalaman
              </div>
            </div>
            <div>
              <div
                class="text-secondary-600 dark:text-secondary-400 mb-2 text-4xl font-bold"
              >
                5
              </div>
              <div
                class="text-on-muted text-sm font-semibold tracking-wider uppercase"
              >
                Divisi Khusus
              </div>
            </div>
          </div>
          <Button variant="primary" href="/blog">Eksplorasi Knowledge</Button>
        </div>
        <div class="relative">
          <!-- Floating Interactive Card Representation -->
          <div
            class="border-border-site bg-surface shadow-soft-xl flex aspect-video items-center justify-center overflow-hidden rounded-[2.5rem] border dark:shadow-2xl"
          >
            <div class="p-10 text-center">
              <div
                class="bg-primary-50 dark:bg-primary-900/30 mb-6 inline-flex h-20 w-20 items-center justify-center rounded-3xl text-5xl"
              >
                🤝
              </div>
              <div class="text-on-site mb-3 text-2xl font-bold">
                Kolaborasi Tanpa Batas
              </div>
              <p class="text-on-muted mx-auto max-w-xs">
                Membangun masa depan digital Indonesia melalui kekuatan
                komunitas.
              </p>
            </div>
          </div>
          <!-- Floating decorative glow -->
          <div
            class="bg-accent-500 absolute -right-4 -bottom-4 h-20 w-20 rounded-3xl opacity-20 blur-3xl dark:opacity-40"
          >
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact CTA -->
  <section id="contact" class="bg-site py-24 lg:py-40">
    <div class="container" data-aos="fade-up">
      <div class="mx-auto max-w-5xl">
        <div class="grid items-center gap-12 lg:grid-cols-5">
          <div class="lg:col-span-2">
            <h2 class="text-on-site mb-6 text-4xl font-bold lg:text-6xl">
              Konsultasi <span class="text-gradient">Gratis</span>
            </h2>
            <p class="text-on-muted mb-8 text-xl">
              Punya ide cemerlang atau butuh solusi cepat? Tim ahli kami siap
              mendengarkan tantangan bisnis Anda.
            </p>
            <div class="space-y-4">
              <div class="text-on-site flex items-center gap-4">
                <span class="text-primary-600 font-bold">📍</span> Jakarta, Indonesia
              </div>
              <div class="text-on-site flex items-center gap-4">
                <span class="text-primary-600 font-bold">✉️</span> info@konxc.space
              </div>
              <div class="text-on-site flex items-center gap-4 font-bold">
                <span class="text-primary-600">📞</span> +62 882-0079-52010
              </div>
            </div>
          </div>
          <div class="lg:col-span-3">
            <div
              class="border-border-site bg-surface relative overflow-hidden rounded-[2.5rem] border p-8 shadow-xl lg:p-12"
            >
              <div
                class="bg-primary-500/5 absolute top-0 right-0 h-32 w-32 translate-x-1/2 -translate-y-1/2 rounded-full"
              >
              </div>
              <form id="contact-form" class="relative z-10 space-y-6">
                <div class="grid gap-6 sm:grid-cols-2">
                  <input
                    type="text"
                    name="first_name"
                    placeholder="Nama Depan"
                    required
                    class="focus:ring-primary-500/10 border-border-site bg-site text-on-site placeholder-text-muted w-full rounded-2xl border px-5 py-4 transition-all outline-none focus:ring-4"
                  />
                  <input
                    type="text"
                    name="last_name"
                    placeholder="Nama Belakang"
                    class="focus:ring-primary-500/10 border-border-site bg-site text-on-site placeholder-text-muted w-full rounded-2xl border px-5 py-4 transition-all outline-none focus:ring-4"
                  />
                </div>
                <input
                  type="email"
                  name="email"
                  placeholder="Email Bisnis"
                  required
                  class="focus:ring-primary-500/10 border-border-site bg-site text-on-site placeholder-text-muted w-full rounded-2xl border px-5 py-4 transition-all outline-none focus:ring-4"
                />
                <select
                  name="subject"
                  class="focus:ring-primary-500/10 border-border-site bg-site text-on-site w-full cursor-pointer appearance-none rounded-2xl border px-5 py-4 transition-all outline-none focus:ring-4"
                >
                  <option value="consultation">Konsultasi Layanan</option>
                  <option value="collaboration">Kerjasama / Partnership</option>
                  <option value="other">Pertanyaan Umum</option>
                </select>
                <textarea
                  name="message"
                  rows="4"
                  placeholder="Ceritakan kebutuhan Anda..."
                  required
                  class="focus:ring-primary-500/10 border-border-site bg-site text-on-site placeholder-text-muted w-full resize-none rounded-2xl border px-5 py-4 transition-all outline-none focus:ring-4"
                ></textarea>
                <button
                  type="submit"
                  class="dark:bg-primary-600 dark:hover:bg-primary-700 flex w-full items-center justify-center gap-3 rounded-2xl bg-neutral-900 py-5 font-bold text-white shadow-xl shadow-neutral-900/10 transition-all hover:bg-black active:scale-[0.98]"
                >
                  Kirim via WhatsApp
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"
                    ></path></svg
                  >
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</UnifiedLayout>

<script>
  // WhatsApp form handling
  const form = document.getElementById("contact-form") as HTMLFormElement;
  if (form) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const data = Object.fromEntries(formData);

      const phoneNumber = "62882007952010";
      const fullName = `${data.first_name} ${data.last_name || ""}`.trim();

      const message = `*Halo KonXC!*\n\n*Nama:* ${fullName}\n*Email:* ${data.email}\n*Subjek:* ${data.subject}\n\n*Pesan:*\n${data.message}`;

      const whatsappUrl = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(message)}`;
      window.open(whatsappUrl, "_blank");

      const button = form.querySelector('button[type="submit"]');
      if (button) {
        button.innerHTML = "Mengarahkan...";
        setTimeout(() => {
          button.innerHTML =
            'Kirim via WhatsApp <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>';
          form.reset();
        }, 2000);
      }
    });
  }
</script>
