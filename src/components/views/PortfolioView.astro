---
import "@styles/global.css";
import Head from "@components/Head.astro";
---

<!doctype html>
<html lang="id">
  <head>
    <Head
      title="PT Koneksi Jaringan Indonesia | Open Source"
      description="PT Koneksi - Membangun ekosistem digital Indonesia yang kompetitif dan sehat melalui gotong royong. Open Source Portfolio."
    />
  </head>
  <body
    class="bg-site text-on-site selection:bg-primary-600 font-sans antialiased selection:text-white"
  >
    <main
      class="border-border-site bg-site relative mx-auto flex min-h-screen max-w-[1400px] flex-col border-x-2"
    >
      <!-- Grid Background -->
      <div
        class="pointer-events-none absolute inset-0 z-0 opacity-10"
        style="background-image: linear-gradient(var(--border-site) 1px, transparent 1px), linear-gradient(90deg, var(--border-site) 1px, transparent 1px); background-size: 40px 40px;"
      >
      </div>

      <div class="relative z-10">
        <!-- HEADER -->
        <header class="border-border-site bg-surface border-b-2 p-6 lg:p-12">
          <div
            class="flex flex-col items-start justify-between gap-8 lg:flex-row lg:items-center"
          >
            <div>
              <div
                class="text-primary-600 mb-4 flex items-center gap-3 font-mono text-xs font-bold tracking-widest uppercase"
              >
                <span class="bg-primary-600 h-3 w-3"></span>
                Sistem Repositori Publik
              </div>
              <h1
                class="text-5xl font-black tracking-tight uppercase lg:text-7xl"
              >
                Open Source
              </h1>
            </div>

            <div
              class="border-border-site bg-site border-2 p-4 font-mono text-sm"
            >
              <div class="text-on-muted mb-1 text-xs font-bold uppercase">
                Inisiator
              </div>
              <div class="font-bold">PT Koneksi Jaringan Indonesia</div>
            </div>
          </div>
        </header>

        <!-- INFO BAR -->
        <div
          class="border-border-site bg-site grid border-b-2 font-mono md:grid-cols-3"
        >
          <div
            class="border-border-site border-b-2 p-6 md:border-r-2 md:border-b-0"
          >
            <div class="text-on-muted mb-1 text-xs uppercase">Misi / Visi</div>
            <div class="font-bold">
              Gotong Royong Digital untuk Ekosistem Inovasi Indonesia.
            </div>
          </div>
          <div
            class="border-border-site flex flex-col justify-center border-b-2 p-6 md:border-r-2 md:border-b-0"
          >
            <div class="text-on-muted mb-1 text-xs uppercase">
              Status Server
            </div>
            <div class="flex items-center gap-2 font-bold text-green-500">
              <span class="h-2 w-2 animate-pulse rounded-full bg-green-500"
              ></span> ONLINE
            </div>
          </div>
          <div class="flex flex-col justify-center p-6">
            <div class="text-on-muted mb-1 text-xs uppercase">Direct Link</div>
            <a
              href="mailto:info@konxc.space"
              class="hover:text-primary-600 font-bold transition-colors"
              >info@konxc.space</a
            >
          </div>
        </div>

        <!-- LINKS GRID -->
        <div class="border-border-site grid border-b-2 md:grid-cols-3">
          <a
            href="https://github.com/konxc"
            target="_blank"
            class="border-border-site group bg-surface border-b-2 p-10 text-center transition-colors hover:bg-black hover:text-white md:border-r-2 md:border-b-0 dark:hover:bg-white dark:hover:text-black"
          >
            <div
              class="mb-4 font-mono text-4xl transition-transform group-hover:scale-110"
            >
              🐙
            </div>
            <h2 class="font-mono text-lg font-bold tracking-widest uppercase">
              GitHub
            </h2>
          </a>
          <a
            href="https://we-will-shine.konxc.space"
            class="border-border-site hover:bg-primary-600 group bg-surface border-b-2 p-10 text-center transition-colors hover:text-white md:border-r-2 md:border-b-0"
          >
            <div
              class="mb-4 font-mono text-4xl transition-transform group-hover:scale-110"
            >
              🎓
            </div>
            <h2 class="font-mono text-lg font-bold tracking-widest uppercase">
              We Will Shine
            </h2>
          </a>
          <a
            href="https://konxc.space"
            class="border-border-site group bg-surface p-10 text-center transition-colors hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black"
          >
            <div
              class="mb-4 font-mono text-4xl transition-transform group-hover:scale-110"
            >
              🚀
            </div>
            <h2 class="font-mono text-lg font-bold tracking-widest uppercase">
              Official Site
            </h2>
          </a>
        </div>

        <!-- PROJECTS -->
        <div class="p-6 lg:p-12">
          <div
            class="border-border-site mb-8 border-b-2 pb-4 font-mono text-sm font-bold tracking-widest uppercase"
          >
            Indeks Proyek Utama
          </div>

          <div class="grid gap-8 lg:grid-cols-2">
            <!-- Project 1 -->
            <div
              class="border-border-site bg-surface group hover:border-primary-600 border-2 p-8 shadow-[8px_8px_0px_0px_var(--border-site)] transition-colors hover:shadow-[8px_8px_0px_0px_var(--color-primary-600)]"
            >
              <div class="mb-6 flex items-start justify-between">
                <h3 class="text-3xl font-black uppercase">konxc.github.io</h3>
                <span
                  class="border-primary-600 text-primary-600 bg-primary-50 dark:bg-primary-900/30 border-2 px-3 py-1 font-mono text-xs font-bold uppercase"
                  >Astro</span
                >
              </div>
              <p class="text-on-muted mb-8 font-mono text-sm leading-relaxed">
                Website utama dan landing page PT Koneksi Jaringan Indonesia
                dengan arsitektur Dual Deployment (Corporate & Portfolio).
              </p>
              <a
                href="https://github.com/konxc/konxc.github.io"
                class="hover:border-primary-600 text-primary-600 inline-flex items-center gap-2 border-b-2 border-transparent font-mono text-xs font-bold uppercase transition-colors"
              >
                Akses Source Code <span aria-hidden="true">&rarr;</span>
              </a>
            </div>

            <!-- Project 2 -->
            <div
              class="border-border-site bg-surface group hover:border-primary-600 border-2 p-8 shadow-[8px_8px_0px_0px_var(--border-site)] transition-colors hover:shadow-[8px_8px_0px_0px_var(--color-primary-600)]"
            >
              <div class="mb-6 flex items-start justify-between">
                <h3 class="text-3xl font-black uppercase">TrackMe</h3>
                <span
                  class="border-2 border-green-500 bg-green-50 px-3 py-1 font-mono text-xs font-bold text-green-600 uppercase dark:bg-green-900/30 dark:text-green-400"
                  >Ecosystem</span
                >
              </div>
              <p class="text-on-muted mb-8 font-mono text-sm leading-relaxed">
                Ekosistem pelacakan dan analitik logistik untuk monitoring
                supply chain UMKM dengan aman dan transparan.
              </p>
              <a
                href="https://konxc.github.io/trackme"
                class="hover:border-primary-600 text-primary-600 inline-flex items-center gap-2 border-b-2 border-transparent font-mono text-xs font-bold uppercase transition-colors"
              >
                Pelajari Lebih Lanjut <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>
