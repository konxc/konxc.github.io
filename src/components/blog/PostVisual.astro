---
interface Props {
  title: string;
  category: string;
  image?: string;
  slug: string;
  class?: string;
}

const { title, category, image, slug, class: className = "" } = Astro.props;

// Deterministic hash for variety
const getHash = (str: string) => {
  let hash = 0;
  for (let i = 0; i < str.length; i++) {
    hash = str.charCodeAt(i) + ((hash << 5) - hash);
  }
  return Math.abs(hash);
};

const hash = getHash(slug + title);

// Color generator
const getColors = (category: string, hash: number) => {
  const themes: Record<string, { h: number; s: number; l: number }> = {
    technical: { h: 210, s: 70, l: 45 },
    tutorial: { h: 140, s: 60, l: 40 },
    "case-study": { h: 25, s: 80, l: 45 },
    insights: { h: 280, s: 60, l: 50 },
    engineering: { h: 210, s: 20, l: 35 },
    devops: { h: 190, s: 80, l: 40 },
    frontend: { h: 330, s: 80, l: 50 },
    backend: { h: 250, s: 70, l: 45 },
    career: { h: 40, s: 90, l: 45 },
    ai: { h: 270, s: 80, l: 45 },
    business: { h: 200, s: 10, l: 35 },
    testing: { h: 170, s: 70, l: 40 },
  };

  const base = themes[category] || { h: 0, s: 0, l: 45 };

  // Slightly jitter the hue based on hash
  const h = (base.h + (hash % 40) - 20 + 360) % 360;

  return {
    c1: `hsl(${h}, ${base.s}%, ${base.l}%)`,
    c2: `hsl(${(h + 45) % 360}, ${base.s + 15}%, ${base.l - 10}%)`,
    c3: `hsl(${(h - 35 + 360) % 360}, ${base.s - 5}%, ${base.l + 10}%)`,
  };
};

const colors = getColors(category, hash);
const hasImage =
  !!image && image !== "/images/blog/default-hero.png" && image !== "";

// Mesh point positions
const p1 = { x: hash % 100, y: (hash >> 2) % 100 };
const p2 = { x: 100 - (hash % 100), y: 100 - ((hash >> 4) % 100) };

const meshStyle = `
    background-color: ${colors.c1};
    background-image: 
        radial-gradient(at ${p1.x}% ${p1.y}%, ${colors.c2} 0px, transparent 55%),
        radial-gradient(at ${p2.x}% ${p2.y}%, ${colors.c3} 0px, transparent 55%);
`;

const getEmoji = (cat: string, slug: string) => {
  if (slug.includes("sveltekit")) return "🧡";
  if (slug.includes("tailwind")) return "🌊";
  if (slug.includes("git-worktree")) return "🌿";

  const emojis: Record<string, string> = {
    ai: "🤖",
    frontend: "🎨",
    backend: "⚙️",
    engineering: "🏗️",
    devops: "🚀",
    testing: "🧪",
    "case-study": "📂",
    tutorial: "📚",
    technical: "💻",
    insights: "💡",
    career: "🎯",
    business: "📈",
  };
  return emojis[cat] || "📝";
};

const isSvelteCaseStudy = slug.includes(
  "case-study-memindahkan-route-sveltekit-worktree",
);
const isGitWorktreeWorkflow = slug.includes(
  "git-worktree-workflow-lengkap-merge-ke-main",
);
---

<div
  class={`relative overflow-hidden group border border-white/5 dark:border-white/10 bg-neutral-100 dark:bg-neutral-800 ${className}`}
  style={meshStyle}
>
  {
    hasImage && (
      <img
        src={image}
        alt={title}
        class="absolute inset-0 h-full w-full object-cover opacity-0 transition-all duration-700 group-hover:scale-110"
        loading="lazy"
        onload="this.classList.remove('opacity-0'); this.classList.add('opacity-100')"
      />
    )
  }

  {
    /* Fallback/Layered Content - Show when no image or behind transparent/loading image */
  }
  <div
    class={`absolute inset-0 flex flex-col items-center justify-center p-6 text-center transition-opacity duration-500 ${hasImage ? "opacity-0 group-hover:opacity-100 bg-black/20" : "opacity-100"}`}
  >
    <div
      class="relative z-10 transition-all duration-700 group-hover:scale-110"
    >
      {/* Special Graphic for Svelte Case Study */}
      {
        isSvelteCaseStudy ? (
          <div class="relative mb-6 flex h-32 w-48 items-center justify-center gap-4">
            <div class="flex h-16 w-16 animate-pulse items-center justify-center rounded-2xl border border-white/20 bg-white/10 shadow-xl backdrop-blur-xl">
              <span class="text-3xl">📁</span>
            </div>
            <div class="relative h-0.5 flex-1 bg-gradient-to-r from-white/20 via-orange-400 to-white/20">
              <div
                class="absolute top-1/2 left-0 h-4 w-4 -translate-y-1/2 animate-[move_3s_infinite_linear] rounded-full bg-orange-500 blur-sm"
                style="left: -10%;"
              />
            </div>
            <div class="flex h-16 w-16 items-center justify-center rounded-2xl border border-white/40 bg-white/20 shadow-2xl backdrop-blur-xl">
              <span class="text-3xl">🧡</span>
            </div>
          </div>
        ) : isGitWorktreeWorkflow ? (
          <div class="relative mb-6 flex h-32 w-48 flex-col items-center justify-center">
            <div class="relative h-1 w-full overflow-hidden rounded-full bg-white/20">
              <div class="absolute inset-0 translate-x-[-100%] animate-[flow_4s_infinite_ease-in-out] bg-gradient-to-r from-teal-400 to-emerald-400" />
            </div>
            <div class="mt-4 flex gap-8">
              {[1, 2, 3].map((i) => (
                <div
                  class={`flex h-12 w-12 animate-bounce items-center justify-center rounded-full border border-white/30 bg-white/10 backdrop-blur-md`}
                  style={`animation-delay: ${i * 0.2}s`}
                >
                  <span class="text-xl">🎋</span>
                </div>
              ))}
            </div>
          </div>
        ) : (
          <div class="mb-4 flex justify-center">
            <div class="relative flex h-20 w-20 items-center justify-center rounded-3xl border border-white/20 bg-white/10 shadow-2xl backdrop-blur-xl transition-all duration-500 group-hover:rotate-12 group-hover:bg-white/20">
              <span class="text-4xl drop-shadow-md filter">
                {getEmoji(category, slug)}
              </span>
              <div class="absolute -top-2 -right-2 h-6 w-6 animate-bounce rounded-full bg-white/20 blur-sm" />
            </div>
          </div>
        )
      }

      <span
        class="block text-xs font-black tracking-[0.4em] text-white uppercase drop-shadow-lg"
      >
        {category}
      </span>
    </div>
  </div>

  {/* Decorative Layers */}
  <div
    class="pointer-events-none absolute -top-1/3 -right-1/3 h-[150%] w-[150%] bg-gradient-to-br from-white/10 to-transparent opacity-50 blur-3xl"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-black/20"
  >
  </div>

  {/* Texture/Noise Layer */}
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.15] mix-blend-overlay"
    style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noise%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.65%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noise)%22/%3E%3C/svg%3E');"
  >
  </div>
</div>

<style>
  @keyframes move {
    0% {
      transform: translate(-10%, -50%);
      opacity: 0;
    }
    20% {
      opacity: 1;
    }
    80% {
      opacity: 1;
    }
    100% {
      transform: translate(110%, -50%);
      opacity: 0;
    }
  }
  @keyframes flow {
    0% {
      transform: translateX(-100%);
    }
    50% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(100%);
    }
  }
</style>
