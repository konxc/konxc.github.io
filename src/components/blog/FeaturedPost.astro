---
// Featured Post Component
import Card from "@components/ui/Card.astro";
import type { CollectionEntry } from "astro:content";

export interface Props {
  class?: string;
  post: CollectionEntry<"blog">;
}

const { class: className, post } = Astro.props;

const publishDate = post.data.publishDate.toLocaleDateString("id-ID", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<section class={`featured-post section bg-white ${className || ""}`}>
  <div class="container">
    <h2 class="mb-8 text-center text-3xl font-bold">Artikel Unggulan</h2>
    <div class="mx-auto max-w-4xl">
      <Card variant="featured" class="group text-center">
        <div class="mb-6">
          <div class="text-primary-600 mb-2 text-sm font-semibold">
            {post.data.category.toUpperCase()}
          </div>
          <h3
            class="group-hover:text-primary-600 mb-4 text-2xl font-bold transition-colors"
          >
            {post.data.title}
          </h3>
          <p class="mb-4 text-neutral-600">{post.data.description}</p>
        </div>

        <div
          class="mb-6 flex items-center justify-center gap-4 text-sm text-neutral-500"
        >
          <div class="flex items-center gap-2">
            <span
              class="bg-primary-100 text-primary-600 flex h-8 w-8 items-center justify-center rounded-full font-semibold"
            >
              {post.data.author.charAt(0)}
            </span>
            <span>By {post.data.author}</span>
          </div>
          <span>•</span>
          <span>{publishDate}</span>
          {
            post.data.readingTime && (
              <>
                <span>•</span>
                <span>{post.data.readingTime} min read</span>
              </>
            )
          }
        </div>

        <div class="mb-6 flex items-center justify-center gap-4">
          {
            post.data.tags
              .slice(0, 3)
              .map((tag) => (
                <span class="bg-primary-100 text-primary-700 rounded-full px-3 py-1 text-xs font-medium">
                  #{tag}
                </span>
              ))
          }
        </div>

        <a
          href={`/blog/${post.slug}`}
          class="btn-primary transition-all duration-200 group-hover:-translate-y-0.5 group-hover:transform"
        >
          Baca Artikel
        </a>
      </Card>
    </div>
  </div>
</section>

<style>
  @reference "@/styles/global.css";
  .featured-post {
    @apply relative;
  }

  .featured-post .btn-primary {
    @apply bg-primary-500 hover:bg-primary-600 inline-flex items-center gap-2 rounded-lg px-6 py-3 font-semibold text-white shadow-lg transition-all duration-200 hover:shadow-xl;
  }

  .featured-post .btn-primary:hover {
    @apply -translate-y-0.5 transform;
  }

  /* Dark mode styles */
  .dark .featured-post h2 {
    @apply text-neutral-100;
  }

  .dark .featured-post h3 {
    @apply text-neutral-200;
  }

  .dark .featured-post p {
    @apply text-neutral-400;
  }

  .dark .featured-post .text-neutral-500 {
    @apply text-neutral-400;
  }

  /* Animation for featured card */
  .featured-post .group:hover {
    @apply -translate-y-1 transform transition-all duration-300;
  }
</style>
