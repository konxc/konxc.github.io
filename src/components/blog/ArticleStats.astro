---
// Simple Article Stats Component
// Mempertahankan gaya lama yang sederhana dan clean
export interface Props {
  readingTime?: number;
  wordCount?: number;
  views?: number;
  publishDate?: Date;
}

const {
  readingTime = 5,
  wordCount = 0,
  views = 0,
  publishDate = new Date(),
} = Astro.props;
---

<div class="sidebar-widget">
  <div class="border-border-site bg-surface rounded-lg border p-4 shadow-sm">
    <h3 class="text-on-site mb-3 text-sm font-semibold">Statistik Artikel</h3>
    <div class="space-y-3">
      <div class="flex items-center justify-between">
        <span class="text-on-muted text-xs">Kata</span>
        <span class="text-on-site text-sm font-medium" id="word-count"
          >{wordCount}</span
        >
      </div>
      <div class="flex items-center justify-between">
        <span class="text-on-muted text-xs">Waktu Baca</span>
        <span
          class="text-on-site text-sm font-medium"
          data-reading-time={readingTime}>{readingTime} min</span
        >
      </div>
      <div class="flex items-center justify-between">
        <span class="text-on-muted text-xs">Views</span>
        <span class="text-on-site text-sm font-medium">{views}</span>
      </div>
      <div class="flex items-center justify-between">
        <span class="text-on-muted text-xs">Tanggal</span>
        <span class="text-on-site text-sm font-medium"
          >{publishDate.toLocaleDateString("id-ID")}</span
        >
      </div>
    </div>
  </div>
</div>
