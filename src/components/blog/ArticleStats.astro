---
// Simple Article Stats Component
// Mempertahankan gaya lama yang sederhana dan clean
export interface Props {
  readingTime?: number;
  wordCount?: number;
  views?: number;
  publishDate?: Date;
}

const {
  readingTime = 5,
  wordCount = 0,
  views = 0,
  publishDate = new Date(),
} = Astro.props;
---

<div class="sidebar-widget">
  <div
    class="rounded-lg border border-neutral-100 bg-white p-4 shadow-sm dark:border-white/10 dark:bg-[var(--dark-bg-secondary)]"
  >
    <h3
      class="mb-3 text-sm font-semibold text-neutral-900 dark:text-neutral-100"
    >
      Statistik Artikel
    </h3>
    <div class="space-y-3">
      <div class="flex items-center justify-between">
        <span class="text-xs text-neutral-600 dark:text-neutral-400">Kata</span>
        <span
          class="text-sm font-medium text-neutral-900 dark:text-neutral-200"
          id="word-count">{wordCount}</span
        >
      </div>
      <div class="flex items-center justify-between">
        <span class="text-xs text-neutral-600 dark:text-neutral-400"
          >Waktu Baca</span
        >
        <span
          class="text-sm font-medium text-neutral-900 dark:text-neutral-200"
          data-reading-time={readingTime}>{readingTime} min</span
        >
      </div>
      <div class="flex items-center justify-between">
        <span class="text-xs text-neutral-600 dark:text-neutral-400">Views</span
        >
        <span class="text-sm font-medium text-neutral-900 dark:text-neutral-200"
          >{views}</span
        >
      </div>
      <div class="flex items-center justify-between">
        <span class="text-xs text-neutral-600 dark:text-neutral-400"
          >Tanggal</span
        >
        <span class="text-sm font-medium text-neutral-900 dark:text-neutral-200"
          >{publishDate.toLocaleDateString("id-ID")}</span
        >
      </div>
    </div>
  </div>
</div>
