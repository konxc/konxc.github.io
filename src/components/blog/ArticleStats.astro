---
// Simple Article Stats Component
// Mempertahankan gaya lama yang sederhana dan clean
export interface Props {
  readingTime?: number;
  wordCount?: number;
  views?: number;
  publishDate?: Date;
}

const {
  readingTime = 5,
  wordCount = 0,
  views = 0,
  publishDate = new Date(),
} = Astro.props;
---

<div class="sidebar-widget">
  <div
    class="rounded-lg border border-border-site bg-surface p-4 shadow-sm"
  >
    <h3
      class="mb-3 text-sm font-semibold text-on-site"
    >
      Statistik Artikel
    </h3>
    <div class="space-y-3">
      <div class="flex items-center justify-between">
        <span class="text-xs text-on-muted">Kata</span>
        <span
          class="text-sm font-medium text-on-site"
          id="word-count">{wordCount}</span
        >
      </div>
      <div class="flex items-center justify-between">
        <span class="text-xs text-on-muted"
          >Waktu Baca</span
        >
        <span
          class="text-sm font-medium text-on-site"
          data-reading-time={readingTime}>{readingTime} min</span
        >
      </div>
      <div class="flex items-center justify-between">
        <span class="text-xs text-on-muted">Views</span
        >
        <span class="text-sm font-medium text-on-site"
          >{views}</span
        >
      </div>
      <div class="flex items-center justify-between">
        <span class="text-xs text-on-muted"
          >Tanggal</span
        >
        <span class="text-sm font-medium text-on-site"
          >{publishDate.toLocaleDateString("id-ID")}</span
        >
      </div>
    </div>
  </div>
</div>
