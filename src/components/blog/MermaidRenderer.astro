---
/**
 * MermaidRenderer.astro
 *
 * Client-side renderer for Mermaid diagrams in blog posts.
 * This component handles searching for mermaid code blocks and rendering them
 * as interactive SVG diagrams.
 */
---

<div id="mermaid-root" class="hidden"></div>

<script>
    // Singleton pattern for mermaid loading
    let mermaidLoading: Promise<any> | null = null;

    async function loadMermaid() {
        if (mermaidLoading) return mermaidLoading;

        mermaidLoading = (async () => {
            const { default: mermaid } = await import("mermaid");

            const isDark = document.documentElement.classList.contains("dark");

            mermaid.initialize({
                startOnLoad: false,
                theme: isDark ? "dark" : "default",
                securityLevel: "loose",
                fontFamily: "Outfit, system-ui, sans-serif",
                // Trick 1: Disable useMaxWidth to let CSS handle it via overflow
                // This prevents the SVG from being squashed/clipped incorrectly
                // @ts-ignore - property exists at runtime to prevent scaling issues
                useMaxWidth: false,
                themeVariables: isDark
                    ? {
                          primaryColor: "#4a5dff",
                          primaryTextColor: "#f1f5f9",
                          background: "#111720",
                          mainBkg: "#161d2a",
                          // Trick 2: Add padding to nodes to prevent text touching borders
                          nodePadding: 15,
                      }
                    : {
                          primaryColor: "#4a5dff",
                          primaryTextColor: "#1e293b",
                          background: "#ffffff",
                          mainBkg: "#f8fafc",
                          nodePadding: 15,
                      },
                flowchart: { htmlLabels: true, curve: "linear" },
            });

            return mermaid;
        })();

        return mermaidLoading;
    }

    async function renderDiagrams() {
        // Trick 3: Wait for fonts to be ready so Mermaid calculates text width accurately
        if ("fonts" in document) {
            await (document as any).fonts.ready;
        }

        const mermaid = await loadMermaid();

        // Find all potential diagrams.
        // Shiki/Astro usually wraps code in pre > code.
        // We look for elements that have 'mermaid' in their class list or content.
        const codeBlocks = document.querySelectorAll("pre code");

        let diagramCount = 0;

        for (const codeEl of codeBlocks) {
            const preEl = codeEl.parentElement;
            if (!preEl || preEl.classList.contains("mermaid-processed"))
                continue;

            // Extract text content and clean it
            const content = codeEl.textContent?.trim() || "";

            // Check if this is a mermaid diagram
            // We look for common mermaid keywords at the start
            const isMermaid =
                content.startsWith("graph ") ||
                content.startsWith("graph\n") ||
                content.startsWith("sequenceDiagram") ||
                content.startsWith("pie") ||
                content.startsWith("classDiagram") ||
                content.startsWith("stateDiagram") ||
                content.startsWith("erDiagram") ||
                content.startsWith("gantt") ||
                content.startsWith("gitGraph") ||
                preEl.classList.contains("language-mermaid") ||
                codeEl.classList.contains("language-mermaid");

            if (isMermaid) {
                preEl.classList.add("mermaid-processed");
                const id = `mermaid-blog-${diagramCount++}`;
                const container = document.createElement("div");
                container.className =
                    "mermaid-container my-8 flex justify-center overflow-x-auto rounded-xl bg-neutral-50 p-6 dark:bg-white/5";
                container.id = `container-${id}`;

                // Hide the original pre block
                preEl.style.display = "none";
                preEl.insertAdjacentElement("afterend", container);

                // Trick 4: Small delay to ensure container is in DOM
                requestAnimationFrame(async () => {
                    try {
                        const { svg } = await mermaid.render(id, content);
                        container.innerHTML = svg;

                        // Optional: Add a label or caption if needed
                    } catch (error) {
                        console.error(`[Mermaid Blog] Render error:`, error);
                        container.innerHTML = `<div class="p-4 bg-red-500/10 text-red-500 rounded text-xs"><p class="font-bold mb-1">Diagram Error</p></div>`;
                    }
                });
            }
        }
    }

    // Handle initialization on page load and navigation
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", renderDiagrams);
    } else {
        renderDiagrams();
    }

    // Observer for theme changes (dark mode toggle)
    const observer = new MutationObserver(async (mutations) => {
        for (const mutation of mutations) {
            if (
                mutation.type === "attributes" &&
                mutation.attributeName === "class"
            ) {
                // Re-render diagrams on theme change to update colors
                // Note: Mermaid render is destructive, so we might need to refresh the page
                // or re-fetch content if we want perfect theme switching.
                // For now, let's just re-initialize for future navigation.
                mermaidLoading = null;
            }
        }
    });

    observer.observe(document.documentElement, { attributes: true });
</script>

<style is:global>
    /* Ensure mermaid diagrams are responsive */
    .mermaid-container svg {
        max-width: 100%;
        height: auto;
    }

    /* Prevent Shiki from highlighting mermaid blocks if possible */
    pre.language-mermaid {
        @apply opacity-0; /* Hide until processed */
    }
</style>
