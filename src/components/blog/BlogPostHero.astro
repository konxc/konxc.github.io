---
import { type CollectionEntry } from "astro:content";

export interface Props {
    post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
---

<section
    class="from-primary-50 to-secondary-50 relative overflow-hidden bg-linear-to-br pt-24 pb-10 md:pt-32 md:pb-14"
>
    {
        post.data.coverImage && (
            <div class="pointer-events-none absolute inset-0 opacity-10">
                <img
                    src={post.data.coverImage}
                    alt=""
                    class="h-full w-full scale-110 object-cover blur-sm filter"
                />
            </div>
        )
    }
    <div class="container">
        <div class="mx-auto max-w-4xl text-center">
            <div
                class="text-primary-600 mb-4 text-sm font-semibold tracking-wide uppercase"
            >
                {post.data.category}
            </div>
            <h1 class="mb-6 text-4xl font-bold lg:text-5xl">
                {post.data.title}
            </h1>
            <p class="mb-8 text-xl text-neutral-600">
                {post.data.description}
            </p>

            <div
                class="mb-8 flex items-center justify-center gap-6 text-sm text-neutral-500"
            >
                <div class="flex items-center gap-2">
                    <span
                        class="bg-primary-100 text-primary-600 flex h-8 w-8 items-center justify-center rounded-full font-semibold"
                    >
                        {post.data.author.charAt(0)}
                    </span>
                    <span>By {post.data.author}</span>
                </div>
                <span>•</span>
                <span>{post.data.publishDate.toLocaleDateString("id-ID")}</span>
                {
                    post.data.readingTime && (
                        <>
                            <span>•</span>
                            <span>{post.data.readingTime} min read</span>
                        </>
                    )
                }
            </div>

            <div class="flex flex-wrap justify-center gap-2">
                {
                    post.data.tags.map((tag: string) => (
                        <span class="text-primary-600 rounded-full bg-white px-3 py-1 text-sm font-medium shadow-sm">
                            #{tag}
                        </span>
                    ))
                }
            </div>

            {
                post.data.coverImage && (
                    <div class="mt-12 flex justify-center overflow-hidden rounded-2xl shadow-2xl ring-1 ring-black/5">
                        <img
                            src={post.data.coverImage}
                            alt={post.data.title}
                            class="h-auto max-w-full object-cover"
                        />
                    </div>
                )
            }
        </div>
    </div>
</section>
