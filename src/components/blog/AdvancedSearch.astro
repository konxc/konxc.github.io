---
// Advanced Search Component (Modal Overlay)
export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div id="advanced-search-modal" class={`fixed inset-0 z-50 hidden ${className || ''}`} aria-labelledby="modal-title" role="dialog" aria-modal="true">
  <!-- Backdrop -->
  <div class="fixed inset-0 bg-neutral-900/50 backdrop-blur-sm transition-opacity opacity-0" id="search-backdrop"></div>

  <!-- Modal Panel -->
  <div class="fixed inset-0 z-10 overflow-y-auto">
    <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-start sm:p-0">
      <div 
        class="relative transform overflow-hidden rounded-2xl bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-4xl opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
        id="search-panel"
      >
        <!-- Modal Header -->
        <div class="bg-white px-4 pb-4 pt-5 sm:p-6 sm:pb-4 border-b border-neutral-100 sticky top-0 z-20">
          <div class="flex items-center justify-between gap-4">
            <div class="relative flex-1">
              <svg class="pointer-events-none absolute left-4 top-3.5 h-5 w-5 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
              </svg>
              <input
                type="text"
                id="advanced-search-input"
                class="block w-full rounded-xl border-0 bg-neutral-50 py-3 pl-11 pr-4 text-neutral-900 ring-1 ring-inset ring-neutral-200 placeholder:text-neutral-400 focus:ring-2 focus:ring-inset focus:ring-primary-600 sm:text-sm sm:leading-6"
                placeholder="Cari artikel, topik, atau penulis..."
                autocomplete="off"
              />
              <!-- Clear Button -->
               <button
                type="button"
                id="clear-search-btn"
                class="absolute right-3 top-2.5 hidden rounded-md p-1 text-neutral-400 hover:text-neutral-500 focus:outline-none"
              >
                <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                </svg>
              </button>
            </div>
            <button
              type="button"
              class="rounded-md bg-white text-neutral-400 hover:text-neutral-500 focus:outline-none"
              onclick="closeSearchModal()"
            >
              <span class="sr-only">Close</span>
              <kbd class="hidden sm:inline-block rounded border border-neutral-200 bg-neutral-50 px-2 py-0.5 text-xs font-light text-neutral-500 mr-2">ESC</kbd>
              <svg class="h-6 w-6 inline-block" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>
          
           <!-- Filter Options (Horizontal Scroll) -->
          <div class="mt-4 flex gap-2 overflow-x-auto pb-2 scrollbar-hide" id="quick-filters">
             <!-- Populated via JS -->
          </div>
        </div>

        <!-- Content Area -->
        <div class="px-4 py-4 sm:p-6 min-h-[400px] max-h-[60vh] overflow-y-auto bg-neutral-50/50" id="search-content-area">
          
          <!-- Default State (Suggestions) -->
          <div id="search-suggestions" class="space-y-8">
            <div>
               <h4 class="text-xs font-semibold uppercase tracking-wider text-neutral-500 mb-3">Topik Populer</h4>
               <div class="flex flex-wrap gap-2" id="popular-topics-container">
                  <!-- Populated via JS -->
               </div>
            </div>
            
             <div>
               <h4 class="text-xs font-semibold uppercase tracking-wider text-neutral-500 mb-3">Artikel Terbaru</h4>
               <div class="grid gap-4 sm:grid-cols-2" id="recent-articles-container">
                  <!-- Populated via JS -->
               </div>
            </div>
          </div>

          <!-- Results State -->
          <div id="search-results-container" class="hidden space-y-4">
             <!-- Results Populated via JS -->
          </div>
          
           <!-- Empty State -->
          <div id="search-empty-state" class="hidden flex flex-col items-center justify-center py-12 text-center">
            <div class="rounded-full bg-neutral-100 p-4 mb-4">
               <svg class="h-8 w-8 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7 0 0010.607 10.607z" />
               </svg>
            </div>
            <h3 class="text-sm font-semibold text-neutral-900">Tidak ada hasil ditemukan</h3>
            <p class="mt-1 text-sm text-neutral-500">Coba ubah kata kunci atau hapus filter pencarian Anda.</p>
          </div>

        </div>
        
        <!-- Footer -->
        <div class="bg-neutral-50 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6 border-t border-neutral-100 text-xs text-neutral-400">
           <span>Tekan <kbd class="font-sans font-semibold border rounded px-1">↵</kbd> untuk memilih</span>
           <span class="mr-4">Tekan <kbd class="font-sans font-semibold border rounded px-1">↑</kbd> <kbd class="font-sans font-semibold border rounded px-1">↓</kbd> untuk navigasi</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  // Global functions to be accessible from onClick handlers
  window.closeSearchModal = function() {
    const modal = document.getElementById('advanced-search-modal');
    const backdrop = document.getElementById('search-backdrop');
    const panel = document.getElementById('search-panel');
    
    if (modal && backdrop && panel) {
       backdrop.classList.remove('opacity-100');
       backdrop.classList.add('opacity-0');
       
       panel.classList.remove('opacity-100', 'translate-y-0', 'scale-100');
       panel.classList.add('opacity-0', 'translate-y-4', 'sm:translate-y-0', 'sm:scale-95');
       
       setTimeout(() => {
         modal.classList.add('hidden');
         document.body.style.overflow = ''; // Restore scrolling
       }, 300);
    }
  };
</script>

<script>
  import Fuse from 'fuse.js';

  class SearchModal {
    private modal: HTMLElement;
    private input: HTMLInputElement;
    private resultsContainer: HTMLElement;
    private suggestionsContainer: HTMLElement;
    private emptyState: HTMLElement;
    private clearBtn: HTMLElement;
    private allPosts: any[] = [];
    private fuse: Fuse<any> | null = null;
    
    constructor() {
      this.modal = document.getElementById('advanced-search-modal')!;
      this.input = document.getElementById('advanced-search-input') as HTMLInputElement;
      this.resultsContainer = document.getElementById('search-results-container')!;
      this.suggestionsContainer = document.getElementById('search-suggestions')!;
      this.emptyState = document.getElementById('search-empty-state')!;
      this.clearBtn = document.getElementById('clear-search-btn')!;
      
      this.init();
    }

    private async init() {
      await this.loadData();
      this.setupListeners();
      this.renderSuggestions();
    }

    private async loadData() {
       try {
        const response = await fetch('/api/posts');
        if (response.ok) {
          this.allPosts = await response.json();
        } else {
           // Fallback
          const fallbackDataScript = document.getElementById('posts-data');
          if (fallbackDataScript && fallbackDataScript.textContent) {
            this.allPosts = JSON.parse(fallbackDataScript.textContent);
          }
        }
        
        this.fuse = new Fuse(this.allPosts, {
          keys: [
            { name: 'title', weight: 0.7 },
            { name: 'description', weight: 0.5 },
             { name: 'tags', weight: 0.4 },
             { name: 'category', weight: 0.3 }
          ],
          includeScore: true,
          threshold: 0.3
        });
        
      } catch (e) {
        console.error("Failed to load search data", e);
      }
    }

    private setupListeners() {
      // Input handling with debounce
      this.input.addEventListener('input', (e) => {
        const query = (e.target as HTMLInputElement).value;
        this.handleSearch(query);
      });
      
      // Clear button
      this.clearBtn.addEventListener('click', () => {
         this.input.value = '';
         this.handleSearch('');
         this.input.focus();
      });

      // Keyboard shortcuts
      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
          e.preventDefault();
          this.open();
        }
        if (e.key === 'Escape' && !this.modal.classList.contains('hidden')) {
          (window as any).closeSearchModal?.();
        }
      });
      
      // Open modal trigger observer
      const observer = new MutationObserver((mutations) => {
         mutations.forEach((mutation) => {
            if (mutation.type === 'attributes' && mutation.attributeName === 'class') {
               if (!this.modal.classList.contains('hidden')) {
                  this.onOpen();
               }
            }
         });
      });
      
      observer.observe(this.modal, { attributes: true });
    }
    
    private onOpen() {
       document.body.style.overflow = 'hidden'; // Prevent background scrolling
       
       // Animate in
       requestAnimationFrame(() => {
          const backdrop = document.getElementById('search-backdrop');
          const panel = document.getElementById('search-panel');
          
          if (backdrop && panel) {
             backdrop.classList.remove('opacity-0');
             backdrop.classList.add('opacity-100');
             
             panel.classList.remove('opacity-0', 'translate-y-4', 'sm:translate-y-0', 'sm:scale-95');
             panel.classList.add('opacity-100', 'translate-y-0', 'scale-100');
          }
       });
       
       this.input.focus();
    }

    public open() {
       this.modal.classList.remove('hidden');
    }

    private handleSearch(query: string) {
       if (!query.trim()) {
         this.showSuggestions();
         this.clearBtn.classList.add('hidden');
         return;
       }
       
       this.clearBtn.classList.remove('hidden');
       
       if (!this.fuse) return;
       
       const results = this.fuse.search(query).map(r => r.item);
       this.renderResults(results);
    }
    
    private showSuggestions() {
       this.resultsContainer.classList.add('hidden');
       this.emptyState.classList.add('hidden');
       this.suggestionsContainer.classList.remove('hidden');
    }

    private renderSuggestions() {
       const topicsContainer = document.getElementById('popular-topics-container');
       const recentContainer = document.getElementById('recent-articles-container');
       
       if (topicsContainer && this.allPosts.length) {
          // Extract unique categories
          const categories = [...new Set(this.allPosts.map(p => p.category))].slice(0, 6);
           topicsContainer.innerHTML = categories.map(cat => `
             <button 
               class="px-3 py-1.5 bg-white border border-neutral-200 rounded-lg text-sm text-neutral-600 hover:border-primary-500 hover:text-primary-600 transition-colors"
               onclick="const input = document.getElementById('advanced-search-input'); input.value = '${cat}'; input.dispatchEvent(new Event('input'));"
             >
               ${cat}
             </button>
           `).join('');
       }
       
       if (recentContainer && this.allPosts.length) {
          const recent = this.allPosts.sort((a, b) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime()).slice(0, 4);
          recentContainer.innerHTML = recent.map(post => `
             <a href="/blog/${post.id}" class="flex items-start gap-3 p-3 rounded-xl hover:bg-neutral-100 transition-colors group">
               <div class="h-12 w-12 flex-shrink-0 bg-neutral-200 rounded-lg overflow-hidden">
                   <!-- Image Placeholder or Actual Image -->
                    <div class="w-full h-full bg-primary-100 flex items-center justify-center text-primary-500 font-bold">
                       ${post.title.charAt(0)}
                    </div>
               </div>
               <div class="min-w-0">
                  <h5 class="text-sm font-medium text-neutral-900 group-hover:text-primary-600 truncate">${post.title}</h5>
                  <p class="text-xs text-neutral-500 truncate">${post.category} • ${new Date(post.publishDate).toLocaleDateString()}</p>
               </div>
             </a>
          `).join('');
       }
    }

    private renderResults(results: any[]) {
       this.suggestionsContainer.classList.add('hidden');
       this.resultsContainer.classList.remove('hidden');
       
       if (results.length === 0) {
          this.resultsContainer.classList.add('hidden');
          this.emptyState.classList.remove('hidden');
          return;
       }
       
       this.emptyState.classList.add('hidden');
       
       this.resultsContainer.innerHTML = results.map(post => `
         <a href="/blog/${post.id}" class="flex flex-col sm:flex-row gap-4 p-4 rounded-xl bg-white border border-neutral-100 hover:border-primary-500 hover:shadow-md transition-all group">
            <div class="min-w-0 flex-1">
               <div class="flex items-center gap-2 mb-1">
                  <span class="inline-flex items-center rounded-md bg-neutral-50 px-2 py-1 text-xs font-medium text-neutral-600 ring-1 ring-inset ring-neutral-500/10">
                    ${post.category}
                  </span>
                  ${post.featured ? '<span class="inline-flex items-center rounded-md bg-yellow-50 px-2 py-1 text-xs font-medium text-yellow-800 ring-1 ring-inset ring-yellow-600/20">Featured</span>' : ''}
               </div>
               <h4 class="text-base font-semibold text-neutral-900 group-hover:text-primary-600">${post.title}</h4>
               <p class="mt-1 text-sm text-neutral-500 line-clamp-2">${post.description}</p>
            </div>
            <div class="flex items-center text-xs text-neutral-400 whitespace-nowrap sm:self-center">
                <span>Jump to article</span>
                <svg class="ml-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
            </div>
         </a>
       `).join('');
    }
  }

  // Initialize
  document.addEventListener('astro:page-load', () => new SearchModal());
  document.addEventListener('DOMContentLoaded', () => new SearchModal());
</script>
