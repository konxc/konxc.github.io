---
// Posts Grid Component - Pure Presentation
import type { CollectionEntry } from "astro:content";
import PostVisual from "./PostVisual.astro";

export interface Props {
  class?: string;
  posts: CollectionEntry<"blog">[];
  title?: string;
  useContainer?: boolean;
  columns?: 2 | 3;
}

const {
  class: className,
  posts,
  title,
  useContainer = true,
  columns = 3,
} = Astro.props;

// Formatting utility
const formatDate = (date: Date) => {
  return date.toLocaleDateString("id-ID", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
};
---

<section
  class={`posts-grid ${className || ""} ${useContainer ? "container" : ""}`}
>
  {
    title && (
      <div class="mb-8 flex items-end justify-between border-b border-neutral-100 pb-4 dark:border-neutral-800">
        <h2 class="text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
          {title}
        </h2>
      </div>
    )
  }

  {
    posts.length === 0 ? (
      <div class="text-center py-16 bg-neutral-50 rounded-2xl border border-neutral-100 dark:bg-neutral-800 dark:border-neutral-700">
        <div class="text-6xl mb-4">📝</div>
        <h3 class="text-2xl font-bold mb-2 text-neutral-800 dark:text-neutral-100">
          Belum ada artikel
        </h3>
        <p class="text-neutral-500 max-w-md mx-auto dark:text-neutral-400">
          Kami sedang menyiapkan konten menarik untuk Anda. Silakan kembali lagi
          nanti.
        </p>
      </div>
    ) : (
      <div
        class={`grid gap-8 ${columns === 3 ? "md:grid-cols-2 lg:grid-cols-3" : "md:grid-cols-2"}`}
      >
        {posts.map((post) => (
          <article class="group relative flex flex-col overflow-hidden rounded-2xl bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl border border-neutral-100 dark:bg-neutral-800 dark:border-neutral-700">
            {/* Image Container */}
            <a
              href={`/blog/${post.slug}`}
              class="relative aspect-[16/9] w-full overflow-hidden bg-neutral-100 dark:bg-neutral-800"
            >
              <PostVisual
                title={post.data.title}
                category={post.data.category}
                image={post.data.coverImage}
                slug={post.slug}
                class="absolute inset-0 h-full w-full"
              />
              <div class="absolute top-4 left-4 z-10 transition-all duration-500 ease-in-out group-hover:opacity-0 group-hover:invisible">
                <span class="inline-block rounded-md bg-white/90 backdrop-blur px-2.5 py-1 text-xs font-bold text-primary-700 shadow-sm uppercase tracking-wide dark:bg-neutral-900/90 dark:text-primary-400">
                  {post.data.category}
                </span>
              </div>
            </a>

            {/* Content */}
            <div class="flex flex-1 flex-col p-6">
              <div class="mb-3 flex items-center gap-2 text-xs font-medium text-neutral-500 dark:text-neutral-400">
                <time datetime={post.data.publishDate.toISOString()}>
                  {formatDate(post.data.publishDate)}
                </time>
                <span>•</span>
                <span>{post.data.readingTime} min read</span>
              </div>

              <h3 class="mb-3 text-xl font-bold leading-snug text-neutral-900 group-hover:text-primary-600 transition-colors dark:text-neutral-100 dark:group-hover:text-primary-400">
                <a href={`/blog/${post.slug}`} class="block focus:outline-none">
                  <span class="absolute inset-0" aria-hidden="true" />
                  {post.data.title}
                </a>
              </h3>

              <p class="mb-4 line-clamp-2 flex-1 text-base text-neutral-500 dark:text-neutral-400">
                {post.data.description}
              </p>

              {/* Author & Footer */}
              <div class="mt-auto flex items-center justify-between border-t border-neutral-100 pt-4 dark:border-neutral-700">
                <div class="flex items-center gap-2">
                  <div class="flex h-6 w-6 items-center justify-center rounded-full bg-primary-100 text-[10px] font-bold text-primary-700 dark:bg-primary-900/30 dark:text-primary-400">
                    {post.data.author.charAt(0)}
                  </div>
                  <span class="text-xs font-medium text-neutral-600 dark:text-neutral-300">
                    {post.data.author}
                  </span>
                </div>

                <span class="flex items-center gap-1 text-sm font-semibold text-primary-600 group-hover:translate-x-1 transition-transform dark:text-primary-400">
                  Baca
                  <svg
                    class="h-4 w-4"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M14 5l7 7m0 0l-7 7m7-7H3"
                    />
                  </svg>
                </span>
              </div>
            </div>
          </article>
        ))}
      </div>
    )
  }
</section>
