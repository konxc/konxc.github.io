---
import { type CollectionEntry } from "astro:content";
import NewsletterSection from "./NewsletterSection.astro";

export interface Props {
    className?: string;
    categories: string[];
    tags: string[];
}

const { className, categories, tags } = Astro.props;
---

<aside class={`blog-sidebar ${className || ""}`}>
    <div class="sticky top-24 space-y-8">
        {/* Search Box Trigger */}
        <div
            class="rounded-2xl border border-neutral-100 bg-white p-6 shadow-sm dark:border-neutral-700 dark:bg-neutral-800"
        >
            <h3
                class="mb-4 text-lg font-bold text-neutral-800 dark:text-neutral-100"
            >
                Cari Artikel
            </h3>
            <div class="relative">
                <input
                    type="text"
                    placeholder="Ketik kata kunci..."
                    class="focus:border-primary-500 focus:ring-primary-500 w-full rounded-xl border border-neutral-200 bg-neutral-50 px-4 py-3 pl-10 text-sm dark:border-neutral-600 dark:bg-neutral-700 dark:text-neutral-100"
                    onclick="document.getElementById('advanced-search-modal').classList.remove('hidden'); document.getElementById('advanced-search-input').focus();"
                />
                <svg
                    class="absolute top-3.5 left-3 h-4 w-4 text-neutral-400"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
            </div>
        </div>

        {/* Categories */}
        <div
            class="rounded-2xl border border-neutral-100 bg-white p-6 shadow-sm dark:border-neutral-700 dark:bg-neutral-800"
        >
            <h3
                class="mb-4 text-lg font-bold text-neutral-800 dark:text-neutral-100"
            >
                Topik Populer
            </h3>
            <div class="flex flex-wrap gap-2">
                {
                    categories.slice(0, 8).map((category) => (
                        <button
                            class="hover:bg-primary-50 hover:text-primary-600 dark:hover:bg-primary-900/30 dark:hover:text-primary-400 rounded-lg bg-neutral-50 px-3 py-1.5 text-xs font-medium tracking-wide text-neutral-600 uppercase transition-colors dark:bg-neutral-700 dark:text-neutral-300"
                            onclick={`document.getElementById('advanced-search-modal').classList.remove('hidden'); const input = document.getElementById('advanced-search-input'); if(input) { input.value = '${category}'; input.dispatchEvent(new Event('input')); }`}
                        >
                            {category}
                        </button>
                    ))
                }
            </div>
        </div>

        {/* Trending Tags (Cloud) */}
        <div
            class="rounded-2xl border border-neutral-100 bg-white p-6 shadow-sm dark:border-neutral-700 dark:bg-neutral-800"
        >
            <h3
                class="mb-4 text-lg font-bold text-neutral-800 dark:text-neutral-100"
            >
                Trending Tags
            </h3>
            <div class="flex flex-wrap gap-2">
                {
                    tags.slice(0, 10).map((tag) => (
                        <a
                            href={`/blog/tag/${tag}`}
                            class="hover:text-primary-600 text-sm text-neutral-500 transition-colors"
                        >
                            #{tag}
                        </a>
                    ))
                }
            </div>
        </div>

        {/* Newsletter Mini */}
        <div
            class="from-primary-600 to-secondary-600 rounded-2xl bg-gradient-to-br p-6 text-white shadow-lg"
        >
            <h3 class="mb-2 text-lg font-bold">Newsletter Mingguan</h3>
            <p class="text-primary-100 mb-4 text-sm">
                Dapatkan ringkasan artikel terbaik langsung di inbox Anda.
            </p>
            <form
                class="space-y-2"
                onsubmit="event.preventDefault(); alert('Terima kasih telah berlangganan!');"
            >
                <input
                    type="email"
                    placeholder="Email Anda"
                    class="w-full rounded-lg border border-white/30 bg-white/20 px-3 py-2 text-sm text-white placeholder-white/70 focus:border-white focus:bg-white/30 focus:outline-none"
                    required
                />
                <button
                    type="submit"
                    class="text-primary-600 hover:bg-primary-50 w-full rounded-lg bg-white px-3 py-2 text-sm font-bold transition-colors"
                >
                    Subscribe
                </button>
            </form>
        </div>
    </div>
</aside>
