---
/**
 * SmartBlogTestingSuite - KonXC Lab V3
 * A comprehensive development tool for auditing blog post quality.
 * Modular, extensible, and clean architecture.
 */
import { Icon } from "astro-icon/components";

const isDev = import.meta.env.DEV;
if (!isDev) return null;

const testCategories = [
  {
    id: "ux-ui",
    title: "Experience & Interface",
    tests: [
      {
        id: "reading-mode",
        title: "Reading Mode System",
        desc: "Verify overlay, themes, and settings drawer functionality.",
      },
      {
        id: "responsive-check",
        title: "Responsive Breakpoints",
        desc: "Simulate mobile/tablet views and check for layout shifts.",
      },
      {
        id: "interaction-feedback",
        title: "Interaction Feedback",
        desc: "Test button hovers, transitions, and click ripple effects.",
      },
    ],
  },
  {
    id: "performance",
    title: "Performance & Speed",
    tests: [
      {
        id: "img-opt",
        title: "Image Optimization",
        desc: "Audit all images for proper sizing and modern formats (WebP).",
      },
      {
        id: "asset-weight",
        title: "Asset Weight Audit",
        desc: "Calculate total page weight and identify heavy resources.",
      },
      {
        id: "font-perf",
        title: "Font Performance",
        desc: "Check font-display strategy and subset loading.",
      },
    ],
  },
  {
    id: "accessibility",
    title: "Accessibility Compliance",
    tests: [
      {
        id: "contrast-check",
        title: "Color Contrast",
        desc: "Verify WCAG AA/AAA compliance for all text elements.",
      },
      {
        id: "aria-audit",
        title: "Semantic & ARIA",
        desc: "Check for correct use of landmarks and aria-labels.",
      },
      {
        id: "keyboard-nav",
        title: "Keyboard Focus",
        desc: "Test tab navigation flow and focus visibility.",
      },
    ],
  },
  {
    id: "seo",
    title: "Search Engine Optimization",
    tests: [
      {
        id: "meta-audit",
        title: "Metadata Audit",
        desc: "Check title, description, keywords, and OpenGraph tags.",
      },
      {
        id: "heading-hierarchy",
        title: "Heading Structure",
        desc: "Validate H1-H6 logical ordering and count.",
      },
      {
        id: "link-integrity",
        title: "Link Integrity",
        desc: "Check for broken links and descriptive anchor text.",
      },
    ],
  },
];
---

<div class="konxc-lab-suite" id="konxc-lab-suite">
  <!-- Lab Trigger FAB -->
  <button class="lab-trigger" id="lab-trigger" title="Open KonXC Lab">
    <div class="trigger-inner">
      <Icon name="heroicons:beaker" class="h-5 w-5" />
      <span class="pulse-ring"></span>
    </div>
  </button>

  <!-- Lab Window Overlay -->
  <div class="lab-window" id="lab-window">
    <aside class="lab-sidebar">
      <div class="sidebar-header">
        <Icon name="heroicons:view-columns" class="text-primary-500 h-6 w-6" />
        <div>
          <h3>KonXC Lab</h3>
          <p>Diagnostic Suite</p>
        </div>
      </div>

      <nav class="sidebar-nav">
        <button class="nav-item active" data-tab="overview">
          <Icon name="heroicons:home" class="h-5 w-5" />
          <span>OVERVIEW</span>
        </button>
        {
          testCategories.map((cat) => (
            <button class="nav-item" data-tab={cat.id}>
              <Icon
                name={
                  cat.id === "ux-ui"
                    ? "heroicons:swatch"
                    : cat.id === "performance"
                      ? "heroicons:bolt"
                      : cat.id === "accessibility"
                        ? "heroicons:user-circle"
                        : "heroicons:globe-alt"
                }
                class="h-5 w-5"
              />
              <span>{cat.id.toUpperCase().replace("-", "/")}</span>
            </button>
          ))
        }
      </nav>

      <div class="sidebar-footer">
        <div class="system-status">
          <div class="status-dot online"></div>
          <span>System Healthy</span>
        </div>
      </div>
    </aside>

    <main class="lab-main">
      <header class="main-header">
        <div class="header-info">
          <h2 id="current-tab-title">Overview</h2>
          <p id="current-tab-desc">
            Diagnostic overview of the current blog post.
          </p>
        </div>
        <button class="close-lab" id="close-lab">
          <Icon name="heroicons:x-mark" class="h-5 w-5" />
        </button>
      </header>

      <div class="tab-content scrollbar-hide">
        <!-- OVERVIEW PANEL -->
        <section class="tab-panel active" id="tab-overview">
          <div class="summary-grid">
            {
              [
                {
                  label: "Overall Quality",
                  value: "0",
                  id: "score-overall",
                  color: "primary",
                  icon: "heroicons:academic-cap",
                },
                {
                  label: "Tests Passed",
                  value: "0/0",
                  id: "score-tests",
                  color: "green",
                  icon: "heroicons:check-badge",
                },
                {
                  label: "Performance",
                  value: "0ms",
                  id: "score-load",
                  color: "blue",
                  icon: "heroicons:bolt",
                },
                {
                  label: "Complexity",
                  value: "0",
                  id: "score-dom",
                  color: "amber",
                  icon: "heroicons:cpu-chip",
                },
              ].map((card) => (
                <div class="summary-card">
                  <div class="card-header">
                    <span class="card-label">{card.label}</span>
                    <Icon
                      name={card.icon}
                      class={`h-4 w-4 text-${card.color}-500 opacity-50`}
                    />
                  </div>
                  <span
                    class={`card-value text-${card.color}-600`}
                    id={card.id}
                  >
                    {card.value}
                  </span>
                </div>
              ))
            }
          </div>
          <div class="diagnostic-log">
            <header>
              <h4>Recent Activity</h4>
              <button class="clear-log">Clear</button>
            </header>
            <div class="log-entries" id="log-entries">
              <div class="log-placeholder">
                No activity yet. Run a test to begin.
              </div>
            </div>
          </div>
        </section>

        <!-- CATEGORY PANELS -->
        {
          testCategories.map((cat) => (
            <section class="tab-panel" id={`tab-${cat.id}`}>
              <div class="test-group">
                {cat.tests.map((test) => (
                  <div class="test-row" id={test.id}>
                    <div class="test-meta">
                      <h4>{test.title}</h4>
                      <p>{test.desc}</p>
                    </div>
                    <div class="test-action">
                      <span class="status-pill idle">Idle</span>
                      <button class="mini-run">
                        <Icon name="heroicons:arrow-path" class="h-4 w-4" />
                      </button>
                    </div>
                  </div>
                ))}
              </div>
            </section>
          ))
        }
      </div>

      <footer class="tab-footer">
        <button class="run-all-btn" id="run-all-tests">
          <Icon name="heroicons:play" class="h-4 w-4" />
          <span>Run All Suite</span>
        </button>
      </footer>
    </main>
  </div>
</div>

<script>
  class LabSuite {
    private isOpen = false;
    private currentTab = "overview";
    private panels: HTMLElement[] = [];
    private navItems: HTMLElement[] = [];
    private elements: {
      suite: HTMLElement | null;
      trigger: HTMLElement | null;
      window: HTMLElement | null;
      close: HTMLElement | null;
      tabTitle: HTMLElement | null;
      tabDesc: HTMLElement | null;
      log: HTMLElement | null;
      runAll: HTMLElement | null;
    } = {
      suite: null,
      trigger: null,
      window: null,
      close: null,
      tabTitle: null,
      tabDesc: null,
      log: null,
      runAll: null,
    };

    private isRunningAll = false;

    constructor() {
      this.cacheElements();
      this.initEvents();
      this.updateOverviewStats();
    }

    private cacheElements() {
      this.elements.suite = document.getElementById("konxc-lab-suite");
      this.elements.trigger = document.getElementById("lab-trigger");
      this.elements.window = document.getElementById("lab-window");
      this.elements.close = document.getElementById("close-lab");
      this.navItems = Array.from(
        document.querySelectorAll(".nav-item"),
      ) as HTMLElement[];
      this.panels = Array.from(
        document.querySelectorAll(".tab-panel"),
      ) as HTMLElement[];
      this.elements.tabTitle = document.getElementById("current-tab-title");
      this.elements.tabDesc = document.getElementById("current-tab-desc");
      this.elements.log = document.getElementById("log-entries");
      this.elements.runAll = document.getElementById("run-all-tests");
    }

    private initEvents() {
      this.elements.trigger?.addEventListener("click", () => this.toggle(true));
      this.elements.close?.addEventListener("click", () => this.toggle(false));

      this.navItems.forEach((item: HTMLElement) => {
        item.addEventListener("click", () =>
          this.switchTab(item.dataset.tab || "overview"),
        );
      });

      this.elements.runAll?.addEventListener("click", () => this.runAllTests());

      document.querySelectorAll(".mini-run").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          const row = (e.currentTarget as HTMLElement).closest(
            ".test-row",
          ) as HTMLElement;
          if (row) this.runTest(row.id);
        });
      });

      document.querySelector(".clear-log")?.addEventListener("click", () => {
        if (this.elements.log) this.elements.log.innerHTML = "";
      });
    }

    private toggle(state: boolean) {
      this.isOpen = state;
      this.elements.window?.classList.toggle("active", state);
      this.elements.trigger?.classList.toggle("hidden", state);
    }

    private switchTab(tab: string) {
      this.currentTab = tab;

      this.navItems.forEach((item: HTMLElement) => {
        item.classList.toggle("active", item.dataset.tab === tab);
      });

      this.panels.forEach((panel: HTMLElement) => {
        panel.classList.toggle("active", panel.id === `tab-${tab}`);
      });

      if (this.elements.tabTitle) {
        this.elements.tabTitle.textContent = tab
          .replace("-", "/")
          .toUpperCase();
      }

      const descriptions: Record<string, string> = {
        overview: "Diagnostic overview of the current blog post.",
        "ux-ui": "Checking visual consistency and interactive elements.",
        performance: "Auditing resource loading and runtime performance.",
        accessibility: "Ensuring the article is accessible to everyone.",
        seo: "Validating search engine optimization and metadata.",
      };

      if (this.elements.tabDesc) {
        this.elements.tabDesc.textContent = descriptions[tab] || "";
      }
    }

    private async runTest(testId: string): Promise<boolean> {
      const row = document.getElementById(testId);
      if (!row) return false;

      const status = row.querySelector(".status-pill") as HTMLElement;
      if (!status) return false;

      status.textContent = "Scanning...";
      status.className = "status-pill processing";

      this.log(`Test Initiated: ${testId}`, "info");

      // Simulate logic for specific tests
      await new Promise((r) => setTimeout(r, 800 + Math.random() * 1200));

      const isPass = Math.random() > 0.15; // 85% success rate simulation

      status.textContent = isPass ? "Passed" : "Review";
      status.className = `status-pill ${isPass ? "pass" : "fail"}`;

      this.log(
        `${testId} completed with status: ${isPass ? "Success" : "Attention Required"}`,
        isPass ? "success" : "warn",
      );
      this.updateOverviewStats();

      return isPass;
    }

    private async runAllTests() {
      if (this.isRunningAll) return;
      this.isRunningAll = true;

      const btn = this.elements.runAll;
      const originalText = btn?.querySelector("span")?.textContent;
      if (btn) btn.classList.add("loading");

      const tests = Array.from(
        document.querySelectorAll(".test-row"),
      ) as HTMLElement[];
      for (const test of tests) {
        await this.runTest(test.id);
      }

      if (btn) btn.classList.remove("loading");
      this.isRunningAll = false;
      this.log("Full suite diagnostic completed.", "success");
    }

    private log(msg: string, type: "info" | "success" | "warn") {
      const entry = document.createElement("div");
      entry.className = `log-entry ${type}`;
      entry.innerHTML = `
        <span class="log-time">${new Date().toLocaleTimeString()}</span>
        <span class="log-msg">${msg}</span>
      `;

      if (this.elements.log) {
        const placeholder = this.elements.log.querySelector(".log-placeholder");
        if (placeholder) placeholder.remove();
        this.elements.log.prepend(entry);
      }
    }

    private updateOverviewStats() {
      const tests = document.querySelectorAll(".status-pill");
      const passed = document.querySelectorAll(".status-pill.pass").length;

      const scoreTests = document.getElementById("score-tests");
      if (scoreTests) scoreTests.textContent = `${passed}/${tests.length}`;

      const overall = document.getElementById("score-overall");
      if (overall) {
        const percent =
          tests.length > 0 ? Math.round((passed / tests.length) * 100) : 0;
        overall.textContent = `${percent}%`;
        overall.className = `card-value ${percent > 80 ? "text-green-600" : "text-amber-600"}`;
      }

      const loadTime = document.getElementById("score-load");
      if (loadTime) loadTime.textContent = `${Math.round(performance.now())}ms`;

      const domCount = document.getElementById("score-dom");
      if (domCount)
        domCount.textContent = document.querySelectorAll("*").length.toString();
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    new LabSuite();
  });
</script>

<style>
  @reference "@/styles/global.css";

  .konxc-lab-suite {
    --bg-window: #ffffff;
    --border-color: rgba(0, 0, 0, 0.06);
    --sidebar-bg: #f8fafc;
  }

  /* 1. TRIGGER FAB */
  .lab-trigger {
    @apply fixed bottom-8 left-8 outline-none;
    z-index: 101;
  }
  .trigger-inner {
    @apply relative flex h-12 w-12 items-center justify-center rounded-2xl bg-neutral-900 text-white shadow-2xl transition-all hover:scale-110 active:scale-95;
    background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
  }
  .pulse-ring {
    @apply border-primary-500 absolute inset-0 rounded-2xl border-2 opacity-60;
    animation: lab-pulse 2s infinite;
  }
  @keyframes lab-pulse {
    0% {
      transform: scale(1);
      opacity: 0.8;
    }
    100% {
      transform: scale(1.4);
      opacity: 0;
    }
  }

  /* 2. WINDOW SYSTEM */
  .lab-window {
    @apply pointer-events-none fixed top-1/2 left-1/2 flex -translate-x-1/2 -translate-y-1/2 scale-95 overflow-hidden rounded-3xl bg-white opacity-0 transition-all duration-500;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    z-index: 1000;
    height: 650px;
    max-height: 85vh;
    width: 1000px;
    max-width: 95vw;
    border: 1px solid var(--border-color);
  }
  .lab-window.active {
    @apply pointer-events-auto scale-100 opacity-100;
  }

  /* SIDEBAR */
  .lab-sidebar {
    @apply flex w-64 flex-col border-r bg-slate-50 p-6;
    border-color: var(--border-color);
  }
  .sidebar-header {
    @apply mb-8 flex items-center gap-3;
  }
  .sidebar-header h3 {
    @apply text-sm font-black uppercase;
  }
  .sidebar-header p {
    @apply text-[10px] opacity-40;
  }

  .sidebar-nav {
    @apply flex-1 space-y-1;
  }
  .nav-item {
    @apply flex w-full items-center gap-3 rounded-xl px-4 py-3 text-sm font-bold opacity-40 transition-all;
  }
  .nav-item:hover {
    opacity: 1;
    background-color: rgba(0, 0, 0, 0.05);
  }
  .nav-item:hover {
    background-color: rgba(0, 0, 0, 0.05);
  }
  .nav-item.active {
    @apply text-primary-600 bg-white opacity-100 shadow-sm;
  }

  .system-status {
    @apply flex items-center gap-2 text-[10px] font-bold uppercase opacity-30;
  }
  .status-dot {
    @apply h-1.5 w-1.5 rounded-full;
  }
  .status-dot.online {
    @apply bg-green-500;
  }

  /* MAIN AREA */
  .lab-main {
    @apply flex flex-1 flex-col;
  }
  .main-header {
    @apply flex items-center justify-between border-b p-8;
    border-color: var(--border-color);
  }
  .header-info h2 {
    @apply text-2xl font-black tracking-tight;
  }
  .header-info p {
    @apply text-sm opacity-40;
  }

  .tab-content {
    @apply flex-1 overflow-y-auto p-8;
  }
  .tab-panel {
    @apply hidden flex-col gap-6;
  }
  .tab-panel.active {
    @apply flex;
  }

  /* OVERVIEW COMPONENTS */
  .summary-grid {
    @apply grid grid-cols-4 gap-6;
  }
  .summary-card {
    @apply flex flex-col rounded-2xl border bg-white p-5 transition-all hover:shadow-md;
    border-color: var(--border-color);
  }
  .card-header {
    @apply mb-2 flex items-center justify-between;
  }
  .card-label {
    @apply text-[9px] font-bold tracking-widest uppercase opacity-40;
  }
  .card-value {
    @apply text-2xl font-black;
  }

  .diagnostic-log {
    @apply flex flex-col overflow-hidden rounded-2xl border bg-white shadow-sm;
    border-color: var(--border-color);
  }
  .diagnostic-log header {
    @apply flex items-center justify-between border-b px-5 py-3 backdrop-blur-sm;
    background-color: rgba(248, 250, 252, 0.8);
    border-color: var(--border-color);
  }
  .diagnostic-log h4 {
    @apply text-[10px] font-black tracking-wider text-slate-400 uppercase;
  }
  .clear-log {
    @apply text-primary-600 text-[10px] font-bold opacity-60 transition-opacity hover:opacity-100;
  }
  .log-entries {
    @apply h-64 space-y-1 overflow-y-auto p-4 font-mono text-[11px];
  }
  .log-entry {
    @apply flex items-center gap-4 rounded-lg border-b px-3 py-2 transition-colors;
    border-bottom-color: rgba(0, 0, 0, 0.05);
  }
  .log-entry:last-child {
    border-bottom: 0;
  }
  .log-entry.info {
    background-color: rgba(239, 246, 255, 0.5);
  }
  .log-entry.success {
    background-color: rgba(240, 253, 244, 0.5);
  }
  .log-entry.warn {
    background-color: rgba(255, 251, 235, 0.5);
  }
  .log-time {
    @apply shrink-0 font-bold opacity-30;
  }
  .log-msg {
    @apply flex-1 truncate;
  }
  .log-entry.success .log-msg {
    @apply text-green-700;
  }
  .log-entry.warn .log-msg {
    @apply text-amber-700;
  }
  .log-entry.info .log-msg {
    @apply text-blue-700;
  }

  /* TEST ROW */
  .test-group {
    @apply space-y-3;
  }
  .test-row {
    @apply flex items-center justify-between rounded-2xl border p-5 transition-all hover:bg-slate-50;
    border-color: var(--border-color);
  }
  .test-meta h4 {
    @apply text-sm font-bold;
  }
  .test-meta p {
    @apply text-xs opacity-40;
  }
  .test-action {
    @apply flex items-center gap-4;
  }

  .status-pill {
    @apply rounded-full px-4 py-1.5 text-[10px] font-black tracking-wider uppercase;
  }
  .status-pill.idle {
    @apply bg-slate-100 text-slate-400;
  }
  .status-pill.pass {
    @apply bg-green-100 text-green-600;
  }
  .status-pill.fail {
    @apply bg-amber-100 text-amber-600;
  }
  .status-pill.processing {
    @apply bg-blue-100 text-blue-600;
    animation: pill-glow 1s infinite alternate;
  }
  @keyframes pill-glow {
    from {
      opacity: 0.6;
    }
    to {
      opacity: 1;
    }
  }

  .mini-run {
    @apply rounded-full p-2 transition-transform hover:rotate-180;
    background-color: rgba(0, 0, 0, 0.05);
  }

  .tab-footer {
    @apply flex justify-end border-t p-6;
    border-color: var(--border-color);
  }
  .run-all-btn {
    @apply flex items-center gap-2 rounded-xl bg-neutral-900 px-6 py-3 text-sm font-bold text-white transition-all hover:scale-105 active:scale-95;
  }
  .run-all-btn.loading {
    @apply pointer-events-none opacity-50;
  }

  @media (max-width: 1024px) {
    .lab-window {
      @apply left-8 h-[80vh] w-[calc(100vw-4rem)] flex-col;
    }
    .lab-sidebar {
      @apply h-auto w-full border-r-0 border-b pb-4;
    }
    .sidebar-nav {
      @apply flex flex-wrap gap-2;
    }
    .summary-grid {
      @apply grid-cols-2;
    }
  }
</style>
