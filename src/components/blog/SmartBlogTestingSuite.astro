---
// Smart Blog Testing Suite - Premium Development & QA Overhaul
import { Icon } from "astro-icon/components";
---

<div class="blog-suite-wrapper" id="blog-suite-wrapper">
  <!-- Trigger FAB -->
  <button
    id="suite-trigger"
    class="suite-fab group"
    aria-label="Toggle Blog Test Suite"
  >
    <div class="fab-blob">
      <Icon
        name="heroicons:beaker"
        class="h-6 w-6 transition-transform group-hover:rotate-12"
      />
    </div>
    <span class="fab-label">Lab Suite</span>
  </button>

  <!-- Main Suite Interface -->
  <div class="suite-overlay" id="suite-overlay">
    <div class="suite-window">
      <!-- Sidebar Navigation -->
      <aside class="suite-sidebar">
        <div class="sidebar-brand">
          <Icon name="heroicons:bolt" class="text-primary-600 h-8 w-8" />
          <div class="brand-text">
            <h2>KonXC Lab</h2>
            <span>v2.4.0 Stable</span>
          </div>
        </div>

        <nav class="suite-nav">
          <button class="nav-item active" data-tab="overview">
            <Icon name="heroicons:squares-2x2" class="h-5 w-5" />
            <span>Overview</span>
          </button>
          <button class="nav-item" data-tab="ux-ui">
            <Icon name="heroicons:paint-brush" class="h-5 w-5" />
            <span>UX & UI Health</span>
          </button>
          <button class="nav-item" data-tab="performance">
            <Icon name="heroicons:cpu-chip" class="h-5 w-5" />
            <span>Performance</span>
          </button>
          <button class="nav-item" data-tab="accessibility">
            <Icon name="heroicons:user-circle" class="h-5 w-5" />
            <span>Accessibility</span>
          </button>
          <button class="nav-item" data-tab="seo">
            <Icon name="heroicons:globe-alt" class="h-5 w-5" />
            <span>SEO & Meta</span>
          </button>
        </nav>

        <div class="sidebar-footer">
          <button id="run-automated" class="run-btn">
            <Icon name="heroicons:play" class="h-4 w-4" />
            <span>Run Diagnostics</span>
          </button>
        </div>
      </aside>

      <!-- Content Area -->
      <main class="suite-main">
        <header class="suite-header">
          <div class="header-info">
            <h1 id="tab-title">Diagnostics Overview</h1>
            <p id="tab-desc">
              Pantau kesehatan komponen blog dan fungsionalitas interaktif
              secara sistematis.
            </p>
          </div>
          <button id="close-suite" class="close-puck">
            <Icon name="heroicons:x-mark" class="h-5 w-5" />
          </button>
        </header>

        <!-- Dynamic Panels -->
        <div class="panels-container scrollbar-hide">
          <!-- Overview Panel -->
          <section class="suite-panel active" id="panel-overview">
            <div class="summary-grid">
              <div class="stat-card">
                <label>Overall Health</label>
                <div class="stat-value" id="overall-health">--%</div>
                <div class="stat-trend positive">Stable</div>
              </div>
              <div class="stat-card">
                <label>Tests Run</label>
                <div class="stat-value" id="total-runs">0</div>
                <div class="stat-trend" id="last-run">No records</div>
              </div>
              <div class="stat-card">
                <label>Passed</label>
                <div class="stat-value text-green-600" id="total-passed">0</div>
              </div>
              <div class="stat-card">
                <label>Failed</label>
                <div class="stat-value text-red-600" id="total-failed">0</div>
              </div>
            </div>

            <div class="diagnostic-list" id="global-log">
              <!-- Logs will be prepended here dynamically -->
            </div>
          </section>

          <!-- UX & UI Panel -->
          <section class="suite-panel" id="panel-ux-ui">
            <div class="test-group">
              <div class="test-row" data-test="reading-mode">
                <div class="test-meta">
                  <h4>Reading Mode System</h4>
                  <p>
                    Verifikasi keberadaan overlay, tema, dan laci pengaturan.
                  </p>
                </div>
                <div class="test-action">
                  <span class="status-pill idle">Idle</span>
                  <button class="mini-run"
                    ><Icon
                      name="heroicons:arrow-path"
                      class="h-4 w-4"
                    /></button
                  >
                </div>
              </div>
              <div class="test-row" data-test="focus-mask">
                <div class="test-meta">
                  <h4>Focus Mask Feature</h4>
                  <p>Deteksi elemen dimmer dan jendela fokus mata.</p>
                </div>
                <div class="test-action">
                  <span class="status-pill idle">Idle</span>
                  <button class="mini-run"
                    ><Icon
                      name="heroicons:arrow-path"
                      class="h-4 w-4"
                    /></button
                  >
                </div>
              </div>
              <div class="test-row" data-test="typography-engine">
                <div class="test-meta">
                  <h4>Typography Engine</h4>
                  <p>Validasi slider ukuran teks dan ganti jenis huruf.</p>
                </div>
                <div class="test-action">
                  <span class="status-pill idle">Idle</span>
                  <button class="mini-run"
                    ><Icon
                      name="heroicons:arrow-path"
                      class="h-4 w-4"
                    /></button
                  >
                </div>
              </div>
              <div class="test-row" data-test="toc-integrity">
                <div class="test-meta">
                  <h4>TOC Integrity</h4>
                  <p>Validasi heading extraction dan link hashtag.</p>
                </div>
                <div class="test-action">
                  <span class="status-pill idle">Idle</span>
                  <button class="mini-run"
                    ><Icon
                      name="heroicons:arrow-path"
                      class="h-4 w-4"
                    /></button
                  >
                </div>
              </div>
              <div class="test-row" data-test="social-share">
                <div class="test-meta">
                  <h4>Social Connectivity</h4>
                  <p>
                    Pemeriksaan URL share dan fungsionalitas copy-to-clipboard.
                  </p>
                </div>
                <div class="test-action">
                  <span class="status-pill idle">Idle</span>
                  <button class="mini-run"
                    ><Icon
                      name="heroicons:arrow-path"
                      class="h-4 w-4"
                    /></button
                  >
                </div>
              </div>
            </div>
          </section>

          <!-- Performance Panel -->
          <section class="suite-panel" id="panel-performance">
            <div class="test-group">
              <div class="test-row" data-test="img-optimization">
                <div class="test-meta">
                  <h4>Asset Optimization</h4>
                  <p>Deteksi format WebP dan Lazy Loading pada gambar.</p>
                </div>
                <div class="test-action">
                  <span class="status-pill idle">Idle</span>
                  <button class="mini-run"
                    ><Icon
                      name="heroicons:arrow-path"
                      class="h-4 w-4"
                    /></button
                  >
                </div>
              </div>
              <div class="test-row" data-test="js-payload">
                <div class="test-meta">
                  <h4>Interactive Load</h4>
                  <p>
                    Pemeriksaan script hydration dan custom elements payload.
                  </p>
                </div>
                <div class="test-action">
                  <span class="status-pill idle">Idle</span>
                  <button class="mini-run"
                    ><Icon
                      name="heroicons:arrow-path"
                      class="h-4 w-4"
                    /></button
                  >
                </div>
              </div>
              <div class="test-row" data-test="dark-mode-system">
                <div class="test-meta">
                  <h4>Dark Mode Core</h4>
                  <p>
                    Verifikasi toggle mode gelap sistem dan class persistence.
                  </p>
                </div>
                <div class="test-action">
                  <span class="status-pill idle">Idle</span>
                  <button class="mini-run"
                    ><Icon
                      name="heroicons:arrow-path"
                      class="h-4 w-4"
                    /></button
                  >
                </div>
              </div>
            </div>
          </section>

          <!-- Accessibility Panel -->
          <section class="suite-panel" id="panel-accessibility">
            <div class="test-group">
              <div class="test-row" data-test="asset-alt-text">
                <div class="test-meta">
                  <h4>Alt Text Validation</h4>
                  <p>Semua gambar harus memiliki deskripsi alt.</p>
                </div>
                <div class="test-action">
                  <span class="status-pill idle">Idle</span>
                  <button class="mini-run"
                    ><Icon
                      name="heroicons:arrow-path"
                      class="h-4 w-4"
                    /></button
                  >
                </div>
              </div>
              <div class="test-row" data-test="accessibility-landmarks">
                <div class="test-meta">
                  <h4>ARIA Landmarks</h4>
                  <p>Struktur halaman menggunakan peran ARIA yang tepat.</p>
                </div>
                <div class="test-action">
                  <span class="status-pill idle">Idle</span>
                  <button class="mini-run"
                    ><Icon
                      name="heroicons:arrow-path"
                      class="h-4 w-4"
                    /></button
                  >
                </div>
              </div>
            </div>
          </section>

          <!-- SEO Panel -->
          <section class="suite-panel" id="panel-seo">
            <div class="test-group">
              <div class="test-row" data-test="meta-integrity">
                <div class="test-meta">
                  <h4>Metadata Check</h4>
                  <p>Validasi Title, Description, dan OG Tags.</p>
                </div>
                <div class="test-action">
                  <span class="status-pill idle">Idle</span>
                  <button class="mini-run"
                    ><Icon
                      name="heroicons:arrow-path"
                      class="h-4 w-4"
                    /></button
                  >
                </div>
              </div>
              <div class="test-row" data-test="semantic-structure">
                <div class="test-meta">
                  <h4>Semantic HTML</h4>
                  <p>Cek penggunaan tag article, main, dan h1 tunggal.</p>
                </div>
                <div class="test-action">
                  <span class="status-pill idle">Idle</span>
                  <button class="mini-run"
                    ><Icon
                      name="heroicons:arrow-path"
                      class="h-4 w-4"
                    /></button
                  >
                </div>
              </div>
            </div>
          </section>
        </div>
      </main>
    </div>
  </div>
</div>

<script>
  class BlogLabSuite {
    private isActive = false;
    private logData: { passed: number; failed: number } = {
      passed: 0,
      failed: 0,
    };

    constructor() {
      this.initUI();
    }

    private initUI() {
      const trigger = document.getElementById("suite-trigger");
      const overlay = document.getElementById("suite-overlay");
      const closer = document.getElementById("close-suite");

      trigger?.addEventListener("click", () => this.toggle(true));
      closer?.addEventListener("click", () => this.toggle(false));

      // Tab Switching
      const navItems = document.querySelectorAll(".nav-item");
      navItems.forEach((item) => {
        item.addEventListener("click", (e) => {
          const target = (e.currentTarget as HTMLElement).dataset.tab;
          this.switchTab(target || "overview");
        });
      });

      // Run Controls
      document
        .getElementById("run-automated")
        ?.addEventListener("click", () => this.runFullDiagnostics());

      // Individual runs
      document.querySelectorAll(".mini-run").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          const testKey = (e.currentTarget as HTMLElement)
            .closest(".test-row")
            ?.getAttribute("data-test");
          if (testKey) this.runOne(testKey);
        });
      });
    }

    private toggle(state: boolean) {
      const overlay = document.getElementById("suite-overlay");
      overlay?.classList.toggle("active", state);
      this.isActive = state;

      if (state && this.logData.passed === 0 && this.logData.failed === 0) {
        this.runBootSequence();
      }
    }

    private async runBootSequence() {
      const bootMsgs = [
        "Initializing KonXC Lab Core...",
        "Loading diagnostic modules [UX, PERF, SEO]...",
        "Handshaking with DOM articles...",
        "System Ready. Welcome, Engineer."
      ];

      for (const msg of bootMsgs) {
        this.log(msg, "info");
        await new Promise(r => setTimeout(r, 150));
      }
    }

    private switchTab(tabId: string) {
      // Nav Update
      document.querySelectorAll(".nav-item").forEach((btn) => {
        btn.classList.toggle(
          "active",
          (btn as HTMLElement).dataset.tab === tabId,
        );
      });

      // Panel Update
      document.querySelectorAll(".suite-panel").forEach((panel) => {
        panel.classList.toggle("active", panel.id === `panel-${tabId}`);
      });

      // Header Update
      const titles: any = {
        overview: [
          "Diagnostics Overview",
          "Pantau kesehatan komponen blog secara sistematis.",
        ],
        "ux-ui": [
          "UX & UI Integrity",
          "Verifikasi elemen interaktif dan visual blog.",
        ],
        performance: [
          "Performance Audit",
          "Analisis optimalisasi aset dan payload JS.",
        ],
        accessibility: [
          "Accessibility Audit",
          "Pastikan konten Anda inklusif dan dapat diakses semua orang.",
        ],
        seo: [
          "SEO & Meta Validation",
          "Validasi tag meta dan struktur data untuk search engine.",
        ],
      };

      const titleEl = document.getElementById("tab-title");
      const descEl = document.getElementById("tab-desc");
      if (titleEl && titles[tabId]) titleEl.textContent = titles[tabId][0];
      if (descEl && titles[tabId]) descEl.textContent = titles[tabId][1];
    }

    private async runFullDiagnostics() {
      this.log("Memulai diagnosa sistem lengkap...", "info");
      this.logData = { passed: 0, failed: 0 };

      const tests = [
        "reading-mode",
        "focus-mask",
        "typography-engine",
        "toc-integrity",
        "social-share",
        "img-optimization",
        "dark-mode-system",
        "asset-alt-text", // New test
        "accessibility-landmarks", // New test
        "meta-integrity",
        "semantic-structure",
      ];

      for (const test of tests) {
        await this.runOne(test);
        await new Promise((r) => setTimeout(r, 400));
      }

      this.updateGlobalSummary();
      this.log("Diagnosa selesai.", "success");
    }

    private async runOne(key: string) {
      const row = document.querySelector(`[data-test="${key}"]`);
      const pill = row?.querySelector(".status-pill");
      if (pill) {
        pill.className = "status-pill processing";
        pill.textContent = "Running";
      }

      let result = false;
      let message = "";

      // Logic Router
      switch (key) {
        case "reading-mode":
          result = !!document.querySelector(".reading-mode-system");
          message = result
            ? "System terdeteksi."
            : "System tidak ditemukan dalam DOM.";
          break;
        case "focus-mask":
          result = !!document.getElementById("focus-mask");
          message = result
            ? "Elemen mask terdeteksi."
            : "Mask tidak ditemukan.";
          break;
        case "typography-engine":
          const slider = document.getElementById("font-size-slider");
          const fontBtns = document.querySelectorAll(".font-btn");
          result = !!slider && fontBtns.length > 0;
          message = result
            ? "Kontrol tipografi aktif."
            : "Slider atau tombol font hilang.";
          break;
        case "toc-integrity":
          const links = document.querySelectorAll(".toc-link");
          result = links.length > 0;
          message = result
            ? `${links.length} anchor terdeteksi.`
            : "TOC link tidak ditemukan.";
          break;
        case "social-share":
          result = !!document.querySelector(".social-share");
          message = "Container share divalidasi.";
          break;
        case "img-optimization":
          const imgs = document.querySelectorAll("img");
          const nonWebp = Array.from(imgs).filter(
            (i) =>
              i.src &&
              !i.src.includes(".webp") &&
              !i.src.includes(".svg") &&
              !i.src.includes("data:image"),
          );
          result = nonWebp.length === 0;
          message = result
            ? "Semua gambar teroptimalisasi."
            : `${nonWebp.length} gambar bukan WebP.`;
          break;
        case "js-payload":
          // Placeholder for actual JS payload check
          result = true; // Assume pass for now
          message = "Pemeriksaan payload JS dasar selesai.";
          break;
        case "dark-mode-system":
          result = !!document.querySelector(".dark-mode-toggle");
          message = result ? "Toggle mode gelap tersedia." : "Toggle missing.";
          break;
        case "asset-alt-text":
          const allImgs = Array.from(document.querySelectorAll("img"));
          const missingAlt = allImgs.filter(img => !img.alt || img.alt.trim() === "");
          result = missingAlt.length === 0;
          message = result
            ? "Semua gambar memiliki deskripsi alt."
            : `${missingAlt.length} gambar tidak punya alt text.`;
          break;
        case "accessibility-landmarks":
          const mainLandmark = document.querySelector("main");
          const navLandmark = document.querySelector("nav"); // Basic check, could be more robust
          result = !!mainLandmark && !!navLandmark;
          message = result
            ? "Struktur landmark ARIA dasar valid."
            : "Tag <main> atau <nav> sebagai landmark tidak ditemukan.";
          break;
        case "meta-integrity":
          const title = !!document.title;
          const desc = !!document.querySelector('meta[name="description"]');
          result = title && desc;
          message = result
            ? "SEO Meta dasar lengkap."
            : "Meta Title atau Description hilang.";
          break;
        case "semantic-structure":
          const article = !!document.querySelector("article");
          const main = !!document.querySelector("main");
          const h1Count = document.querySelectorAll("h1").length;
          result = article && main && h1Count === 1;
          message = result
            ? "Struktur semantik valid."
            : `Issue: Article(${article}), Main(${main}), H1(${h1Count})`;
          break;
      }

      if (pill) {
        pill.className = `status-pill ${result ? "pass" : "fail"}`;
        pill.textContent = result ? "Passed" : "Failed";
      }

      this.log(`${key}: ${message}`, result ? "success" : "error");

      if (result) this.logData.passed++;
      else this.logData.failed++;

      this.updateGlobalSummary();
    }

    private log(msg: string, type: "info" | "success" | "error") {
      const logger = document.getElementById("global-log");
      if (!logger) return;

      const div = document.createElement("div");
      div.className = `log-entry ${type}`;
      div.innerHTML = `<span>${new Date().toLocaleTimeString()}</span> &nbsp; ${msg}`;
      logger.prepend(div);
    }

    private updateGlobalSummary() {
      const total = this.logData.passed + this.logData.failed;
      const targetRate = total > 0 ? Math.round((this.logData.passed / total) * 100) : 0;
      
      const hEl = document.getElementById("overall-health");
      const pEl = document.getElementById("total-passed");
      const fEl = document.getElementById("total-failed");
      const tEl = document.getElementById("total-runs");

      if (hEl) this.animateCounter(hEl, targetRate, "%");
      if (pEl) this.animateCounter(pEl, this.logData.passed);
      if (fEl) this.animateCounter(fEl, this.logData.failed);
      if (tEl) {
          this.animateCounter(tEl, total);
          const trendEl = tEl.nextElementSibling as HTMLElement;
          if (trendEl && total > 0) trendEl.textContent = "Records found";
      }
    }

    private animateCounter(el: HTMLElement, end: number, suffix: string = "") {
        const currentText = el.textContent || "0";
        // Strip everything except numbers to get a clean start point
        const start = parseInt(currentText.replace(/[^0-9]/g, "")) || 0;
        const range = end - start;
        const duration = 800;
        let startTimestamp: number | null = null;
        
        const step = (timestamp: number) => {
            if (!startTimestamp) startTimestamp = timestamp;
            const progress = Math.min((timestamp - startTimestamp) / duration, 1);
            const val = Math.floor(progress * range + start);
            el.textContent = `${val}${suffix}`;
            if (progress < 1) {
                window.requestAnimationFrame(step);
            }
        };
        window.requestAnimationFrame(step);
    }
  }

  // Auto Init only in DEV/PREVIEW
  if (import.meta.env.DEV || window.location.hostname === "localhost") {
    document.addEventListener("DOMContentLoaded", () => {
      new BlogLabSuite();
    });
  } else {
    document.getElementById("blog-suite-wrapper")?.remove();
  }
</script>

<style>
  @reference "@/styles/global.css";

  .blog-suite-wrapper {
    --accent: oklch(0.627 0.265 303.9);
  }

  /* FAB Styles - Unified with Reading Mode */
  .suite-fab {
    @apply fixed right-8 bottom-22 z-40 flex items-center gap-3 rounded-full bg-neutral-900/90 p-2 pr-6 text-white shadow-2xl backdrop-blur-md transition-all duration-300 hover:scale-105 active:scale-95;
    box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.1);
    animation: fab-breathe 4s ease-in-out infinite;
  }

  @keyframes fab-breathe {
      0%, 100% { box-shadow: 0 10px 30px -5px rgba(0,0,0,0.4); }
      50% { box-shadow: 0 10px 40px 5px rgba(255, 255, 255, 0.2); }
  }

  .fab-blob {
    @apply flex h-8 w-8 items-center justify-center rounded-full shadow-inner text-slate-700;
    background: linear-gradient(135deg, #f8fafc 0%, #cbd5e1 100%);
    border: 1px solid rgba(255,255,255,0.8);
  }

  .fab-label {
    @apply text-[11px] font-bold tracking-wider uppercase opacity-90;
  }

  /* Overlay */
  .suite-overlay {
    @apply pointer-events-none fixed inset-0 z-100 flex items-center justify-center p-4 opacity-0 transition-all duration-500;
  }
  .suite-overlay.active {
    @apply pointer-events-auto opacity-100;
    backdrop-filter: blur(10px) brightness(0.8);
  }

  /* Window - Spring Entry */
  .suite-window {
    @apply flex h-full max-h-[85vh] w-full max-w-6xl scale-95 overflow-hidden rounded-[2rem] bg-neutral-50 shadow-[0_50px_100px_-20px_rgba(0,0,0,0.5)] transition-all duration-500;
    transition-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1);
    border: 1px solid rgba(255, 255, 255, 0.5);
  }
  .suite-overlay.active .suite-window {
    @apply scale-100;
  }

  /* Sidebar */
  .suite-sidebar {
    @apply flex w-72 flex-col border-r border-black/5 bg-white p-8;
  }

  .sidebar-brand {
    @apply mb-12 flex items-center gap-4;
  }
  .brand-text h2 {
    @apply text-lg font-black tracking-tight;
  }
  .brand-text span {
    @apply text-[10px] font-bold tracking-widest uppercase opacity-40;
  }

  .suite-nav {
    @apply flex flex-1 flex-col gap-2;
  }
  .nav-item {
    @apply flex items-center gap-4 rounded-xl p-4 text-sm font-bold transition-all hover:bg-black/5;
  }
  .nav-item.active {
    @apply bg-primary-50 text-primary-600;
  }

  .run-btn {
    @apply bg-primary-600 flex w-full items-center justify-center gap-2 rounded-2xl py-4 text-sm font-black text-white transition-all hover:brightness-110 active:scale-95;
  }

  /* Main Area */
  .suite-main {
    @apply flex flex-1 flex-col overflow-hidden;
  }

  .suite-header {
    @apply flex items-center justify-between border-b border-black/5 bg-white p-8;
  }
  .header-info h1 {
    @apply text-2xl font-black tracking-tight;
  }
  .header-info p {
    @apply text-sm opacity-50;
  }

  .close-puck {
    @apply rounded-full bg-black/5 p-2 transition-all hover:bg-black/10;
  }

  /* Panels */
  .panels-container {
    @apply flex-1 overflow-y-auto p-8;
  }
  .suite-panel {
    @apply hidden flex-col gap-6;
  }
  .suite-panel.active {
    @apply flex;
    animation: suite-fade-in 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes suite-fade-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Summary Grid */
  .summary-grid {
