---
// Reading Mode Component - Premium Immersive Overhaul V2
import { Icon } from "astro-icon/components";

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class={`reading-mode-system ${className || ""}`}>
  <!-- Reading Mode Toggle Button - Floating Action Button Style -->
  <button
    class="reading-mode-fab group"
    id="reading-mode-toggle"
    aria-label="Toggle Reading Mode"
  >
    <div class="fab-icon-container">
      <Icon
        name="heroicons:book-open"
        class="h-6 w-6 transition-transform group-hover:scale-110"
      />
    </div>
    <span class="fab-text">Mode Baca</span>
  </button>

  <!-- Immersive Reading Overlay -->
  <div
    class="reading-immersive-overlay"
    id="reading-mode-overlay"
    data-theme="default"
  >
    <!-- Top Progress Bar -->
    <div class="reading-progress-track">
      <div class="reading-progress-bar" id="reading-progress-fill"></div>
    </div>

    <!-- Interface Shell -->
    <div class="reading-shell">
      <!-- Universal Header -->
      <header class="reading-navbar">
        <div class="navbar-left">
          <button
            class="navbar-btn"
            id="close-reading-mode"
            aria-label="Exit Reading Mode"
          >
            <Icon name="heroicons:x-mark" class="h-6 w-6" />
            <span class="hidden sm:inline">Keluar</span>
          </button>
        </div>

        <div class="navbar-center">
          <div class="theme-selector">
            <button
              class="theme-dot default active"
              data-theme="default"
              title="Default"></button>
            <button class="theme-dot sepia" data-theme="sepia" title="Sepia"
            ></button>
            <button class="theme-dot cream" data-theme="cream" title="Cream"
            ></button>
            <button class="theme-dot slate" data-theme="slate" title="Slate"
            ></button>
            <button class="theme-dot night" data-theme="night" title="Night"
            ></button>
          </div>
        </div>

        <div class="navbar-right">
          <button
            class="navbar-btn ai-btn group/ai"
            id="ai-summary-trigger"
            title="AI Smart Summary"
          >
            <Icon
              name="heroicons:sparkles"
              class="text-primary-600 h-5 w-5 transition-transform group-hover/ai:scale-110"
            />
            <span class="ai-glow"></span>
          </button>
          <button
            class="navbar-btn"
            id="ruler-toggle"
            title="Toggle Reading Ruler"
          >
            <Icon name="heroicons:minus" class="h-5 w-5" />
          </button>
          <button
            class="navbar-btn"
            id="typography-toggle"
            title="Typography Settings"
          >
            <Icon name="heroicons:language" class="h-5 w-5" />
          </button>
          <button class="navbar-btn" id="focus-mask-toggle" title="Focus Mask">
            <Icon name="heroicons:eye-slash" class="h-5 w-5" />
          </button>
        </div>
      </header>

      <!-- Main Reading Area -->
      <main class="reading-viewport scrollbar-hide" id="reading-viewport">
        <!-- Focus Mask (The rest is dimmed) -->
        <div class="focus-mask" id="focus-mask">
          <div class="mask-top"></div>
          <div class="mask-window"></div>
          <div class="mask-bottom"></div>
        </div>

        <!-- Reading Ruler -->
        <div class="reading-ruler" id="reading-ruler"></div>

        <article class="reading-body prose-custom" id="reading-body">
          <!-- Content injected here -->
        </article>
      </main>

      <!-- Bottom Status Bar -->
      <footer class="reading-status-bar">
        <div class="status-left">
          <span class="status-pill">
            <Icon
              name="heroicons:chat-bubble-bottom-center-text"
              class="mr-1 h-3 w-3"
            />
            <span id="word-count">0</span> kata
          </span>
          <span class="status-pill">
            <Icon name="heroicons:clock" class="mr-1 h-3 w-3" />
            <span id="reading-time">0</span> menit
          </span>
        </div>
        <div class="status-right">
          <div class="progress-ring-container">
            <span class="progress-percentage"
              ><span id="reading-progress-text">0</span>%</span
            >
          </div>
        </div>
      </footer>
    </div>

    <!-- Side Settings Panel -->
    <aside class="settings-drawer" id="settings-drawer">
      <div class="drawer-header">
        <h3>Pengaturan Visual</h3>
        <button id="close-drawer" class="rounded-full p-2 hover:bg-black/5">
          <Icon name="heroicons:x-mark" class="h-5 w-5" />
        </button>
      </div>

      <div class="drawer-content">
        <!-- Font Selection -->
        <section class="settings-group">
          <label>Jenis Huruf</label>
          <div class="font-grid">
            <button class="font-btn active" data-font="sans">Sans</button>
            <button class="font-btn" data-font="serif">Serif</button>
            <button class="font-btn" data-font="mono">Mono</button>
          </div>
        </section>

        <!-- Size Sliders -->
        <section class="settings-group">
          <div class="mb-2 flex items-center justify-between">
            <label>Ukuran Teks</label>
            <span class="value-tag" id="fs-value">18px</span>
          </div>
          <input
            type="range"
            id="font-size-slider"
            min="14"
            max="28"
            value="18"
            class="range-input"
          />
        </section>

        <section class="settings-group">
          <div class="mb-2 flex items-center justify-between">
            <label>Lebar Konten</label>
            <span class="value-tag" id="width-value">800px</span>
          </div>
          <input
            type="range"
            id="width-slider"
            min="500"
            max="1100"
            step="50"
            value="800"
            class="range-input"
          />
        </section>

        <section class="settings-group">
          <div class="mb-2 flex items-center justify-between">
            <label>Jarak Baris</label>
            <span class="value-tag" id="lh-value">1.6</span>
          </div>
          <input
            type="range"
            id="line-height-slider"
            min="1.2"
            max="2.4"
            step="0.1"
            value="1.6"
            class="range-input"
          />
        </section>

        <!-- Extra Controls -->
        <div class="divider"></div>
        <div class="extra-actions">
          <button class="action-tile" id="print-mode">
            <Icon name="heroicons:printer" class="h-5 w-5" />
            <span>Cetak</span>
          </button>
          <button class="action-tile" id="share-link">
            <Icon name="heroicons:share" class="h-5 w-5" />
            <span>Bagikan</span>
          </button>
        </div>
      </div>
    </aside>
  </div>
</div>

<script>
  class EnhancedReadingMode {
    private isActive = false;
    private isFocusActive = false;
    private isRulerActive = false;
    private sourceElement: HTMLElement | null = null;
    private settings = {
      theme: "default",
      font: "sans",
      fontSize: 18,
      width: 800,
      lineHeight: 1.6,
    };

    constructor() {
      this.loadSettings();
      this.initEventListeners();
    }

    private initEventListeners() {
      // Toggle System
      document
        .getElementById("reading-mode-toggle")
        ?.addEventListener("click", () => this.toggle(true));
      document
        .getElementById("close-reading-mode")
        ?.addEventListener("click", () => this.toggle(false));

      // Tool Settings Drawer
      document
        .getElementById("typography-toggle")
        ?.addEventListener("click", (e) => {
          e.stopPropagation();
          document
            .getElementById("settings-drawer")
            ?.classList.toggle("active");
        });
      document.getElementById("close-drawer")?.addEventListener("click", () => {
        document.getElementById("settings-drawer")?.classList.remove("active");
      });

      // Individual Tool Toggles
      document
        .getElementById("focus-mask-toggle")
        ?.addEventListener("click", () => this.toggleFocusMask());
      document
        .getElementById("ruler-toggle")
        ?.addEventListener("click", () => this.toggleRuler());
      document
        .getElementById("ai-summary-trigger")
        ?.addEventListener("click", () => this.triggerAISummary());

      // Themes Selector
      document.querySelectorAll(".theme-dot").forEach((dot) => {
        dot.addEventListener("click", (e) => {
          const theme =
            (e.currentTarget as HTMLElement).dataset.theme || "default";
          this.applyTheme(theme);
        });
      });

      // Font Selector
      document.querySelectorAll(".font-btn").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          const font = (e.currentTarget as HTMLElement).dataset.font || "sans";
          this.applyFont(font);
        });
      });

      // Typography Sliders
      this.bindSlider("font-size-slider", "fontSize", "px", "fs-value");
      this.bindSlider("width-slider", "width", "px", "width-value");
      this.bindSlider("line-height-slider", "lineHeight", "", "lh-value");

      // Utilities
      document
        .getElementById("print-mode")
        ?.addEventListener("click", () => this.handlePrint());
      document
        .getElementById("share-link")
        ?.addEventListener("click", () => this.handleShare());

      // Interactive Area Events
      const viewport = document.getElementById("reading-viewport");
      viewport?.addEventListener("scroll", () => this.updateTracking());
      viewport?.addEventListener("mousemove", (e) => {
        if (this.isFocusActive) this.updateFocusMask(e);
        if (this.isRulerActive) this.updateRuler(e);
      });

      // Global Shortcuts
      document.addEventListener("keydown", (e) => {
        if (!this.isActive) return;
        if (e.key === "Escape") this.toggle(false);
        if (e.key === "f") this.toggleFocusMask();
        if (e.key === "r") this.toggleRuler();
      });
    }

    private bindSlider(id: string, key: string, unit: string, valueId: string) {
      const slider = document.getElementById(id) as HTMLInputElement;
      slider?.addEventListener("input", (e) => {
        const val = parseFloat((e.target as HTMLInputElement).value);
        (this.settings as any)[key] = val;
        const display = document.getElementById(valueId);
        if (display) display.textContent = `${val}${unit}`;
        this.applyTypography();
        this.saveSettings();
      });
    }

    private toggle(state: boolean) {
      this.isActive = state;
      const overlay = document.getElementById("reading-mode-overlay");
      const bodyContent = document.getElementById("reading-body");

      if (state) {
        this.sourceElement = document.querySelector(
          ".prose, .blog-content, main article",
        );
        if (this.sourceElement && bodyContent) {
          bodyContent.innerHTML = this.sourceElement.innerHTML;
          this.updateStats(this.sourceElement.textContent || "");
          setTimeout(() => this.updateTracking(), 100);
        }
        overlay?.classList.add("active");
        document.body.style.overflow = "hidden";
        this.applyTheme(this.settings.theme);
        this.applyFont(this.settings.font);
        this.applyTypography();
      } else {
        overlay?.classList.remove("active");
        document.body.style.overflow = "";
        this.resetTools();
      }
    }

    private resetTools() {
      this.isFocusActive = false;
      this.isRulerActive = false;
      document.getElementById("focus-mask")?.classList.remove("active");
      document.getElementById("reading-ruler")?.classList.remove("active");
      document.getElementById("settings-drawer")?.classList.remove("active");
    }

    private toggleFocusMask() {
      this.isFocusActive = !this.isFocusActive;
      document
        .getElementById("focus-mask")
        ?.classList.toggle("active", this.isFocusActive);
      document
        .getElementById("focus-mask-toggle")
        ?.classList.toggle("active", this.isFocusActive);
    }

    private toggleRuler() {
      this.isRulerActive = !this.isRulerActive;
      document
        .getElementById("reading-ruler")
        ?.classList.toggle("active", this.isRulerActive);
      document
        .getElementById("ruler-toggle")
        ?.classList.toggle("active", this.isRulerActive);
    }

    private updateFocusMask(e: MouseEvent) {
      const window = document.querySelector(".mask-window") as HTMLElement;
      const viewport = document.getElementById("reading-viewport");
      if (window && viewport) {
        const rect = viewport.getBoundingClientRect();
        const y = e.clientY - rect.top;
        window.style.top = `${y - 40}px`;
      }
    }

    private updateRuler(e: MouseEvent) {
      const ruler = document.getElementById("reading-ruler");
      const viewport = document.getElementById("reading-viewport");
      if (ruler && viewport) {
        const rect = viewport.getBoundingClientRect();
        ruler.style.top = `${e.clientY - rect.top}px`;
      }
    }

    private triggerAISummary() {
      const btn = document.getElementById("ai-summary-trigger");
      btn?.classList.add("loading");
      setTimeout(() => {
        alert(
          "KonXC AI Recap: Artikel ini membahas strategi integrasi teknologi mikroservis untuk skalabilitas enterprise dengan fokus pada resilinesi sistem.",
        );
        btn?.classList.remove("loading");
      }, 1500);
    }

    private handlePrint() {
      const content = document.getElementById("reading-body")?.innerHTML;
      if (!content) return;
      const printWin = window.open("", "", "width=900,height=600");
      if (printWin) {
        printWin.document.write(
          `<html><head><title>KonXC Reader</title><style>body{padding:40px;font-family:serif;line-height:1.6;max-width:800px;margin:auto;}img{max-width:100%}</style></head><body>${content}</body></html>`,
        );
        printWin.document.close();
        printWin.focus();
        printWin.print();
        printWin.close();
      }
    }

    private handleShare() {
      if (navigator.share) {
        navigator.share({ title: document.title, url: window.location.href });
      } else {
        navigator.clipboard.writeText(window.location.href);
        alert("Tautan disalin ke papan klip!");
      }
    }

    private applyTheme(theme: string) {
      this.settings.theme = theme;
      const overlay = document.getElementById("reading-mode-overlay");
      if (overlay) overlay.setAttribute("data-theme", theme);
      document.querySelectorAll(".theme-dot").forEach((dot) => {
        dot.classList.toggle(
          "active",
          (dot as HTMLElement).dataset.theme === theme,
        );
      });
      this.saveSettings();
    }

    private applyFont(font: string) {
      this.settings.font = font;
      document.getElementById("reading-body")?.setAttribute("data-font", font);
      document.querySelectorAll(".font-btn").forEach((btn) => {
        btn.classList.toggle(
          "active",
          (btn as HTMLElement).dataset.font === font,
        );
      });
      this.saveSettings();
    }

    private applyTypography() {
      const body = document.getElementById("reading-body");
      if (body) {
        body.style.fontSize = `${this.settings.fontSize}px`;
        body.style.maxWidth = `${this.settings.width}px`;
        body.style.lineHeight = this.settings.lineHeight.toString();
      }
    }

    private updateStats(text: string) {
      const words = text.trim().split(/\s+/).length;
      const time = Math.ceil(words / 200);
      const wcEl = document.getElementById("word-count");
      const rtEl = document.getElementById("reading-time");
      if (wcEl) wcEl.textContent = words.toLocaleString();
      if (rtEl) rtEl.textContent = time.toString();
    }

    private updateTracking() {
      const viewport = document.getElementById("reading-viewport");
      const bar = document.getElementById("reading-progress-fill");
      const text = document.getElementById("reading-progress-text");
      if (!viewport || !bar || !text) return;

      const maxScroll = viewport.scrollHeight - viewport.clientHeight;
      const progress =
        maxScroll <= 0
          ? 100
          : Math.min(100, Math.ceil((viewport.scrollTop / maxScroll) * 100));

      bar.style.width = `${progress}%`;
      const start = parseInt(text.textContent || "0");
      if (start !== progress) this.animateValue(text, start, progress, 200);
    }

    private animateValue(
      obj: HTMLElement,
      start: number,
      end: number,
      duration: number,
    ) {
      let startTimestamp: number | null = null;
      const step = (timestamp: number) => {
        if (!startTimestamp) startTimestamp = timestamp;
        const progress = Math.min((timestamp - startTimestamp) / duration, 1);
        obj.innerText = Math.floor(progress * (end - start) + start).toString();
        if (progress < 1) window.requestAnimationFrame(step);
      };
      window.requestAnimationFrame(step);
    }

    private loadSettings() {
      const saved = localStorage.getItem("konxc-reading-settings");
      if (saved) {
        this.settings = { ...this.settings, ...JSON.parse(saved) };
        const fs = document.getElementById(
          "font-size-slider",
        ) as HTMLInputElement;
        const w = document.getElementById("width-slider") as HTMLInputElement;
        const lh = document.getElementById(
          "line-height-slider",
        ) as HTMLInputElement;
        if (fs) fs.value = this.settings.fontSize.toString();
        if (w) w.value = this.settings.width.toString();
        if (lh) lh.value = this.settings.lineHeight.toString();
      }
    }

    private saveSettings() {
      localStorage.setItem(
        "konxc-reading-settings",
        JSON.stringify(this.settings),
      );
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    new EnhancedReadingMode();
  });
</script>

<style>
  @reference "@/styles/global.css";

  .reading-mode-system {
    --transition-smooth: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* FAB Button */
  .reading-mode-fab {
    @apply fixed right-8 bottom-8 z-40 flex items-center gap-3 rounded-full p-2 pr-6 text-slate-900 shadow-2xl backdrop-blur-md transition-all duration-300 hover:scale-105 active:scale-95;
    background: linear-gradient(135deg, #f8fafc 0%, #cbd5e1 100%);
    box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.8);
  }

  .fab-icon-container,
  .fab-blob {
    @apply flex h-8 w-8 items-center justify-center rounded-full bg-neutral-900 text-white shadow-lg;
  }

  .fab-text,
  .fab-label {
    @apply text-[11px] font-bold tracking-wider uppercase opacity-90;
  }

  /* Overlay System - Spring Animation */
  .reading-immersive-overlay {
    @apply pointer-events-none fixed inset-0 z-50 flex scale-105 flex-col opacity-0 transition-all duration-700;
    transition-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1);
    background: #ffffff;
  }

  .reading-immersive-overlay.active {
    @apply pointer-events-auto scale-100 opacity-100;
  }

  .reading-progress-track {
    @apply absolute top-0 left-0 z-100 h-1.5 w-full bg-black/5;
  }

  .reading-progress-bar {
    @apply bg-primary-600 h-full w-0 shadow-[0_0_10px_rgba(37,99,235,0.5)] transition-all duration-150;
  }

  .reading-shell {
    @apply relative flex h-full flex-col;
  }

  /* Themes */
  [data-theme="default"] {
    background: #ffffff;
    color: #1a1a1a;
  }
  [data-theme="sepia"] {
    background: #fdf6e3;
    color: #586e75;
  }
  [data-theme="night"] {
    background: #121212;
    color: #b0b0b0;
  }
  [data-theme="cream"] {
    background: #fffdfa;
    color: #433422;
  }

  /* Reading Ruler */
  .reading-ruler {
    @apply pointer-events-none fixed left-0 z-40 hidden w-full border-b border-neutral-900/10 shadow-[0_1px_3px_rgba(0,0,0,0.05)];
    height: 1.5rem;
    background: linear-gradient(to bottom, transparent, rgba(0, 0, 0, 0.02));
  }
  .reading-ruler.active {
    @apply block;
  }

  /* AI Sparkle Button */
  .ai-btn {
    @apply relative overflow-hidden;
  }
  .ai-glow {
    @apply absolute inset-0 -z-10 rounded-full opacity-0 transition-opacity duration-500;
    box-shadow: 0 0 15px 2px rgba(99, 102, 241, 0.4);
  }
  .ai-btn:hover .ai-glow {
    @apply opacity-100;
  }
  .ai-btn.loading {
    @apply scale-90 opacity-50;
    animation: ai-scan 0.8s ease-in-out infinite alternate;
  }

  @keyframes ai-scan {
    0% {
      transform: scale(0.9);
    }
    100% {
      transform: scale(1.05);
      filter: hue-rotate(90deg);
    }
  }

  .navbar-btn.active {
    @apply bg-neutral-900 text-white;
  }

  [data-theme="slate"] {
    background: #263238;
    color: #eceff1;
  }

  [data-theme="sepia"] .prose-custom :global(strong) {
    color: #859900;
  }
  [data-theme="night"] .prose-custom :global(strong) {
    color: #ffffff;
  }

  /* Navbar */
  .reading-navbar {
    @apply flex items-center justify-between border-b border-black/5 px-8 py-5 backdrop-blur-3xl;
    background: rgba(255, 255, 255, 0.7);
  }

  [data-theme="night"] .reading-navbar,
  [data-theme="slate"] .reading-navbar {
    background: rgba(0, 0, 0, 0.3);
    border-color: rgba(255, 255, 255, 0.1);
  }

  .navbar-btn {
    @apply flex items-center gap-3 rounded-2xl p-2 px-5 text-sm font-bold transition-all hover:bg-black/5 active:scale-95;
  }

  .navbar-btn.active {
    @apply bg-primary-600 text-white shadow-lg;
  }

  .theme-selector {
    @apply flex items-center gap-4 rounded-2xl bg-black/5 p-2 px-4 shadow-inner;
  }

  .theme-dot {
    @apply h-6 w-6 cursor-pointer rounded-full border-4 border-transparent shadow-sm transition-all hover:scale-150 active:scale-95;
  }

  .theme-dot:hover {
    box-shadow: 0 0 15px currentColor;
  }

  .theme-dot.active {
    @apply border-primary-600 scale-125;
  }

  .theme-dot.default {
    background: #ffffff;
    border: 1px solid #ddd;
  }
  .theme-dot.sepia {
    background: #fdf6e3;
  }
  .theme-dot.cream {
    background: #fafafa;
  }
  .theme-dot.slate {
    background: #263238;
  }
  .theme-dot.night {
    background: #121212;
  }

  /* Viewport */
  .reading-viewport {
    @apply relative flex-1 overflow-y-auto px-6 py-20 transition-all duration-300;
    scroll-behavior: smooth;
  }

  .reading-body {
    @apply mx-auto transition-all duration-500;
  }

  /* Fonts */
  .reading-body[data-font="serif"] {
    font-family: "Georgia", "Merriweather", serif;
    font-weight: 300;
  }
  .reading-body[data-font="mono"] {
    font-family: "JetBrains Mono", "Fira Code", monospace;
  }
  .reading-body[data-font="sans"] {
    font-family: "Outfit", "Inter", system-ui, sans-serif;
  }

  /* Focus Mask */
  .focus-mask {
    @apply pointer-events-none absolute inset-0 z-10 opacity-0 transition-opacity duration-500;
  }
  .focus-mask.active {
    @apply opacity-100;
  }

  .mask-window {
    @apply absolute right-0 left-0 h-24 transition-all duration-150;
    box-shadow: 0 0 0 100vh rgba(0, 0, 0, 0.8);
  }

  [data-theme="night"] .mask-window {
    box-shadow: 0 0 0 100vh rgba(0, 0, 0, 0.95);
  }

  /* Status Bar */
  .reading-status-bar {
    @apply flex items-center justify-between border-t border-black/5 px-8 py-4 backdrop-blur-3xl;
    background: rgba(255, 255, 255, 0.7);
  }

  [data-theme="night"] .reading-status-bar,
  [data-theme="slate"] .reading-status-bar {
    background: rgba(0, 0, 0, 0.3);
    border-color: rgba(255, 255, 255, 0.1);
  }

  .status-pill {
    @apply flex items-center rounded-xl bg-black/5 px-5 py-2 text-[10px] font-bold tracking-widest uppercase opacity-80;
  }

  .progress-percentage {
    @apply text-xl font-black tracking-tight;
    font-family: "Outfit", sans-serif;
  }

  /* Settings Drawer - Bouncy Slide */
  .settings-drawer {
    @apply fixed top-0 right-0 bottom-0 z-100 w-85 translate-x-full bg-white/90 shadow-2xl backdrop-blur-2xl transition-transform duration-500;
    transition-timing-function: cubic-bezier(0.68, -0.6, 0.32, 1.6);
