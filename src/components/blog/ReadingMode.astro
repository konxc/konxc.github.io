---
/**
 * Reading Mode Component - Enhanced Modular Version
 * High-end immersive reading experience with focus tools and typography controls.
 */
import { Icon } from "astro-icon/components";

export interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<div class={`reading-mode-system ${className}`}>
  <!-- Reading Mode Toggle (FAB) -->
  <button
    class="reading-mode-fab group"
    id="reading-mode-toggle"
    aria-label="Toggle Reading Mode"
  >
    <div class="fab-icon-container">
      <Icon
        name="heroicons:book-open"
        class="h-6 w-6 transition-transform group-hover:scale-110"
      />
    </div>
    <span class="fab-text">Mode Baca</span>
  </button>

  <!-- Immersive Overlay -->
  <div
    class="reading-immersive-overlay"
    id="reading-mode-overlay"
    data-theme="default"
  >
    <!-- Premium Progress Indicator - Fixed to top of viewport -->
    <div class="reading-progress-track">
      <div class="reading-progress-bar" id="reading-progress-fill"></div>
    </div>

    <div class="reading-shell">
      <!-- 1. NAVIGATION TOOLBAR -->
      <header class="reading-navbar">
        <div class="navbar-left">
          <div class="flex items-center gap-4">
            <button
              class="navbar-btn"
              id="back-to-top"
              aria-label="Back to Top"
              title="Back to Top"
            >
              <Icon name="heroicons:arrow-up" class="h-6 w-6" />
              <span class="hidden sm:inline">Atas</span>
            </button>
            <button
              class="navbar-btn"
              id="close-reading-mode"
              aria-label="Exit Reading Mode"
            >
              <Icon name="heroicons:x-mark" class="h-6 w-6" />
              <span class="hidden sm:inline">Keluar</span>
            </button>
          </div>
        </div>

        <div class="navbar-center">
          <div class="flex items-center gap-4">
            <button class="navbar-btn" id="font-size-toggle" title="Font Size">
              <Icon name="heroicons:magnifying-glass-plus" class="h-5 w-5" />
            </button>
            <div class="theme-selector">
              {
                ["default", "sepia", "cream", "slate", "night"].map((t) => (
                  <button
                    class={`theme-dot ${t} ${t === "default" ? "active" : ""}`}
                    data-theme={t}
                    title={t.charAt(0).toUpperCase() + t.slice(1)}
                  />
                ))
              }
            </div>
          </div>
        </div>

        <div class="navbar-right">
          <div class="flex items-center gap-4">
            <button
              class="navbar-btn ai-btn group/ai"
              id="ai-summary-trigger"
              title="AI Smart Summary"
            >
              <Icon
                name="heroicons:sparkles"
                class="text-primary-600 h-5 w-5 transition-transform group-hover/ai:scale-110"
              />
              <span class="ai-glow"></span>
            </button>
            <button
              class="navbar-btn"
              id="ruler-toggle"
              title="Toggle Reading Ruler"
            >
              <Icon name="heroicons:minus" class="h-5 w-5" />
            </button>
            <button
              class="navbar-btn"
              id="typography-toggle"
              title="Typography Settings"
            >
              <Icon name="heroicons:language" class="h-5 w-5" />
            </button>
            <button
              class="navbar-btn"
              id="line-height-toggle"
              title="Line Height"
            >
              <Icon name="heroicons:bars-3" class="h-5 w-5" />
            </button>
            <button
              class="navbar-btn"
              id="focus-mask-toggle"
              title="Focus Mask"
            >
              <Icon name="heroicons:eye-slash" class="h-5 w-5" />
            </button>
          </div>
        </div>
      </header>

      <!-- 2. READING VIEWPORT -->
      <main class="reading-viewport scrollbar-hide" id="reading-viewport">
        <!-- Overlay Tools -->
        <div class="focus-mask" id="focus-mask">
          <div class="mask-top"></div>
          <div class="mask-window"></div>
          <div class="mask-bottom"></div>
        </div>
        <div class="reading-ruler" id="reading-ruler"></div>

        <!-- Content Area -->
        <article
          class="reading-body blog-content prose prose-lg prose-neutral dark:prose-invert max-w-none"
          id="reading-body"
        >
          <!-- Content injected via JS -->
        </article>
      </main>

      <!-- 3. STATUS FOOTER -->
      <footer class="reading-status-bar">
        <div class="status-left">
          <span class="status-pill">
            <Icon
              name="heroicons:chat-bubble-bottom-center-text"
              class="mr-1.5 h-3.5 w-3.5"
            />
            <span id="word-count">0</span> kata
          </span>
          <span class="status-pill">
            <Icon name="heroicons:clock" class="mr-1.5 h-3.5 w-3.5" />
            <span id="reading-time">0</span> menit
          </span>
        </div>
        <div class="status-right">
          <div class="progress-ring-container">
            <span class="progress-percentage"
              ><span id="reading-progress-text">0</span>%</span
            >
          </div>
        </div>
      </footer>
    </div>

    <!-- 4. TYPOGRAPHY DRAWER -->
    <aside class="settings-drawer" id="settings-drawer">
      <div class="drawer-header">
        <h3>Pengaturan Visual</h3>
        <button id="close-drawer" class="rounded-full p-2 hover:bg-black/5">
          <Icon name="heroicons:x-mark" class="h-5 w-5" />
        </button>
      </div>

      <div class="drawer-content">
        <section class="settings-group">
          <label>Jenis Huruf</label>
          <div class="font-grid">
            <button class="font-btn active" data-font="sans">Sans</button>
            <button class="font-btn" data-font="serif">Serif</button>
            <button class="font-btn" data-font="mono">Mono</button>
          </div>
        </section>

        <section class="settings-group">
          <div class="mb-2 flex items-center justify-between">
            <label>Ukuran Teks</label>
            <span class="value-tag" id="fs-value">18px</span>
          </div>
          <input
            type="range"
            id="font-size-slider"
            min="14"
            max="28"
            value="18"
            class="range-input"
          />
        </section>

        <section class="settings-group">
          <div class="mb-2 flex items-center justify-between">
            <label>Lebar Konten</label>
            <span class="value-tag" id="width-value">800px</span>
          </div>
          <input
            type="range"
            id="width-slider"
            min="500"
            max="1100"
            step="50"
            value="800"
            class="range-input"
          />
        </section>

        <section class="settings-group">
          <div class="mb-2 flex items-center justify-between">
            <label>Jarak Baris</label>
            <span class="value-tag" id="lh-value">1.6</span>
          </div>
          <input
            type="range"
            id="line-height-slider"
            min="1.2"
            max="2.4"
            step="0.1"
            value="1.6"
            class="range-input"
          />
        </section>

        <div class="divider"></div>
        <div class="extra-actions">
          <button class="action-tile" id="print-mode">
            <Icon name="heroicons:printer" class="h-5 w-5" />
            <span>Cetak</span>
          </button>
          <button class="action-tile" id="share-link">
            <Icon name="heroicons:share" class="h-5 w-5" />
            <span>Bagikan</span>
          </button>
        </div>
      </div>
    </aside>
  </div>
</div>

<script>
  class EnhancedReadingMode {
    private isActive = false;
    private isFocusActive = false;
    private isRulerActive = false;
    private settings = {
      theme: "default",
      font: "sans",
      fontSize: 18,
      width: 800,
      lineHeight: 1.6,
    };

    // Cached elements
    private el: Record<string, HTMLElement | null> = {};

    constructor() {
      this.cacheElements();
      this.loadSettings();
      this.initEventListeners();
      this.updateTracking();
    }

    private cacheElements() {
      const ids = [
        "reading-mode-toggle",
        "close-reading-mode",
        "reading-mode-overlay",
        "reading-viewport",
        "reading-body",
        "reading-progress-fill",
        "reading-progress-text",
        "settings-drawer",
        "typography-toggle",
        "close-drawer",
        "focus-mask",
        "focus-mask-toggle",
        "reading-ruler",
        "ruler-toggle",
        "ai-summary-trigger",
        "word-count",
        "reading-time",
        "back-to-top",
        "font-size-toggle",
        "line-height-toggle",
      ];
      ids.forEach((id) => {
        this.el[id] = document.getElementById(id);
      });
    }

    private initEventListeners() {
      this.el["reading-mode-toggle"]?.addEventListener("click", () =>
        this.toggle(true),
      );
      this.el["close-reading-mode"]?.addEventListener("click", () =>
        this.toggle(false),
      );

      this.el["typography-toggle"]?.addEventListener("click", (e) => {
        e.stopPropagation();
        this.el["settings-drawer"]?.classList.toggle("active");
      });

      this.el["close-drawer"]?.addEventListener("click", () => {
        this.el["settings-drawer"]?.classList.remove("active");
      });

      this.el["focus-mask-toggle"]?.addEventListener("click", () =>
        this.toggleFocusMask(),
      );
      this.el["ruler-toggle"]?.addEventListener("click", () =>
        this.toggleRuler(),
      );
      this.el["ai-summary-trigger"]?.addEventListener("click", () =>
        this.triggerAISummary(),
      );

      // New toolbar buttons
      this.el["back-to-top"]?.addEventListener("click", () =>
        this.el["reading-viewport"]?.scrollTo({ top: 0, behavior: "smooth" }),
      );
      this.el["font-size-toggle"]?.addEventListener("click", () =>
        this.adjustFontSize(this.settings.fontSize < 28 ? 2 : -2),
      );
      this.el["line-height-toggle"]?.addEventListener("click", () =>
        this.adjustLineHeight(this.settings.lineHeight < 2.4 ? 0.2 : -0.2),
      );

      // Theme dots
      document.querySelectorAll(".theme-dot").forEach((dot) => {
        dot.addEventListener("click", (e) => {
          const theme =
            (e.currentTarget as HTMLElement).dataset.theme || "default";
          this.applyTheme(theme);
        });
      });

      // Font buttons
      document.querySelectorAll(".font-btn").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          const font = (btn as HTMLElement).dataset.font || "sans";
          this.applyFont(font);
        });
      });

      // Sliders
      this.bindSlider("font-size-slider", "fontSize", "px", "fs-value");
      this.bindSlider("width-slider", "width", "px", "width-value");
      this.bindSlider("line-height-slider", "lineHeight", "", "lh-value");

      // Utilities
      document
        .getElementById("print-mode")
        ?.addEventListener("click", () => this.handlePrint());
      document
        .getElementById("share-link")
        ?.addEventListener("click", () => this.handleShare());

      // Viewport Events
      this.el["reading-viewport"]?.addEventListener("scroll", () =>
        this.updateTracking(),
      );

      // Global Tracking (for main page scroll)
      window.addEventListener("scroll", () => {
        if (!this.isActive) this.updateTracking();
      });

      this.el["reading-viewport"]?.addEventListener("mousemove", (e) => {
        if (this.isFocusActive) this.updateFocusMask(e as MouseEvent);
        if (this.isRulerActive) this.updateRuler(e as MouseEvent);
      });

      // Global Shortcuts
      document.addEventListener("keydown", (e) => {
        if (!this.isActive) return;
        if (e.key === "Escape") this.toggle(false);
        if (e.key === "f") this.toggleFocusMask();
        if (e.key === "r") this.toggleRuler();
      });
    }

    private bindSlider(id: string, key: string, unit: string, valueId: string) {
      const slider = document.getElementById(id) as HTMLInputElement;
      slider?.addEventListener("input", (e) => {
        const val = parseFloat((e.target as HTMLInputElement).value);
        (this.settings as any)[key] = val;
        const display = document.getElementById(valueId);
        if (display) display.textContent = `${val}${unit}`;
        this.applyTypography();
        this.saveSettings();
      });
    }

    private adjustFontSize(delta: number) {
      const newSize = Math.min(
        28,
        Math.max(14, this.settings.fontSize + delta),
      );
      this.settings.fontSize = newSize;
      const slider = document.getElementById(
        "font-size-slider",
      ) as HTMLInputElement;
      if (slider) slider.value = newSize.toString();
      const display = document.getElementById("fs-value");
      if (display) display.textContent = `${newSize}px`;
      this.applyTypography();
      this.saveSettings();
    }

    private adjustLineHeight(delta: number) {
      const newHeight = parseFloat(
        Math.min(2.4, Math.max(1.2, this.settings.lineHeight + delta))
          .toFixed(1)
          .toString(),
      );
      this.settings.lineHeight = newHeight;
      const slider = document.getElementById(
        "line-height-slider",
      ) as HTMLInputElement;
      if (slider) slider.value = newHeight.toString();
      const display = document.getElementById("lh-value");
      if (display) display.textContent = newHeight.toString();
      this.applyTypography();
      this.saveSettings();
    }

    private toggle(state: boolean) {
      this.isActive = state;
      const overlay = this.el["reading-mode-overlay"];
      const body = this.el["reading-body"];

      if (state) {
        const source = document.querySelector(
          ".prose, .blog-content, main article",
        );
        if (source && body) {
          // Clone source to avoid mutating the original DOM
          const clone = source.cloneNode(true) as HTMLElement;

          // Remove redundant components in reading mode
          const toRemove = clone.querySelectorAll(
            ".reading-progress, .social-share, .interactive-demo-helper",
          );
          toRemove.forEach((el) => el.remove());

          body.innerHTML = clone.innerHTML;
          this.updateStats(source.textContent || "");
          setTimeout(() => this.updateTracking(), 100);
        }
        overlay?.classList.add("active");
        document.body.style.overflow = "hidden";
        // Hide Lab FAB if exists
        document.getElementById("konxc-lab-suite")?.classList.add("hidden");
        this.applyAllSettings();
      } else {
        overlay?.classList.remove("active");
        document.body.style.overflow = "";
        // Show Lab FAB if dev mode
        document.getElementById("konxc-lab-suite")?.classList.remove("hidden");
        this.resetTools();
      }
    }

    private applyAllSettings() {
      this.applyTheme(this.settings.theme);
      this.applyFont(this.settings.font);
      this.applyTypography();
    }

    private resetTools() {
      this.isFocusActive = false;
      this.isRulerActive = false;
      this.el["focus-mask"]?.classList.remove("active");
      this.el["reading-ruler"]?.classList.remove("active");
      this.el["settings-drawer"]?.classList.remove("active");
    }

    private toggleFocusMask() {
      this.isFocusActive = !this.isFocusActive;
      this.el["focus-mask"]?.classList.toggle("active", this.isFocusActive);
      this.el["focus-mask-toggle"]?.classList.toggle(
        "active",
        this.isFocusActive,
      );
    }

    private toggleRuler() {
      this.isRulerActive = !this.isRulerActive;
      this.el["reading-ruler"]?.classList.toggle("active", this.isRulerActive);
      this.el["ruler-toggle"]?.classList.toggle("active", this.isRulerActive);
    }

    private updateFocusMask(e: MouseEvent) {
      const windowTarget = document.querySelector(
        ".mask-window",
      ) as HTMLElement;
      const viewport = this.el["reading-viewport"];
      if (windowTarget && viewport) {
        const rect = viewport.getBoundingClientRect();
        windowTarget.style.top = `${e.clientY - rect.top - 40}px`;
      }
    }

    private updateRuler(e: MouseEvent) {
      const ruler = this.el["reading-ruler"];
      const viewport = this.el["reading-viewport"];
      if (ruler && viewport) {
        const rect = viewport.getBoundingClientRect();
        ruler.style.top = `${e.clientY - rect.top}px`;
      }
    }

    private triggerAISummary() {
      const btn = this.el["ai-summary-trigger"];
      btn?.classList.add("loading");
      setTimeout(() => {
        alert(
          "KonXC AI Recap: Artikel ini membahas strategi integratif optimasi performa web melalui modularitas komponen dan efisiensi script client-side.",
        );
        btn?.classList.remove("loading");
      }, 1500);
    }

    private handlePrint() {
      const content = this.el["reading-body"]?.innerHTML;
      if (!content) return;
      const win = window.open("", "", "width=900,height=600");
      if (win) {
        win.document.write(`
          <html><head><title>KonXC Reader</title>
          <style>body{padding:60px;font-family:serif;line-height:1.6;max-width:800px;margin:auto;}img{max-width:100%}</style>
          </head><body>${content}</body></html>
        `);
        win.document.close();
        win.focus();
        setTimeout(() => {
          win.print();
          win.close();
        }, 250);
      }
    }

    private handleShare() {
      if (navigator.share) {
        navigator.share({ title: document.title, url: window.location.href });
      } else {
        navigator.clipboard.writeText(window.location.href);
        alert("Tautan disalin ke papan klip!");
      }
    }

    private applyTheme(theme: string) {
      this.settings.theme = theme;
      this.el["reading-mode-overlay"]?.setAttribute("data-theme", theme);
      document.querySelectorAll(".theme-dot").forEach((dot) => {
        dot.classList.toggle(
          "active",
          (dot as HTMLElement).dataset.theme === theme,
        );
      });
      this.saveSettings();
    }

    private applyFont(font: string) {
      this.settings.font = font;
      this.el["reading-body"]?.setAttribute("data-font", font);
      document.querySelectorAll(".font-btn").forEach((btn) => {
        btn.classList.toggle(
          "active",
          (btn as HTMLElement).dataset.font === font,
        );
      });
      this.saveSettings();
    }

    private applyTypography() {
      const body = this.el["reading-body"];
      if (body) {
        body.style.fontSize = `${this.settings.fontSize}px`;
        body.style.maxWidth = `${this.settings.width}px`;
        body.style.lineHeight = this.settings.lineHeight.toString();
      }
    }

    private updateStats(text: string) {
      const words = text.trim().split(/\s+/).length;
      const time = Math.ceil(words / 200);
      if (this.el["word-count"])
        this.el["word-count"].textContent = words.toLocaleString();
      if (this.el["reading-time"])
        this.el["reading-time"].textContent = time.toString();
    }

    private updateTracking() {
      const isReading = this.isActive;
      const viewport = isReading ? this.el["reading-viewport"] : null;
      const text = this.el["reading-progress-text"];

      let progress = 0;
      if (isReading && viewport) {
        const maxScroll = viewport.scrollHeight - viewport.clientHeight;
        progress =
          maxScroll <= 0
            ? 100
            : Math.min(100, Math.ceil((viewport.scrollTop / maxScroll) * 100));
      } else {
        const winScroll = document.documentElement.scrollTop;
        const height =
          document.documentElement.scrollHeight -
          document.documentElement.clientHeight;
        progress =
          height <= 0
            ? 100
            : Math.min(100, Math.ceil((winScroll / height) * 100));
      }

      const bar = this.el["reading-progress-fill"];
      if (bar) bar.style.width = `${progress}%`;

      if (text && isReading) {
        const start = parseInt(text.textContent || "0");
        if (start !== progress) this.animateValue(text, start, progress, 200);
      }
    }

    private animateValue(
      obj: HTMLElement,
      start: number,
      end: number,
      duration: number,
    ) {
      let startTimestamp: number | null = null;
      const step = (timestamp: number) => {
        if (!startTimestamp) startTimestamp = timestamp;
        const progress = Math.min((timestamp - startTimestamp) / duration, 1);
        obj.innerText = Math.floor(progress * (end - start) + start).toString();
        if (progress < 1) window.requestAnimationFrame(step);
      };
      window.requestAnimationFrame(step);
    }

    private loadSettings() {
      const saved = localStorage.getItem("konxc-reading-settings");
      if (saved) {
        this.settings = { ...this.settings, ...JSON.parse(saved) };
        const fs = document.getElementById(
          "font-size-slider",
        ) as HTMLInputElement;
        const w = document.getElementById("width-slider") as HTMLInputElement;
        const lh = document.getElementById(
          "line-height-slider",
        ) as HTMLInputElement;
        if (fs) fs.value = this.settings.fontSize.toString();
        if (w) w.value = this.settings.width.toString();
        if (lh) lh.value = this.settings.lineHeight.toString();
      }
    }

    private saveSettings() {
      localStorage.setItem(
        "konxc-reading-settings",
        JSON.stringify(this.settings),
      );
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    new EnhancedReadingMode();
  });
</script>

<style>
  @reference "@/styles/global.css";

  .reading-mode-system {
    --transition-smooth: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* 1. FAB Style */
  .reading-mode-fab {
    @apply fixed right-8 bottom-8 z-40 flex items-center gap-3 rounded-full p-2 pr-6 text-slate-900 shadow-2xl backdrop-blur-md transition-all duration-300 hover:scale-105 active:scale-95;
    background: linear-gradient(135deg, #f8fafc 0%, #cbd5e1 100%);
    box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.8);
  }

  .fab-icon-container {
    @apply flex h-8 w-8 items-center justify-center rounded-full bg-neutral-900 text-white shadow-lg;
  }

  .fab-text {
    @apply text-[11px] font-bold tracking-wider uppercase opacity-90;
  }

  /* 2. Overlay & Shell */
  .reading-immersive-overlay {
    @apply pointer-events-none fixed inset-0 z-[1100] flex scale-105 flex-col bg-white opacity-0 transition-all duration-700;
    transition-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .reading-immersive-overlay.active {
    @apply pointer-events-auto scale-100 opacity-100;
  }

  .reading-progress-track {
    @apply fixed top-0 left-0 z-[2000] h-1.5 w-full bg-black/10 backdrop-blur-md;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }

  .reading-progress-bar {
    @apply relative h-full w-0 shadow-[0_0_20px_rgba(59,130,246,0.8)] transition-all duration-300;
    background: linear-gradient(90deg, #3b82f6 0%, #6366f1 50%, #a855f7 100%);
    background-size: 200% 100%;
    animation: shimmer-progress 4s linear infinite;
  }

  .reading-progress-bar::after {
    content: "";
    @apply absolute top-0 right-0 h-full w-2 bg-white opacity-90 blur-[2px];
    box-shadow: 0 0 10px 2px white;
  }

  @keyframes shimmer-progress {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }

  .reading-shell {
    @apply relative flex h-full flex-col;
  }

  /* 3. Toolbar & Navbar */
  .reading-navbar {
    @apply flex items-center justify-between border-b border-black/5 px-10 py-4 backdrop-blur-3xl;
    background: rgba(255, 255, 255, 0.85);
  }

  .navbar-btn {
    @apply flex items-center gap-3 rounded-2xl p-2 px-5 text-sm font-bold transition-all hover:bg-black/5 active:scale-95;
  }
  .navbar-btn.active {
    @apply bg-primary-600 text-white shadow-md;
  }

  .theme-selector {
    @apply flex items-center gap-4 rounded-2xl bg-black/5 p-2 px-4 shadow-inner;
  }
  .theme-dot {
    @apply h-6 w-6 cursor-pointer rounded-full border-4 border-transparent shadow-sm transition-all hover:scale-150 active:scale-95;
  }
  .theme-dot.active {
    @apply border-primary-600 scale-125;
  }

  .theme-dot.default {
    background: #ffffff;
    border-color: #eee;
  }
  .theme-dot.sepia {
    background: #fdf6e3;
  }
  .theme-dot.cream {
    background: #fafafa;
