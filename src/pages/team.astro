---
import UnifiedLayout from "@/layouts/UnifiedLayout.astro";

const coreTeam = [
  {
    name: "Sandi K.",
    role: "Lead Architect & Visionary",
    bio: "Pecinta teknologi yang berdedikasi untuk membangun ekosistem digital Indonesia yang lebih baik.",
    expertise: ["System Design", "Cloud Architecture", "Product Strategy"],
    social: { github: "#", linkedin: "#" },
  },
  {
    name: "M. Rizki",
    role: "Core Systems Engineer",
    bio: "Ahli dalam pengembangan sistem backend skala besar dan optimasi performa infrastruktur.",
    expertise: ["Go", "Kubernetes", "Database Tuning"],
    social: { github: "#", linkedin: "#" },
  },
  {
    name: "Sarah W.",
    role: "Creative Director",
    bio: "Desainer dengan fokus pada pengalaman pengguna yang intuitif dan estetika visual yang premium.",
    expertise: ["UI/UX Design", "Brand Strategy", "Motion Graphics"],
    social: { github: "#", linkedin: "#" },
  },
];
---

<UnifiedLayout
  title="Core Team - KonXC"
  description="Kenali barisan pemimpin dan spesialis di balik ekosistem digital KonXC."
  showNewsletter={false}
  headerVariant="transparent"
>
  <!-- 1. Hero Section -->
  <section
    class="bg-site relative overflow-hidden pt-24 pb-20 md:pt-32 md:pb-32"
  >
    <div class="absolute inset-0 -z-10 overflow-hidden opacity-30">
      <div
        class="bg-primary-600/10 dark:bg-primary-900/20 absolute top-0 right-0 h-[400px] w-[400px] rounded-full blur-[150px]"
      >
      </div>
    </div>

    <div class="relative z-10 container">
      <div class="max-w-3xl">
        <div
          class="text-primary-500 mb-4 text-xs font-black tracking-[0.3em] uppercase"
        >
          // The Core Crew
        </div>
        <h1
          class="text-on-site mb-8 text-5xl font-black tracking-tighter uppercase md:text-8xl"
        >
          MODERN <br />
          <span class="text-gradient">ARCHITECTS</span>.
        </h1>
        <p class="text-on-muted text-lg leading-relaxed md:text-xl">
          Kami adalah tim kecil yang berfokus pada dampak besar. Berdedikasi
          untuk membangun solusi teknologi yang tidak hanya berfungsi, tapi juga
          menginspirasi.
        </p>
      </div>
    </div>
  </section>

  <!-- 2. Team Grid -->
  <section class="bg-site py-24">
    <div class="container">
      <div class="grid gap-8 md:grid-cols-3">
        {
          coreTeam.map((member) => (
            <div class="group border-border-site bg-surface hover:bg-muted relative overflow-hidden rounded-[2.5rem] border p-10 transition-all">
              <div class="bg-muted relative mb-8 h-32 w-32 overflow-hidden rounded-full">
                {/* Placeholder Avatar */}
                <div class="text-on-site/10 absolute inset-0 flex items-center justify-center text-4xl font-black uppercase">
                  {member.name[0]}
                </div>
              </div>

              <h3 class="text-on-site mb-2 text-2xl font-black">
                {member.name}
              </h3>
              <div class="text-primary-600 dark:text-primary-500 mb-6 text-xs font-black tracking-widest uppercase">
                {member.role}
              </div>

              <p class="text-on-muted mb-8 text-sm leading-relaxed">
                {member.bio}
              </p>

              <div class="mb-10 flex flex-wrap gap-2">
                {member.expertise.map((skill) => (
                  <span class="bg-muted text-on-muted ring-border-site rounded-lg px-3 py-1 text-[9px] font-bold text-nowrap uppercase ring-1">
                    {skill}
                  </span>
                ))}
              </div>

              <div class="flex gap-4">
                <a
                  href={member.social.github}
                  class="text-on-muted hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
                >
                  <span class="sr-only">GitHub</span>
                  <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                  </svg>
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <style>
    section {
      @apply relative overflow-hidden;
    }
  </style>
</UnifiedLayout>
