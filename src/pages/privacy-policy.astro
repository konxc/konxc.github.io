---
import UnifiedLayout from "@layouts/UnifiedLayout.astro";

const title = "Kebijakan Privasi - KonXC";
const description =
  "Bagaimana kami mengelola dan melindungi data Anda sesuai dengan standar keamanan siber.";
---

<UnifiedLayout
  title={title}
  description={description}
  headerVariant="default"
  footerVariant="extended"
  showNewsletter={false}
>
  <main class="bg-site text-on-site min-h-screen">
    <!-- Hero Section -->
    <section
      class="section from-primary-50 to-secondary-50 bg-gradient-to-br dark:from-[var(--bg-base)] dark:to-[var(--bg-base)]"
    >
      <div class="container">
        <div class="mx-auto max-w-4xl text-center">
          <h1 class="mb-6 text-4xl font-bold lg:text-5xl">
            Kebijakan <span class="text-gradient">Privasi</span>
          </h1>
          <p class="text-on-muted mb-8 text-xl">
            Komitmen kami untuk melindungi privasi dan keamanan data pribadi
            Anda
          </p>
          <div
            class="border-border-site bg-surface rounded-2xl border p-6 shadow-lg"
          >
            <p class="text-on-muted text-sm">
              <strong>Terakhir diperbarui:</strong> 25 Oktober 2024
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Content Section -->
    <section class="section">
      <div class="container">
        <div class="mx-auto max-w-4xl">
          <div class="prose prose-lg max-w-none">
            <!-- Introduction -->
            <div
              class="border-border-site bg-surface mb-8 rounded-2xl border p-8 shadow-lg"
            >
              <h2 class="text-primary-600 mb-4 text-2xl font-bold">
                Pendahuluan
              </h2>
              <p class="text-on-muted leading-relaxed">
                PT Koneksi Jaringan Indonesia ("KonXC", "kami", "kita")
                berkomitmen untuk melindungi privasi dan keamanan informasi
                pribadi Anda. Kebijakan Privasi ini menjelaskan bagaimana kami
                mengumpulkan, menggunakan, menyimpan, dan melindungi informasi
                pribadi Anda ketika Anda menggunakan website <strong
                  >konxc.space</strong
                > dan layanan kami.
              </p>
              <p class="text-on-muted mt-4 leading-relaxed">
                Dengan menggunakan layanan kami, Anda menyetujui pengumpulan dan
                penggunaan informasi sesuai dengan kebijakan ini.
              </p>
            </div>

            <!-- Information We Collect -->
            <div
              class="border-border-site bg-surface mb-8 rounded-2xl border p-8 shadow-lg"
            >
              <h2 class="text-primary-600 mb-6 text-2xl font-bold">
                Informasi yang Kami Kumpulkan
              </h2>

              <h3 class="text-on-site mb-4 text-xl font-semibold">
                1. Informasi yang Anda Berikan
              </h3>
              <ul class="text-on-muted mb-6 list-inside list-disc space-y-2">
                <li>
                  Nama lengkap dan informasi kontak (email, nomor telepon)
                </li>
                <li>
                  Informasi perusahaan (nama perusahaan, jabatan, industri)
                </li>
                <li>Pesan dan komunikasi yang Anda kirimkan kepada kami</li>
                <li>
                  Informasi yang Anda berikan saat mendaftar newsletter atau
                  blog
                </li>
                <li>Feedback, review, dan komentar yang Anda berikan</li>
              </ul>

              <h3 class="text-on-site mb-4 text-xl font-semibold">
                2. Informasi yang Dikumpulkan Otomatis
              </h3>
              <ul class="text-on-muted mb-6 list-inside list-disc space-y-2">
                <li>Alamat IP dan informasi perangkat</li>
                <li>
                  Data penggunaan website (halaman yang dikunjungi, waktu
                  kunjungan)
                </li>
                <li>Informasi browser dan sistem operasi</li>
                <li>Cookies dan teknologi pelacakan serupa</li>
                <li>Data analytics untuk meningkatkan layanan</li>
              </ul>

              <h3 class="text-on-site mb-4 text-xl font-semibold">
                3. Informasi dari Pihak Ketiga
              </h3>
              <ul class="text-on-muted list-inside list-disc space-y-2">
                <li>
                  Informasi dari platform media sosial (jika Anda menghubungkan
                  akun)
                </li>
                <li>Data dari partner bisnis dan referral</li>
                <li>Informasi publik yang tersedia secara legal</li>
              </ul>
            </div>

            <!-- How We Use Information -->
            <div
              class="border-border-site bg-surface mb-8 rounded-2xl border p-8 shadow-lg"
            >
              <h2 class="text-primary-600 mb-6 text-2xl font-bold">
                Bagaimana Kami Menggunakan Informasi
              </h2>

              <h3 class="text-on-site mb-4 text-xl font-semibold">
                Tujuan Penggunaan:
              </h3>
              <ul class="text-on-muted mb-6 list-inside list-disc space-y-2">
                <li>
                  <strong>Penyediaan Layanan:</strong> Memberikan layanan IT, konsultasi,
                  dan solusi teknologi
                </li>
                <li>
                  <strong>Komunikasi:</strong> Merespons pertanyaan, memberikan dukungan
                  pelanggan
                </li>
                <li>
                  <strong>Pemasaran:</strong> Mengirimkan newsletter, update produk,
                  dan informasi relevan
                </li>
                <li>
                  <strong>Peningkatan Layanan:</strong> Menganalisis penggunaan untuk
                  meningkatkan website dan layanan
                </li>
                <li>
                  <strong>Keamanan:</strong> Melindungi dari penipuan, spam, dan
                  aktivitas berbahaya
                </li>
                <li>
                  <strong>Compliance:</strong> Memenuhi kewajiban hukum dan regulasi
                </li>
              </ul>

              <h3 class="text-on-site mb-4 text-xl font-semibold">
                Dasar Hukum Pemrosesan:
              </h3>
              <ul class="text-on-muted list-inside list-disc space-y-2">
                <li>Persetujuan yang Anda berikan</li>
                <li>Pelaksanaan kontrak layanan</li>
                <li>Kepentingan bisnis yang sah</li>
                <li>Kewajiban hukum</li>
              </ul>
            </div>

            <!-- Information Sharing -->
            <div
              class="border-border-site bg-surface mb-8 rounded-2xl border p-8 shadow-lg"
            >
              <h2 class="text-primary-600 mb-6 text-2xl font-bold">
                Pembagian Informasi
              </h2>

              <p class="text-on-muted mb-4 leading-relaxed">
                Kami tidak menjual, menyewakan, atau memperdagangkan informasi
                pribadi Anda kepada pihak ketiga. Kami hanya membagikan
                informasi dalam situasi berikut:
              </p>

              <ul class="text-on-muted mb-6 list-inside list-disc space-y-2">
                <li>
                  <strong>Penyedia Layanan:</strong> Partner teknologi yang membantu
                  operasional (hosting, analytics, email)
                </li>
                <li>
                  <strong>Kewajiban Hukum:</strong> Jika diwajibkan oleh hukum atau
                  proses pengadilan
                </li>
                <li>
                  <strong>Perlindungan Hak:</strong> Untuk melindungi hak, properti,
                  atau keamanan kami dan pengguna
                </li>
                <li>
                  <strong>Persetujuan:</strong> Dengan persetujuan eksplisit Anda
                </li>
                <li>
                  <strong>Transfer Bisnis:</strong> Dalam hal merger, akuisisi, atau
                  penjualan aset
                </li>
              </ul>

              <div class="callout-info">
                <p class="font-medium">
                  <strong>Catatan:</strong> Semua pihak ketiga yang bekerja dengan
                  kami diwajibkan untuk menjaga kerahasiaan dan keamanan informasi
                  Anda sesuai dengan standar yang ketat.
                </p>
              </div>
            </div>

            <!-- Data Security -->
            <div
              class="border-border-site bg-surface mb-8 rounded-2xl border p-8 shadow-lg"
            >
              <h2 class="text-primary-600 mb-6 text-2xl font-bold">
                Keamanan Data
              </h2>

              <p class="text-on-muted mb-4 leading-relaxed">
                Kami menerapkan langkah-langkah keamanan teknis dan organisasi
                yang sesuai untuk melindungi informasi pribadi Anda dari akses
                yang tidak sah, perubahan, pengungkapan, atau penghancuran.
              </p>

              <h3 class="text-on-site mb-4 text-xl font-semibold">
                Langkah Keamanan:
              </h3>
              <ul class="text-on-muted mb-6 list-inside list-disc space-y-2">
                <li>Enkripsi data saat transmisi dan penyimpanan</li>
                <li>Kontrol akses yang ketat dan autentikasi multi-faktor</li>
                <li>Monitoring keamanan 24/7</li>
                <li>Backup data reguler dan disaster recovery plan</li>
                <li>Pelatihan keamanan untuk semua karyawan</li>
                <li>Audit keamanan berkala</li>
              </ul>

              <div class="callout-warning">
                <p class="font-medium">
                  <strong>Penting:</strong> Meskipun kami menerapkan langkah keamanan
                  terbaik, tidak ada sistem yang 100% aman. Kami tidak dapat menjamin
                  keamanan absolut data Anda.
                </p>
              </div>
            </div>

            <!-- Your Rights -->
            <div
              class="border-border-site bg-surface mb-8 rounded-2xl border p-8 shadow-lg"
            >
              <h2 class="text-primary-600 mb-6 text-2xl font-bold">
                Hak-Hak Anda
              </h2>

              <p class="text-on-muted mb-4 leading-relaxed">
                Anda memiliki hak-hak berikut terkait informasi pribadi Anda:
              </p>

              <ul class="text-on-muted mb-6 list-inside list-disc space-y-2">
                <li>
                  <strong>Hak Akses:</strong> Meminta salinan informasi pribadi yang
                  kami miliki
                </li>
                <li>
                  <strong>Hak Koreksi:</strong> Meminta koreksi informasi yang tidak
                  akurat
                </li>
                <li>
                  <strong>Hak Penghapusan:</strong> Meminta penghapusan informasi
                  pribadi Anda
                </li>
                <li>
                  <strong>Hak Pembatasan:</strong> Membatasi pemrosesan informasi
                  Anda
                </li>
                <li>
                  <strong>Hak Portabilitas:</strong> Meminta transfer data ke penyedia
                  layanan lain
                </li>
                <li>
                  <strong>Hak Keberatan:</strong> Menolak pemrosesan untuk tujuan
                  tertentu
                </li>
                <li>
                  <strong>Hak Penarikan Persetujuan:</strong> Menarik persetujuan
                  kapan saja
                </li>
              </ul>

              <div class="callout-success">
                <p class="font-medium">
                  Untuk menggunakan hak-hak ini, hubungi kami di:
                  <a
                    href="mailto:privacy@konxc.space"
                    class="hover:text-secondary-800 underline"
                    >privacy@konxc.space</a
                  >
                </p>
              </div>
            </div>

            <!-- Cookies -->
            <div
              class="border-border-site bg-surface mb-8 rounded-2xl border p-8 shadow-lg"
            >
              <h2 class="text-primary-600 mb-6 text-2xl font-bold">
                Cookies dan Teknologi Pelacakan
              </h2>

              <p class="text-on-muted mb-4 leading-relaxed">
                Kami menggunakan cookies dan teknologi serupa untuk meningkatkan
                pengalaman Anda di website kami.
              </p>

              <h3 class="text-on-site mb-4 text-xl font-semibold">
                Jenis Cookies:
              </h3>
              <ul class="text-on-muted mb-6 list-inside list-disc space-y-2">
                <li>
                  <strong>Essential Cookies:</strong> Diperlukan untuk fungsi dasar
                  website
                </li>
                <li>
                  <strong>Performance Cookies:</strong> Membantu kami memahami penggunaan
                  website
                </li>
                <li>
                  <strong>Functional Cookies:</strong> Mengingat preferensi dan pengaturan
                  Anda
                </li>
                <li>
                  <strong>Marketing Cookies:</strong> Untuk menampilkan konten yang
                  relevan
                </li>
              </ul>

              <p class="text-on-muted leading-relaxed">
                Anda dapat mengontrol cookies melalui pengaturan browser Anda.
                Untuk informasi lebih detail, lihat <a
                  href="/cookie-policy"
                  class="text-primary-600 hover:text-primary-700 underline"
                  >Kebijakan Cookie</a
                > kami.
              </p>
            </div>

            <!-- Data Retention -->
            <div
              class="border-border-site bg-surface mb-8 rounded-2xl border p-8 shadow-lg"
            >
              <h2 class="text-primary-600 mb-6 text-2xl font-bold">
                Penyimpanan Data
              </h2>

              <p class="text-on-muted mb-4 leading-relaxed">
                Kami menyimpan informasi pribadi Anda selama diperlukan untuk
                tujuan yang dijelaskan dalam kebijakan ini, kecuali periode
                penyimpanan yang lebih lama diwajibkan atau diizinkan oleh
                hukum.
              </p>

              <h3 class="text-on-site mb-4 text-xl font-semibold">
                Periode Penyimpanan:
              </h3>
              <ul class="text-on-muted list-inside list-disc space-y-2">
                <li>
                  <strong>Data Pelanggan Aktif:</strong> Selama hubungan bisnis berlangsung
                </li>
                <li>
                  <strong>Data Marketing:</strong> Hingga Anda unsubscribe atau 3
                  tahun
                </li>
                <li>
                  <strong>Data Analytics:</strong> Maksimal 26 bulan (Google Analytics)
                </li>
                <li>
                  <strong>Data Legal:</strong> Sesuai kewajiban hukum (biasanya 7-10
                  tahun)
                </li>
                <li>
                  <strong>Data Backup:</strong> Maksimal 1 tahun untuk tujuan pemulihan
                </li>
              </ul>
            </div>

            <!-- International Transfers -->
            <div
              class="border-border-site bg-surface mb-8 rounded-2xl border p-8 shadow-lg"
            >
              <h2 class="text-primary-600 mb-6 text-2xl font-bold">
                Transfer Data Internasional
              </h2>

              <p class="text-on-muted mb-4 leading-relaxed">
                Beberapa penyedia layanan kami mungkin berlokasi di luar
                Indonesia. Dalam hal ini, kami memastikan bahwa transfer data
                dilakukan dengan perlindungan yang memadai sesuai dengan hukum
                yang berlaku.
              </p>

              <h3 class="text-on-site mb-4 text-xl font-semibold">
                Perlindungan Transfer:
              </h3>
              <ul class="text-on-muted list-inside list-disc space-y-2">
                <li>Kontrak perlindungan data standar</li>
                <li>Sertifikasi keamanan internasional</li>
                <li>Adequacy decisions dari otoritas yang berwenang</li>
                <li>Persetujuan eksplisit untuk transfer sensitif</li>
              </ul>
            </div>

            <!-- Children's Privacy -->
            <div
              class="border-border-site bg-surface mb-8 rounded-2xl border p-8 shadow-lg"
            >
              <h2 class="text-primary-600 mb-6 text-2xl font-bold">
                Privasi Anak-Anak
              </h2>

              <p class="text-on-muted mb-4 leading-relaxed">
                Layanan kami tidak ditujukan untuk anak-anak di bawah usia 13
                tahun. Kami tidak secara sengaja mengumpulkan informasi pribadi
                dari anak-anak di bawah 13 tahun.
              </p>

              <p class="text-on-muted leading-relaxed">
                Jika Anda adalah orang tua atau wali dan mengetahui bahwa anak
                Anda telah memberikan informasi pribadi kepada kami, silakan
                hubungi kami. Kami akan segera menghapus informasi tersebut dari
                sistem kami.
              </p>
            </div>

            <!-- Changes to Policy -->
            <div
              class="border-border-site bg-surface mb-8 rounded-2xl border p-8 shadow-lg"
            >
              <h2 class="text-primary-600 mb-6 text-2xl font-bold">
                Perubahan Kebijakan
              </h2>

              <p class="text-on-muted mb-4 leading-relaxed">
                Kami dapat memperbarui Kebijakan Privasi ini dari waktu ke waktu
                untuk mencerminkan perubahan dalam praktik kami atau untuk
                alasan operasional, hukum, atau regulasi lainnya.
              </p>

              <p class="text-on-muted mb-4 leading-relaxed">
                Perubahan material akan diberitahukan melalui:
              </p>

              <ul class="text-on-muted mb-4 list-inside list-disc space-y-2">
                <li>Pemberitahuan di website kami</li>
                <li>Email kepada pengguna terdaftar</li>
                <li>Notifikasi melalui layanan kami</li>
              </ul>

              <p class="text-on-muted leading-relaxed">
                Penggunaan berkelanjutan layanan kami setelah perubahan berlaku
                menandakan persetujuan Anda terhadap kebijakan yang diperbarui.
              </p>
            </div>

            <!-- Contact Information -->
            <div class="border-border-site bg-muted rounded-2xl border p-8">
              <h2 class="text-primary-600 mb-6 text-2xl font-bold">
                Hubungi Kami
              </h2>

              <p class="text-on-muted mb-6 leading-relaxed">
                Jika Anda memiliki pertanyaan tentang Kebijakan Privasi ini atau
                ingin menggunakan hak-hak Anda, silakan hubungi kami:
              </p>

              <div class="grid gap-6 md:grid-cols-2">
                <div>
                  <h3 class="text-on-site mb-2 font-semibold">
                    PT Koneksi Jaringan Indonesia
                  </h3>
                  <p class="text-on-muted mb-2">Jakarta, Indonesia</p>
                  <p class="text-on-muted mb-2">
                    Email: <a
                      href="mailto:privacy@konxc.space"
                      class="text-primary-600 hover:text-primary-700 underline"
                      >privacy@konxc.space</a
                    >
                  </p>
                  <p class="text-on-muted">
                    Phone: <a
                      href="tel:+6288200795020"
                      class="text-primary-600 hover:text-primary-700 underline"
                      >+62 882 0079 502010</a
                    >
                  </p>
                </div>
                <div>
                  <h3 class="text-on-site mb-2 font-semibold">
                    Data Protection Officer
                  </h3>
                  <p class="text-on-muted mb-2">
                    Email: <a
                      href="mailto:dpo@konxc.space"
                      class="text-primary-600 hover:text-primary-700 underline"
                      >dpo@konxc.space</a
                    >
                  </p>
                  <p class="text-on-muted">
                    Response time: Maksimal 30 hari kerja
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</UnifiedLayout>
