---
import UnifiedLayout from "@/layouts/UnifiedLayout.astro";

const categories = ["Engineering", "Design", "Operations", "Content"];
---

<UnifiedLayout
  title="Karier di Koneksi - Membangun Masa Depan Digital Indonesia"
  description="Bergabunglah dengan tim Koneksi dan berkontribusi langsung dalam mewujudkan Kedaulatan Data Indonesia. Temukan peluang karier di bidang teknologi, manajemen, dan lainnya."
  showNewsletter={false}
  headerVariant="transparent"
>
  <section class="bg-site relative overflow-hidden pt-24 pb-20 md:pt-32">
    <div class="absolute inset-0 -z-10 overflow-hidden opacity-30">
      <div
        class="absolute top-0 right-1/4 h-96 w-96 rounded-full bg-indigo-600/10 blur-[120px] dark:bg-indigo-900/20"
      >
      </div>
    </div>

    <div class="container">
      <div class="max-w-4xl">
        <div
          class="text-primary-500 mb-6 text-xs font-black tracking-[0.4em] uppercase"
        >
          // Recruitment Operations
        </div>
        <h1
          class="text-on-site mb-8 text-6xl font-black tracking-tight uppercase md:text-9xl"
        >
          WORK ON <br />
          <span class="text-gradient px-4 italic">PURPOSE</span>.
        </h1>
        <p class="text-on-muted max-w-2xl text-lg leading-relaxed md:text-xl">
          Bekerja di KonXC bukan hanya tentang menulis kode atau mendesain
          pixel. Ini tentang membangun kedaulatan digital dan memberikan dampak
          nyata bagi jutaan pengguna.
        </p>
      </div>

      <div class="mt-20">
        <div class="mb-12 flex flex-wrap gap-4">
          {
            categories.map((cat) => (
              <button class="hover:border-primary-500 border-border-site bg-muted text-on-muted hover:bg-surface hover:text-on-site rounded-full border px-8 py-3 text-xs font-black tracking-widest uppercase transition-all">
                {cat}
              </button>
            ))
          }
        </div>

        <div
          class="border-border-site bg-surface rounded-[3rem] border p-12 text-center backdrop-blur-md"
        >
          <h3 class="text-on-site mb-4 text-2xl font-black uppercase">
            Looking for something specific?
          </h3>
          <p class="text-on-muted mx-auto mb-8 max-w-xl">
            Posisi terbuka akan diperbarui secara berkala. Jika Anda merasa
            memiliki kemampuan yang bisa memperkuat Squad kami, jangan ragu
            untuk mengirimkan profil Anda.
          </p>
          <a
            href="/contributors/join"
            class="bg-primary-600 inline-block rounded-full px-10 py-4 font-black tracking-widest text-white transition-all hover:scale-105 active:scale-95"
          >
            VIEW SQUAD MISSIONS
          </a>
        </div>
      </div>
    </div>
  </section>
</UnifiedLayout>
