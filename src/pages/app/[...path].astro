---
import BlankLayout from "../../layouts/BlankLayout.astro";

// Exclusive catch-all route for the app ecosystem
export const prerender = false;
---

<BlankLayout
    title="SYSTEM_FAILURE | Konxc Engine"
    description="Diagnostic: User reached an unmapped sector in the Konxc ecosystem."
>
    <div
        class="exclusive-error-container relative flex h-screen min-h-[100dvh] w-full items-center justify-center overflow-hidden bg-[#02020a] text-[#e0e0f0] selection:bg-amber-500/30"
    >
        <!-- Dynamic Cyber Background -->
        <div class="pointer-events-none absolute inset-0 z-0">
            <div
                class="absolute inset-0 bg-[url('/images/grid.svg')] bg-[length:60px_60px] opacity-[0.07]"
            >
            </div>
            <div
                class="absolute top-[10%] left-[10%] h-[45rem] w-[45rem] animate-pulse rounded-full bg-amber-600/[0.07] blur-[120px]"
            >
            </div>
            <div
                class="absolute right-[10%] bottom-[10%] h-[40rem] w-[40rem] animate-pulse rounded-full bg-orange-600/[0.07] blur-[120px]"
                style="animation-delay: 2.5s;"
            >
            </div>
            <div
                class="animate-scanline absolute inset-0 bg-gradient-to-b from-transparent via-white/[0.01] to-transparent bg-[length:100%_4px]"
            >
            </div>
        </div>

        <div
            class="relative z-10 container mx-auto grid max-w-7xl items-center gap-16 px-6 lg:grid-cols-2"
        >
            <div class="order-2 space-y-12 lg:order-1">
                <div
                    class="inline-flex items-center gap-4 rounded-full border border-white/10 bg-white/[0.03] px-5 py-2.5 backdrop-blur-2xl"
                >
                    <div class="relative h-2 w-2">
                        <div
                            class="absolute inset-0 animate-ping rounded-full bg-red-500"
                        >
                        </div>
                        <div class="relative h-2 w-2 rounded-full bg-red-500">
                        </div>
                    </div>
                    <div class="h-4 w-px bg-white/10"></div>
                    <span
                        class="text-[9px] font-black tracking-[0.3em] text-white/40 uppercase"
                        >DIAGNOSTIC_MODE_ACTIVE</span
                    >
                </div>

                <div class="space-y-6">
                    <h1
                        class="bg-gradient-to-b from-white via-white to-white/20 bg-clip-text text-5xl leading-tight font-black tracking-tighter text-transparent md:text-6xl lg:text-7xl xl:text-8xl"
                    >
                        ERR_0X404
                    </h1>
                    <div class="space-y-4">
                        <h2
                            class="text-2xl font-bold tracking-tight text-white md:text-3xl"
                        >
                            Koneksi Sistem Terputus
                        </h2>
                        <p
                            class="max-w-xl text-lg leading-relaxed font-light text-white/50 md:text-xl"
                        >
                            Modul navigasi gagal memetakan rute ini. Target di
                            luar jangkauan Core Engine.
                        </p>
                    </div>
                </div>

                <div
                    class="max-w-lg space-y-3 overflow-hidden rounded-2xl border border-white/10 bg-black/60 p-6 font-mono text-[10px] shadow-2xl backdrop-blur-md md:text-[11px]"
                >
                    <div class="mb-4 flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <div class="flex gap-1.5">
                                <div
                                    class="h-2.5 w-2.5 rounded-full bg-red-500/40"
                                >
                                </div>
                                <div
                                    class="h-2.5 w-2.5 rounded-full bg-yellow-500/40"
                                >
                                </div>
                                <div
                                    class="h-2.5 w-2.5 rounded-full bg-green-500/40"
                                >
                                </div>
                            </div>
                            <span class="ml-1 text-white/20"
                                >system_reboot.sh</span
                            >
                        </div>
                    </div>
                    <div class="space-y-2">
                        <p class="text-amber-500/80">
                            $ initialize system_scan... [DONE]
                        </p>
                        <p class="font-bold text-red-500/70">
                            [FAIL] Sector-0x404: Access Point Null
                        </p>
                        <p class="text-white/50">
                            ... Mounting fallback recovery environment
                        </p>
                        <p class="text-green-500/80">[READY]</p>
                    </div>
                </div>

                <div class="flex flex-col gap-5 pt-4 sm:flex-row">
                    <a
                        href="/app/feed"
                        class="flex items-center justify-center rounded-2xl bg-amber-600 px-10 py-5 text-xs font-black tracking-[0.2em] text-white transition-all duration-300 hover:bg-amber-500"
                    >
                        REBOOT TO DASHBOARD
                    </a>
                    <a
                        href="/"
                        class="flex items-center justify-center rounded-2xl border border-white/10 bg-white/[0.03] px-10 py-5 text-xs font-black tracking-[0.2em] text-white/40 backdrop-blur-md transition-all duration-300 hover:bg-white/[0.08] hover:text-white"
                    >
                        HOMEPAGE.SYS
                    </a>
                </div>
            </div>

            <div
                class="relative order-1 flex items-center justify-center py-10 lg:order-2 lg:py-0"
            >
                <div class="group relative w-full max-w-lg md:max-w-2xl">
                    <div
                        class="relative z-20 max-h-[60vh] overflow-hidden rounded-[4rem] border border-white/10 bg-white/[0.04] backdrop-blur-3xl transition-all duration-1000"
                    >
                        <img
                            src="/images/404/illustration.png"
                            alt="404 Illustration"
                            class="w-full opacity-80 mix-blend-lighten transition-all duration-700 group-hover:opacity-100"
                            style="filter: sepia(1) hue-rotate(-15deg) saturate(3) brightness(0.8);"
                        />
                        <div
                            class="animate-high-scan pointer-events-none absolute inset-0 h-1/4 w-full bg-gradient-to-b from-transparent via-amber-500/20 to-transparent"
                        >
                        </div>
                    </div>

                    <div
                        class="animate-float absolute top-12 -right-8 z-30 rounded-xl bg-amber-600 px-6 py-2.5 font-mono text-[10px] font-black tracking-[0.2em] text-white shadow-2xl"
                    >
                        SYSTEM_ERROR_0x404
                    </div>

                    <div
                        class="animate-float-delayed absolute -bottom-10 -left-6 z-30 rounded-[2rem] border border-white/10 bg-[#0a0a0f]/90 px-8 py-5 shadow-2xl backdrop-blur-2xl"
                    >
                        <p
                            class="mb-2 text-[9px] font-black tracking-[0.3em] text-white/30 uppercase"
                        >
                            System Sync
                        </p>
                        <p
                            class="text-sm font-black tracking-tighter text-amber-500 uppercase italic"
                        >
                            Connection_Lost
                        </p>
                    </div>
                </div>
                <div
                    class="absolute inset-x-0 bottom-0 h-1 rounded-full bg-amber-500/20 shadow-[0_0_100px_40px_rgba(245,158,11,0.1)] blur-[80px]"
                >
                </div>
            </div>
        </div>
    </div>
</BlankLayout>

<style>
    @keyframes scanline {
        0% {
            transform: translateY(-100%);
        }
        100% {
            transform: translateY(100%);
        }
    }
    .animate-scanline {
        animation: scanline 12s linear infinite;
    }

    @keyframes high-scan {
        0% {
            transform: translateY(-100%);
        }
        100% {
            transform: translateY(400%);
        }
    }
    .animate-high-scan {
        animation: high-scan 5s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    }

    @keyframes float {
        0%,
        100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-20px);
        }
    }
    .animate-float {
        animation: float 6s ease-in-out infinite;
    }

    @keyframes float-delayed {
        0%,
        100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(15px);
        }
    }
    .animate-float-delayed {
        animation: float-delayed 8s ease-in-out infinite;
    }
</style>
