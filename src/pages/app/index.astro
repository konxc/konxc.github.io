---
import AppLayout from "../../layouts/AppLayout.astro";
import Logo from "../../components/ui/Logo.astro";

// Splash screen is a client-side experience that redirects to /app/feed
export const prerender = false;
---

<AppLayout title="Memuat | Konxc Community" hideNavbar={true}>
  <div
    class="fixed inset-0 z-[100] flex flex-col items-center justify-center overflow-hidden bg-[var(--app-bg)]"
  >
    <!-- Animated Background Background Circles -->
    <div
      class="pointer-events-none absolute inset-0 overflow-hidden opacity-20 dark:opacity-40"
    >
      <div
        class="absolute -top-20 -left-20 h-96 w-96 animate-pulse rounded-full bg-blue-600 blur-[120px]"
      >
      </div>
      <div
        class="absolute -right-20 -bottom-20 h-80 w-80 animate-pulse rounded-full bg-indigo-600 blur-[100px]"
        style="animation-delay: 1s;"
      >
      </div>
    </div>

    <div class="splash-content relative flex flex-col items-center gap-8">
      <!-- Main Logo with Glow -->
      <div class="group relative">
        <div
          class="absolute -inset-4 animate-pulse rounded-full bg-linear-to-r from-blue-600 to-indigo-600 opacity-25 blur-xl transition-opacity duration-500 group-hover:opacity-50"
        >
        </div>
        <div
          class="relative scale-150 transform transition-transform duration-700 hover:scale-160"
        >
          <Logo size="xl" showText={false} className="shadow-2xl" />
        </div>
      </div>

      <div class="flex flex-col items-center gap-3">
        <h1
          class="animate-shimmer bg-linear-to-r from-blue-600 via-indigo-500 to-blue-600 bg-clip-text text-center text-2xl font-black tracking-tight text-transparent md:text-3xl"
          style="font-family: 'Outfit', sans-serif; background-size: 200% auto;"
        >
          Konxc Community
        </h1>
        <p
          class="letter-spacing-0.1em text-sm font-medium tracking-widest text-[var(--app-text-muted)] uppercase opacity-80"
        >
          Menyambung Ekosistem UMKM Digital
        </p>
      </div>

      <!-- Progressive Loading Bar -->
      <div
        class="mt-4 h-1.5 w-64 overflow-hidden rounded-full bg-gray-200 dark:bg-gray-800"
      >
        <div
          class="splash-progress h-full w-0 bg-linear-to-r from-blue-600 to-indigo-600"
        >
        </div>
      </div>

      <div
        class="mt-2 flex items-center gap-2 text-[10px] font-bold tracking-tighter text-blue-600/60 uppercase dark:text-blue-400/60"
      >
        <span class="animate-bounce">●</span>
        <span>Mempersiapkan Workspace</span>
      </div>
    </div>
  </div>

  <style>
    @keyframes shimmer {
      to {
        background-position: 200% center;
      }
    }
    .animate-shimmer {
      animation: shimmer 3s linear infinite;
    }

    .splash-progress {
      animation: progress 2s cubic-bezier(0.65, 0, 0.35, 1) forwards;
    }

    @keyframes progress {
      0% {
        width: 0%;
      }
      50% {
        width: 70%;
      }
      100% {
        width: 100%;
      }
    }

    .splash-content {
      animation: fadeUp 0.8s ease-out forwards;
    }

    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>

  <script is:inline>
    // Handle the redirect after a short delay for the splash effect
    setTimeout(() => {
      window.location.href = "/app/feed";
    }, 2500);
  </script>
</AppLayout>
