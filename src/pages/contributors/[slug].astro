---
import UnifiedLayout from "@layouts/UnifiedLayout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import Avatar from "@components/ui/Avatar.astro";
import ContributorCard from "@components/contributors/ContributorCard.astro";

type Props = {
  contributor: CollectionEntry<"contributors">;
};

export async function getStaticPaths() {
  const contributors = await getCollection("contributors");
  return contributors.map((contributor: CollectionEntry<"contributors">) => ({
    params: { slug: contributor.id },
    props: { contributor },
  }));
}

const { contributor }: Props = Astro.props;
const { data } = contributor;

const totalContributions =
  data.contributions.blogPosts +
  data.contributions.openSourceProjects.reduce(
    (sum, project) => sum + (project.contributions || 0),
    0,
  ) +
  data.contributions.koneksiProjects.length +
  data.contributions.communityContributions.length;

const joinDate = new Date(data.joinDate).toLocaleDateString("id-ID", {
  year: "numeric",
  month: "long",
});

const allContributors = await getCollection("contributors");
const relatedContributors = allContributors
  .filter((c) => c.id !== contributor.id)
  .filter((c) => c.data.role === data.role)
  .slice(0, 3);

const roleColors: Record<string, string> = {
  developer: "from-blue-600 to-indigo-700",
  designer: "from-pink-600 to-rose-700",
  writer: "from-amber-600 to-orange-700",
  researcher: "from-emerald-600 to-teal-700",
  mentor: "from-purple-600 to-violet-700",
};
const activeGradient =
  roleColors[data.role] || "from-primary-600 to-primary-800";
---

<UnifiedLayout
  title={`${data.name} // Agent Profile`}
  description={data.bio}
  showNewsletter={false}
  headerVariant="transparent"
>
  <!-- 1. Immersive Profile Header -->
  <section
    class="relative min-h-[60vh] overflow-hidden bg-[#0a0a0b] pt-28 pb-20 lg:pt-36 lg:pb-32"
  >
    <!-- Tactical Grid Background -->
    <div
      class="bg-[url('data:image/svg+xml,%3Csvg width=%2240%22 height=%2240%22 viewBox=%220 0 40 40%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cpath d=%22M0 0h40v1H0V0zm0 1h1v39H0V1z%22 fill=%22%23ffffff%22 fill-opacity=%220.02%22/%3E%3C/svg%3E')] absolute inset-0 -z-10 mt-[-1px]"
    >
    </div>

    <div class="relative z-10 container">
      <div class="flex flex-col items-center gap-12 lg:flex-row lg:items-end">
        <!-- Avatar Column -->
        <div class="relative shrink-0">
          <div
            class={`absolute inset-0 rounded-[3rem] bg-gradient-to-br ${activeGradient} blur-2xl opacity-30`}
          >
          </div>
          <div
            class={`relative overflow-hidden rounded-[3rem] p-1.5 bg-gradient-to-br ${activeGradient}`}
          >
            <div class="overflow-hidden rounded-[2.8rem] bg-neutral-900">
              <Avatar
                name={data.name}
                size={240}
                src={data.avatar}
                class="h-60 w-60 object-cover grayscale transition-all duration-700 hover:grayscale-0"
              />
            </div>
          </div>
          {
            data.isActive && (
              <div class="absolute -bottom-4 left-1/2 -translate-x-1/2 rounded-full border border-white/10 bg-green-500/20 px-4 py-1.5 text-[10px] font-black tracking-[0.2em] text-green-400 uppercase backdrop-blur-md">
                Active Agent
              </div>
            )
          }
        </div>

        <!-- Details Column -->
        <div class="flex-1 text-center lg:text-left">
          <div
            class="text-primary-500 mb-4 inline-flex items-center gap-3 text-sm font-black tracking-[0.2em] uppercase"
          >
            <span class="bg-primary-500 h-px w-8"></span>
            {data.role.replace(/-/g, " ")}
          </div>
          <h1
            class="mb-6 text-5xl font-black text-white md:text-8xl lg:text-9xl"
          >
            {data.name.split(" ")[0]}<span class="opacity-20"
              >{data.name.split(" ").slice(1).join(" ")}</span
            >
          </h1>
          <p
            class="max-w-2xl text-lg leading-relaxed text-neutral-400 md:text-xl"
          >
            {data.bio}
          </p>

          <!-- Metadata Pills -->
          <div
            class="mt-10 flex flex-wrap justify-center gap-4 lg:justify-start"
          >
            <div
              class="flex flex-col rounded-2xl border border-white/5 bg-white/5 px-6 py-4 backdrop-blur-md"
            >
              <span
                class="text-[10px] font-bold tracking-widest text-neutral-500 uppercase"
                >Enlisted</span
              >
              <span class="text-xl font-black text-white">{joinDate}</span>
            </div>
            <div
              class="flex flex-col rounded-2xl border border-white/5 bg-white/5 px-6 py-4 backdrop-blur-md"
            >
              <span
                class="text-[10px] font-bold tracking-widest text-neutral-500 uppercase"
                >Rank Impact</span
              >
              <span class="text-xl font-black text-white"
                >#{totalContributions}</span
              >
            </div>
            <div
              class="flex flex-col rounded-2xl border border-white/5 bg-white/5 px-6 py-4 backdrop-blur-md"
            >
              <span
                class="text-[10px] font-bold tracking-widest text-neutral-500 uppercase"
                >OSS Reputation</span
              >
              <span class="text-xl font-black text-white"
                >{data.socialProof.githubStars}✨</span
              >
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Technical Capabilities (Bento) -->
  <section class="border-y border-white/5 bg-[#0a0a0b] py-24">
    <div class="container">
      <div class="grid gap-8 lg:grid-cols-12 lg:grid-rows-2">
        <!-- Expertise Column -->
        <div
          class="rounded-[2.5rem] border border-white/5 bg-white/5 p-10 backdrop-blur-sm lg:col-span-4 lg:row-span-2"
        >
          <h2
            class="mb-8 text-2xl font-black tracking-tighter text-white uppercase"
          >
            Core Capabilities.
          </h2>
          <div class="flex flex-wrap gap-3">
            {
              data.expertise.map((skill) => (
                <span class="hover:bg-primary-500 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-xs font-bold tracking-widest text-neutral-300 uppercase transition-all hover:text-white">
                  {skill}
                </span>
              ))
            }
          </div>

          <hr class="my-10 border-white/5" />

          <h3
            class="mb-6 text-sm font-black tracking-widest text-neutral-500 uppercase"
          >
            Tech Stack
          </h3>
          <div class="grid grid-cols-2 gap-4">
            {
              data.skills.technical.map((skill) => (
                <div class="flex items-center gap-2 text-sm text-neutral-300">
                  <span class="bg-primary-500 h-1.5 w-1.5 rounded-full" />
                  {skill}
                </div>
              ))
            }
          </div>
        </div>

        <!-- Operations Wall (Koneksi Projects) -->
        <div
          class="rounded-[2.5rem] border border-white/5 bg-white/5 p-10 backdrop-blur-sm lg:col-span-8"
        >
          <h2
            class="mb-8 text-2xl font-black tracking-tighter text-white uppercase"
          >
            Sector Operations.
          </h2>
          <div class="grid gap-6 md:grid-cols-2">
            {
              data.contributions.koneksiProjects.map((proj) => (
                <div class="group relative overflow-hidden rounded-2xl border border-white/5 bg-white/5 p-6 transition-all hover:bg-white/10">
                  <div class="mb-2 flex items-center justify-between">
                    <h4 class="font-black tracking-tight text-white uppercase">
                      {proj.name}
                    </h4>
                    <span
                      class={`h-2 w-2 rounded-full ${proj.status === "active" ? "bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.5)]" : "bg-blue-500 opacity-50"}`}
                    />
                  </div>
                  <p class="mb-4 text-xs text-neutral-400">
                    {proj.description}
                  </p>
                  <div class="text-primary-400 text-[10px] font-black tracking-widest uppercase">
                    Assignment: {proj.role}
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Global Impact (Open Source) -->
        <div
          class="rounded-[2.5rem] border border-white/5 bg-white/5 p-10 backdrop-blur-sm lg:col-span-8"
        >
          <h2
            class="mb-8 text-2xl font-black tracking-tighter text-white uppercase"
          >
            Global Deployment.
          </h2>
          <div class="flex flex-wrap gap-8">
            {
              data.contributions.openSourceProjects.map((proj) => (
                <a
                  href={proj.url}
                  target="_blank"
                  class="group flex items-center gap-6"
                >
                  <div class="group-hover:bg-primary-500 flex h-12 w-12 items-center justify-center rounded-2xl bg-white/10 text-2xl transition-colors">
                    ⚡
                  </div>
                  <div>
                    <h4 class="hover:text-primary-400 font-black tracking-tight text-white uppercase transition-colors">
                      {proj.name}
                    </h4>
                    <p class="text-[10px] font-bold tracking-widest text-neutral-500 uppercase">
                      Role: {proj.role}
                    </p>
                  </div>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Tactical Timeline -->
  {
    data.contributions.communityContributions.length > 0 && (
      <section class="bg-[#0a0a0b] py-24">
        <div class="container">
          <h2 class="mb-16 text-center text-4xl font-black tracking-tighter text-white uppercase">
            Mission Log.
          </h2>
          <div class="relative mx-auto max-w-4xl space-y-12 before:absolute before:inset-y-0 before:left-8 before:w-px before:bg-white/5">
            {data.contributions.communityContributions.map((log) => (
              <div class="group relative pl-20 lg:pl-32">
                <div class="border-primary-500 absolute left-6 h-4 w-4 rounded-full border-2 bg-neutral-900 shadow-[0_0_12px_rgba(59,130,246,0.5)] transition-transform group-hover:scale-125" />
                <div class="group-hover:border-primary-500/30 flex flex-col gap-2 rounded-3xl border border-white/5 bg-white/5 p-8 backdrop-blur-md transition-all">
                  <div class="flex items-center justify-between">
                    <span class="text-primary-500 text-[10px] font-black tracking-[0.2em] uppercase">
                      {new Date(log.date).toLocaleDateString("id-ID", {
                        month: "short",
                        year: "numeric",
                      })}
                    </span>
                    <span class="rounded bg-white/5 px-2 py-0.5 text-[8px] font-black tracking-widest text-neutral-400 uppercase">
                      {log.type}
                    </span>
                  </div>
                  <h3 class="text-xl font-bold text-white">{log.title}</h3>
                  <p class="text-sm text-neutral-400">{log.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- 4. Tactical Connections -->
  {
    relatedContributors.length > 0 && (
      <section class="bg-neutral-950 py-32">
        <div class="container">
          <h2 class="mb-12 text-center text-2xl font-black tracking-widest text-white uppercase opacity-50">
            Related Agents.
          </h2>
          <div class="grid gap-8 md:grid-cols-3">
            {relatedContributors.map((c) => (
              <ContributorCard
                contributor={c}
                variant="compact"
                class="border-white/10! bg-white/5!"
              />
            ))}
          </div>

          <div class="mt-20 text-center">
            <a
              href="/contributors"
              class="hover:text-primary-500 inline-flex items-center gap-4 text-xs font-black tracking-[0.3em] text-neutral-500 uppercase transition-colors"
            >
              <span class="h-px w-12 bg-neutral-800" />
              Return to Squad Center
              <span class="h-px w-12 bg-neutral-800" />
            </a>
          </div>
        </div>
      </section>
    )
  }
</UnifiedLayout>

<style>
  :global(body) {
    @apply bg-[#0a0a0b] antialiased;
  }
</style>

<style>
  @reference "@/styles/global.css";
  .contributor-hero {
    @apply relative overflow-hidden;
  }

  .contributor-hero::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
  }

  .contributor-hero .container {
    @apply relative z-10;
  }

  .contributor-avatar-large {
    @apply relative shrink-0;
  }

  .avatar-image {
    @apply h-32 w-32 rounded-full border-4 border-white object-cover shadow-lg;
  }

  .status-indicator-large {
    @apply absolute -right-2 -bottom-2 h-6 w-6 rounded-full border-4 border-white;
  }

  .status-indicator-large.active {
    @apply bg-green-500;
  }

  .status-indicator-large.inactive {
    @apply bg-gray-400;
  }

  .contributor-name-large {
    @apply mb-2 text-4xl font-bold text-neutral-800;
  }

  .contributor-role-large {
    @apply text-primary-600 mb-2 text-xl font-medium;
  }

  .contributor-location-large {
    @apply mb-4 text-lg text-neutral-600;
  }

  .contributor-bio-large {
    @apply mb-6 text-lg text-neutral-700;
  }

  .contributor-meta {
    @apply mb-6 grid grid-cols-3 gap-4;
  }

  .meta-item {
    @apply rounded-lg bg-white p-3 text-center shadow-sm;
  }

  .meta-label {
    @apply mb-1 block text-sm text-neutral-500;
  }

  .meta-value {
    @apply text-primary-600 block text-lg font-bold;
  }

  .social-links-large {
    @apply flex gap-3;
  }

  .social-link-large {
    @apply flex items-center gap-2 rounded-lg bg-white px-4 py-2 text-neutral-600 shadow-sm transition-colors hover:bg-neutral-50;
  }

  .social-link-large.github:hover {
    @apply bg-gray-50 text-gray-600;
  }

  .social-link-large.linkedin:hover {
    @apply bg-blue-50 text-blue-600;
  }

  .social-link-large.twitter:hover {
    @apply bg-blue-50 text-blue-600;
  }

  .social-link-large.website:hover {
    @apply bg-green-50 text-green-600;
  }

  .social-icon-large {
    @apply h-5 w-5;
  }

  .section-title {
    @apply mb-6 text-2xl font-bold text-neutral-800;
  }

  .expertise-grid {
    @apply grid grid-cols-2 gap-3 md:grid-cols-3;
  }

  .expertise-item {
    @apply from-primary-50 to-secondary-50 border-primary-200 rounded-lg border bg-linear-to-br p-3;
  }

  .expertise-skill {
    @apply text-primary-700 text-sm font-medium;
  }

  .projects-grid {
    @apply grid gap-6 md:grid-cols-2;
  }

  .project-card {
    @apply rounded-xl border border-neutral-100 bg-white p-6 shadow-lg transition-all duration-300 hover:shadow-xl;
  }

  .project-card.koneksi {
    @apply border-primary-200 from-primary-50 to-secondary-50 bg-linear-to-br;
  }

  .project-header {
    @apply mb-3 flex items-start justify-between;
  }

  .project-title {
    @apply text-lg font-bold text-neutral-800;
  }

  .project-role {
    @apply bg-primary-100 text-primary-700 rounded-full px-3 py-1 text-xs font-medium;
  }

  .project-role.maintainer {
    @apply bg-green-100 text-green-700;
  }

  .project-status {
    @apply rounded-full px-3 py-1 text-xs font-medium;
  }

  .project-status.active {
    @apply bg-green-100 text-green-700;
  }

  .project-status.completed {
    @apply bg-blue-100 text-blue-700;
  }

  .project-status.archived {
    @apply bg-gray-100 text-gray-700;
  }

  .project-description {
    @apply mb-3 text-neutral-600;
  }

  .project-stats {
    @apply mb-4 flex gap-4;
  }

  .project-stat {
    @apply text-center;
  }

  .project-stat .stat-number {
    @apply text-primary-600 block text-lg font-bold;
  }

  .project-stat .stat-label {
    @apply block text-xs text-neutral-500;
  }

  .project-dates {
    @apply mb-4 space-y-1;
  }

  .project-date {
    @apply block text-sm text-neutral-500;
  }

  .project-link {
    @apply bg-primary-500 hover:bg-primary-600 inline-flex items-center gap-2 rounded-lg px-4 py-2 text-sm font-medium text-white transition-colors;
  }

  .community-timeline {
    @apply space-y-6;
  }

  .timeline-item {
    @apply flex gap-4;
  }

  .timeline-marker {
    @apply shrink-0;
  }

  .timeline-icon {
    @apply bg-primary-100 text-primary-600 flex h-10 w-10 items-center justify-center rounded-full text-lg;
  }

  .timeline-content {
    @apply flex-1;
  }

  .timeline-title {
    @apply mb-2 text-lg font-bold text-neutral-800;
  }

  .timeline-description {
    @apply mb-3 text-neutral-600;
  }

  .timeline-meta {
    @apply flex gap-4;
  }

  .timeline-date {
    @apply text-sm text-neutral-500;
  }

  .timeline-impact {
    @apply rounded px-2 py-1 text-xs font-medium;
  }

  .timeline-impact.high {
    @apply bg-green-100 text-green-700;
  }

  .timeline-impact.medium {
    @apply bg-yellow-100 text-yellow-700;
  }

  .timeline-impact.low {
    @apply bg-gray-100 text-gray-700;
  }

  .achievements-grid {
    @apply grid gap-6 md:grid-cols-2;
  }

  .achievement-card {
    @apply rounded-xl border border-neutral-100 bg-white p-6 shadow-lg;
  }

  .achievement-header {
    @apply mb-3 flex items-start justify-between;
  }

  .achievement-title {
    @apply text-lg font-bold text-neutral-800;
  }

  .achievement-verified {
    @apply text-xs font-medium text-green-600;
  }

  .achievement-description {
    @apply mb-3 text-neutral-600;
  }

  .achievement-meta {
    @apply flex gap-4;
  }

  .achievement-date {
    @apply text-sm text-neutral-500;
  }

  .achievement-category {
    @apply rounded px-2 py-1 text-xs font-medium;
  }

  .achievement-category.technical {
    @apply bg-blue-100 text-blue-700;
  }

  .achievement-category.community {
    @apply bg-green-100 text-green-700;
  }

  .achievement-category.leadership {
    @apply bg-purple-100 text-purple-700;
  }

  .achievement-category.innovation {
    @apply bg-orange-100 text-orange-700;
  }

  .sidebar-content {
    @apply space-y-6;
  }

  .availability-card,
  .skills-card,
  .social-proof-card {
    @apply rounded-xl border border-neutral-100 bg-white p-6 shadow-lg;
  }

  .card-title {
    @apply mb-4 text-lg font-bold text-neutral-800;
  }

  .availability-list {
    @apply space-y-3;
  }

  .availability-item {
    @apply flex items-center gap-3;
  }

  .availability-icon {
    @apply text-lg;
  }

  .availability-text {
    @apply text-sm font-medium text-neutral-700;
  }

  .timezone-info {
    @apply mt-3 text-xs text-neutral-500;
  }

  .skills-breakdown {
    @apply space-y-4;
  }

  .skill-category {
    @apply space-y-2;
  }

  .skill-category-title {
    @apply text-sm font-semibold text-neutral-700;
  }

  .skill-tags {
    @apply flex flex-wrap gap-2;
  }

  .skill-tag {
    @apply rounded px-2 py-1 text-xs font-medium;
  }

  .skill-tag.technical {
    @apply bg-blue-100 text-blue-700;
  }

  .skill-tag.soft {
    @apply bg-green-100 text-green-700;
  }

  .skill-tag.language {
    @apply bg-purple-100 text-purple-700;
  }

  .social-proof-stats {
    @apply grid grid-cols-2 gap-4;
  }

  .proof-stat {
    @apply from-primary-50 to-secondary-50 rounded-lg bg-linear-to-br p-3 text-center;
  }

  .proof-number {
    @apply text-primary-600 block text-lg font-bold;
  }

  .proof-label {
    @apply block text-xs text-neutral-600;
  }

  /* Dark mode styles */
  .dark .contributor-hero {
    @apply from-primary-900 to-secondary-900;
  }

  .dark .contributor-name-large {
    @apply text-neutral-100;
  }

  .dark .contributor-bio-large {
    @apply text-neutral-300;
  }

  .dark .meta-item {
    @apply bg-neutral-700;
  }

  .dark .social-link-large {
    @apply bg-neutral-700 text-neutral-300;
  }

  .dark .section-title {
    @apply text-neutral-100;
  }

  .dark .project-card {
    @apply border-neutral-700 bg-neutral-800;
  }

  .dark .project-title {
    @apply text-neutral-100;
  }

  .dark .timeline-title {
    @apply text-neutral-100;
  }

  .dark .achievement-card {
    @apply border-neutral-700 bg-neutral-800;
  }

  .dark .achievement-title {
    @apply text-neutral-100;
  }

  .dark .availability-card,
  .dark .skills-card,
  .dark .social-proof-card {
    @apply border-neutral-700 bg-neutral-800;
  }

  .dark .card-title {
    @apply text-neutral-100;
  }

  /* Mobile responsive */
  @media (max-width: 768px) {
    .contributor-hero .flex {
      @apply flex-col text-center;
    }

    .contributor-meta {
      @apply grid-cols-1 gap-3;
    }

    .social-links-large {
      @apply justify-center;
    }

    .expertise-grid {
      @apply grid-cols-1;
    }

    .projects-grid {
      @apply grid-cols-1;
    }

    .achievements-grid {
      @apply grid-cols-1;
    }
  }
</style>
