---
import UnifiedLayout from "@/layouts/UnifiedLayout.astro";

const missions = [
  {
    role: "Core Developer",
    focus: "Cloud & Infrastructure",
    brief:
      "Membangun tulang punggung ekosistem KonXC menggunakan teknologi cloud-native dan arsitektur skalabel.",
    requirements: ["Go / Rust / Node.js", "Kubernetes", "API Design"],
  },
  {
    role: "Open Source Advocate",
    focus: "Community Growth",
    brief:
      "Mengelola proyek sumber terbuka dan membantu komunitas pengembang untuk berkontribusi secara efektif.",
    requirements: ["Git Proficiency", "Technical Writing", "Mentoring"],
  },
  {
    role: "Elite Scribe",
    focus: "Technical Content",
    brief:
      "Mendokumentasikan inovasi dan berbagi pengetahuan melalui artikel riset mendalam di KonXC Blog.",
    requirements: ["Deep Tech Insights", "Content Strategy", "Storytelling"],
  },
];
---

<UnifiedLayout
  title="Join The Squad - Kontributor KonXC"
  description="Siap menulis sejarah teknologi Indonesia berikutnya? Bergabunglah dengan barisan kontributor elit KonXC."
  showNewsletter={false}
  headerVariant="transparent"
  theme="dark"
>
  <!-- 1. Tactical Briefing Hero -->
  <section
    class="relative flex min-h-[80vh] items-center overflow-hidden pt-24 pb-20 md:pt-32"
  >
    <div class="absolute inset-0 -z-10 bg-[#0a0a0b]">
      {/* Cinematic Scanline Effect */}
      <div
        class="pointer-events-none absolute inset-0 bg-[linear-gradient(rgba(18,16,16,0)_50%,rgba(0,0,0,0.25)_50%),linear-gradient(90deg,rgba(255,0,0,0.06),rgba(0,255,0,0.02),rgba(0,0,255,0.06))] bg-[length:100%_2px,3px_100%] opacity-20"
      >
      </div>
      <div
        class="bg-primary-600/10 absolute top-1/2 left-1/2 h-[600px] w-[600px] -translate-x-1/2 -translate-y-1/2 rounded-full blur-[180px]"
      >
      </div>
    </div>

    <div class="relative z-10 container">
      <div class="mx-auto max-w-4xl text-center">
        <div
          class="border-primary-500/30 bg-primary-500/10 text-primary-400 mb-8 inline-flex items-center gap-3 rounded-md border px-4 py-1.5 text-[10px] font-black tracking-[0.4em] uppercase backdrop-blur-sm"
        >
          Transmission: Recruitment Open
        </div>
        <h1
          class="mb-8 text-6xl font-black tracking-tight text-white md:text-9xl"
        >
          WRITE THE <span
            class="from-primary-400 inline-block bg-gradient-to-r to-indigo-500 bg-clip-text px-4 text-transparent italic"
            >NEXT</span
          > CHAPTER.
        </h1>
        <p
          class="mx-auto max-w-2xl text-lg leading-relaxed text-neutral-300 md:text-xl"
        >
          Kami tidak mencari karyawan. Kami mencari rekan jejak yang siap
          berkolaborasi membangun ekosistem teknologi yang memberdayakan
          Indonesia.
        </p>

        <div class="mt-12 flex justify-center">
          <div class="animate-bounce">
            <svg
              class="text-primary-500 h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Active Missions (Roles) -->
  <section class="bg-[#0a0a0b] py-24">
    <div class="container">
      <div class="mb-20 text-center">
        <h2
          class="text-3xl font-black tracking-tighter text-white uppercase md:text-5xl"
        >
          Available Missions.
        </h2>
        <div class="bg-primary-600 mx-auto mt-4 h-1 w-24"></div>
      </div>

      <div class="grid gap-8 md:grid-cols-3">
        {
          missions.map((mission) => (
            <div class="group hover:border-primary-500/30 relative flex flex-col rounded-[2rem] border border-white/5 bg-white/5 p-10 backdrop-blur-md transition-all hover:bg-white/[0.08]">
              <div class="text-primary-500 mb-4 text-[10px] font-black tracking-widest uppercase">
                {mission.focus}
              </div>
              <h3 class="group-hover:text-primary-400 mb-6 text-2xl font-black text-white transition-colors">
                {mission.role}
              </h3>
              <p class="mb-8 text-sm leading-relaxed text-neutral-400">
                {mission.brief}
              </p>

              <div class="mt-auto space-y-4">
                <div class="h-px w-full bg-white/10" />
                <div class="flex flex-wrap gap-2">
                  {mission.requirements.map((req) => (
                    <span class="text-[9px] font-bold text-neutral-500 uppercase">
                      // {req}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 3. The Onboarding Process -->
  <section class="bg-[#0f0f12] py-32">
    <div class="container">
      <div class="grid items-center gap-20 lg:grid-cols-2">
        <div>
          <div
            class="text-primary-500 mb-6 inline-flex items-center gap-2 text-[10px] font-black tracking-[0.4em] uppercase"
          >
            <span class="bg-primary-500 h-px w-8"></span>
            Pipeline Protocol
          </div>
          <h2
            class="mb-12 text-5xl font-black tracking-tight text-white uppercase"
          >
            The Onboarding <br />
            <span class="text-primary-500 italic">Logic</span>.
          </h2>

          <div class="relative space-y-12">
            {/* Connecting Line */}
            <div
              class="from-primary-500/50 via-primary-500/20 absolute top-2 bottom-2 left-4 w-px bg-gradient-to-b to-transparent"
            >
            </div>

            {
              [
                {
                  step: "01",
                  title: "Digital Ping",
                  desc: "Kirimkan profil atau portfolio Anda melalui kanal komunikasi kami.",
                },
                {
                  step: "02",
                  title: "Tactical Alignment",
                  desc: "Diskusi santai tentang visi dan bagaimana Anda bisa berkontribusi.",
                },
                {
                  step: "03",
                  title: "Active Deployment",
                  desc: "Mulai berkontribusi pada proyek aktif atau inisiatif baru.",
                },
              ].map((item) => (
                <div class="group relative flex gap-10">
                  <div class="border-primary-500/30 text-primary-500 group-hover:border-primary-500 relative z-10 flex h-9 w-9 shrink-0 items-center justify-center rounded-full border bg-[#0f0f12] text-[10px] font-black transition-all group-hover:shadow-[0_0_15px_rgba(59,130,246,0.3)]">
                    {item.step}
                  </div>
                  <div class="pt-1">
                    <h4 class="group-hover:text-primary-400 mb-2 text-lg font-black tracking-tight text-white uppercase transition-colors">
                      {item.title}
                    </h4>
                    <p class="max-w-md text-sm leading-relaxed text-neutral-400">
                      {item.desc}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <div class="relative">
          {/* Decorative Elements */}
          <div
            class="border-primary-500/20 absolute -top-4 -right-4 h-24 w-24 rounded-tr-3xl border-t-2 border-r-2"
          >
          </div>
          <div
            class="border-primary-500/20 absolute -bottom-4 -left-4 h-24 w-24 rounded-bl-3xl border-b-2 border-l-2"
          >
          </div>

          <div
            class="relative overflow-hidden rounded-[3rem] border border-white/5 bg-white/5 p-12 backdrop-blur-xl"
          >
            {/* Terminal Header */}
            <div
              class="mb-10 flex items-center gap-2 border-b border-white/5 pb-4"
            >
              <div class="flex gap-1.5">
                <div class="h-2 w-2 rounded-full bg-red-500/40"></div>
                <div class="h-2 w-2 rounded-full bg-amber-500/40"></div>
                <div class="h-2 w-2 rounded-full bg-emerald-500/40"></div>
              </div>
              <div
                class="ml-4 text-[9px] font-black tracking-widest text-neutral-500 uppercase"
              >
                secure_node_01.exec
              </div>
            </div>

            <div
              class="absolute top-0 right-0 -z-10 h-full w-full bg-[radial-gradient(circle_at_70%_30%,rgba(59,130,246,0.15)_0%,transparent_60%)]"
            >
            </div>

            <blockquote class="mb-10">
              <p class="text-3xl leading-tight font-black text-white italic">
                "Technology is just the tool. The people using it are the <span
                  class="text-primary-500">architects</span
                > of change."
              </p>
            </blockquote>

            <div class="flex items-center gap-5">
              <div class="relative">
                <div class="bg-primary-500 absolute inset-0 opacity-20 blur-md">
                </div>
                <div
                  class="from-primary-600 relative flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br to-indigo-700 font-black text-white"
                >
                  KX
                </div>
              </div>
              <div>
                <div
                  class="text-xs font-black tracking-widest text-white uppercase"
                >
                  System Intelligence
                </div>
                <div
                  class="text-primary-500 mt-1 text-[9px] font-bold tracking-[0.2em] uppercase"
                >
                  Kernel v4.0.2 // STABLE
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Final CTA -->
  <section class="py-32">
    <div class="container text-center">
      <h2 class="mb-12 text-5xl font-black text-white md:text-7xl">
        READY FOR DEPLOYMENT?
      </h2>
      <div class="flex flex-col justify-center gap-6 sm:flex-row">
        <a
          href="https://wa.me/62882007952010"
          class="group text-primary-600 relative flex items-center justify-center gap-3 overflow-hidden rounded-full bg-white px-12 py-5 font-black tracking-widest transition-all hover:scale-105 hover:shadow-2xl"
        >
          <span class="relative z-10">CONTACT VIA WHATSAPP</span>
          <svg
            class="relative z-10 h-5 w-5 transition-transform group-hover:translate-x-1"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
        <a
          href="mailto:hello@konxc.space"
          class="flex items-center justify-center gap-3 rounded-full border-2 border-white/30 px-12 py-5 font-black tracking-widest text-white transition-all hover:bg-white/10"
        >
          SEND AN EMAIL
        </a>
      </div>
      <p
        class="mt-12 text-xs font-bold tracking-widest text-neutral-600 uppercase"
      >
        *Response time may vary based on mission complexity.
      </p>
    </div>
  </section>

  <style>
    @reference "@/styles/global.css";

    :global(body) {
      @apply bg-[#0a0a0b] antialiased;
    }

    section {
      @apply relative overflow-hidden;
    }
  </style>
</UnifiedLayout>
