---
import UnifiedLayout from "@/layouts/UnifiedLayout.astro";

const faqs = [
  {
    kategori: "General",
    questions: [
      {
        q: "Apa itu KonXC?",
        a: "KonXC adalah kolektif inovator dan penyedia layanan teknologi terintegrasi yang berfokus pada pembangunan ekosistem digital Indonesia.",
      },
      {
        q: "Bagaimana cara bekerja sama dengan KonXC?",
        a: "Anda dapat memulai konsultasi melalui halaman Kontak atau langsung menghubungi kami melalui WhatsApp untuk respon cepat.",
      },
    ],
  },
  {
    kategori: "Kontributor",
    questions: [
      {
        q: "Siapa saja yang bisa menjadi kontributor?",
        a: "Siapapun yang memiliki passion di bidang teknologi, mulai dari developer, desainer, hingga penulis teknis.",
      },
      {
        q: "Apa keuntungan menjadi bagian dari The Squad?",
        a: "Akses ke network eksklusif, kesempatan mengerjakan proyek berdampak besar, dan pengembangan portofolio profesional.",
      },
    ],
  },
];
---

<UnifiedLayout
  title="FAQ - Pertanyaan Umum KonXC"
  description="Temukan jawaban atas pertanyaan yang paling sering diajukan mengenai layanan dan komunitas KonXC."
  headerVariant="transparent"
>
  <section class="bg-site relative overflow-hidden pt-24 pb-20 md:pt-32">
    <div class="absolute inset-0 -z-10 overflow-hidden opacity-30">
      <div
        class="bg-primary-500/10 dark:bg-primary-900/20 absolute top-0 right-1/4 h-96 w-96 rounded-full blur-[120px]"
      >
      </div>
    </div>
    <div class="container">
      <div class="max-w-3xl">
        <h1
          class="text-on-site mb-12 text-5xl font-black tracking-tighter uppercase md:text-8xl"
        >
          FREQUENTLY <br />
          <span class="text-gradient-accent italic">ASKED</span>.
        </h1>

        <div class="space-y-16">
          {
            faqs.map((cat) => (
              <div>
                <h2 class="border-border-site text-on-muted mb-8 border-b pb-4 text-xs font-black tracking-[0.4em] uppercase">
                  {cat.kategori}
                </h2>
                <div class="space-y-6">
                  {cat.questions.map((item) => (
                    <div class="group border-border-site bg-surface hover:bg-muted rounded-3xl border p-8 transition-all">
                      <h4 class="group-hover:text-primary-500 text-on-site mb-4 text-lg font-black tracking-tight uppercase transition-colors">
                        {item.q}
                      </h4>
                      <p class="text-on-muted text-sm leading-relaxed">
                        {item.a}
                      </p>
                    </div>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</UnifiedLayout>
