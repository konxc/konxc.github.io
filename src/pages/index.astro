---
import CorporateView from "../components/views/CorporateView.astro";
import PortfolioView from "../components/views/PortfolioView.astro";

// Fallback to 'corporate' if PUBLIC_SITE_MODE is not defined
const mode = import.meta.env.PUBLIC_SITE_MODE || "corporate";
---

{mode === "portfolio" ? <PortfolioView /> : <CorporateView />}
