---
import UnifiedLayout from "@layouts/UnifiedLayout.astro";
import { Icon } from "astro-icon/components";
---

<UnifiedLayout
  title="Tentang Koneksi - Membangun Kedaulatan Data Indonesia"
  description="Koneksi adalah gerakan untuk membangun ekosistem digital Indonesia yang mandiri. Dengan tiga pilar utama: SDM berkualitas, kondusifitas bisnis, dan dukungan politik - kita wujudkan Kedaulatan Data Indonesia."
  showNewsletter={false}
  theme="dark"
  headerVariant="transparent"
>
  <!-- Hero Section - Cinematic Dark Style -->
  <section
    class="relative flex min-h-[90vh] items-center justify-center overflow-hidden bg-[#0a0a0c] pt-28 lg:pt-36"
  >
    <!-- Tactical Background Layers -->
    <div class="absolute inset-0 z-0">
      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_50%_-20%,rgba(239,68,68,0.15)_0%,transparent_50%)]"
      >
      </div>
      <div
        class="absolute inset-0 bg-[url('/images/grid-pattern.svg')] bg-center opacity-[0.03]"
      >
      </div>
      <div
        class="absolute top-1/4 left-1/4 h-96 w-96 rounded-full bg-red-600/10 blur-[120px]"
      >
      </div>
      <div
        class="absolute right-1/4 bottom-1/4 h-96 w-96 rounded-full bg-indigo-600/10 blur-[120px]"
      >
      </div>
    </div>

    <div class="relative z-10 container">
      <div class="mx-auto max-w-5xl text-center">
        <div
          class="mb-10 inline-flex items-center gap-3 rounded-full border border-red-500/20 bg-red-500/5 px-4 py-2 backdrop-blur-md"
        >
          <div class="h-2 w-2 animate-pulse rounded-full bg-red-500"></div>
          <span
            class="text-[10px] font-black tracking-[0.3em] text-red-400 uppercase"
          >
            Strategic Protocol // Kedaulatan Data
          </span>
        </div>

        <h1
          class="mb-8 text-5xl font-black tracking-tight text-white uppercase md:text-8xl lg:text-9xl"
        >
          Eksosistem <br />
          <span
            class="inline-block bg-gradient-to-r from-red-500 via-rose-500 to-amber-500 bg-clip-text px-4 text-transparent italic"
            >Berdaulat</span
          >.
        </h1>

        <p
          class="mx-auto mb-16 max-w-2xl text-lg leading-relaxed font-medium text-neutral-400 md:text-xl"
        >
          Indonesia memerlukan kemandirian teknologi yang matang. <br
            class="hidden md:block"
          />
          Membangun masa depan digital yang tidak lagi bergantung sepenuhnya pada
          <span class="text-white">infrastruktur asing</span>.
        </p>

        <!-- Stats Grid with Tactical Look -->
        <div
          class="mb-20 grid grid-cols-2 gap-px overflow-hidden rounded-3xl border border-white/5 bg-white/5 backdrop-blur-sm md:grid-cols-4"
        >
          {
            [
              { label: "Cloud Asing", value: "85%", icon: "heroicons:cloud" },
              {
                label: "Talent Pool",
                value: "12M+",
                icon: "heroicons:academic-cap",
              },
              {
                label: "Populasi Net",
                value: "270M",
                icon: "heroicons:globe-alt",
              },
              {
                label: "Target 2030",
                value: "DEPLY",
                icon: "heroicons:rocket-launch",
              },
            ].map((stat) => (
              <div class="group flex flex-col items-center bg-[#0a0a0c]/80 p-8 transition-colors hover:bg-neutral-900">
                <Icon
                  name={stat.icon}
                  class="mb-4 h-5 w-5 text-neutral-600 transition-colors group-hover:text-red-500"
                />
                <div class="text-3xl font-black text-white">{stat.value}</div>
                <div class="mt-1 text-[10px] font-bold tracking-widest text-neutral-500 uppercase">
                  {stat.label}
                </div>
              </div>
            ))
          }
        </div>

        <div class="mb-20 flex flex-col justify-center gap-6 sm:flex-row">
          <a
            href="#visi-misi"
            class="group relative overflow-hidden rounded-xl bg-red-600 px-8 py-4 font-black text-white transition-all hover:bg-red-700"
          >
            <span class="relative z-10 flex items-center gap-3">
              Pelajari Visi <Icon
                name="heroicons:arrow-right"
                class="h-4 w-4 transition-transform group-hover:translate-x-1"
              />
            </span>
          </a>
          <a
            href="#tiga-pilar"
            class="rounded-xl border border-white/10 px-8 py-4 font-black text-white transition-all hover:bg-white/5"
          >
            Tiga Pilar Kedaulatan
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Visi & Misi Section -->
  <section id="visi-misi" class="bg-[#0f0f12] py-24 md:py-32">
    <div class="container">
      <div class="mb-20 text-center">
        <h2
          class="mb-6 text-4xl font-black tracking-tight text-white uppercase md:text-5xl"
        >
          Visi & <span
            class="bg-gradient-to-r from-red-500 to-rose-600 bg-clip-text text-transparent italic"
            >Misi</span
          >
        </h2>
        <p class="mx-auto max-w-2xl text-lg text-neutral-400">
          Indonesia memiliki potensi luar biasa untuk menjadi kekuatan digital
          global. Kedaulatan tidak datang dengan sendirinya — ia harus dibangun.
        </p>
      </div>

      <div class="grid items-center gap-16 lg:grid-cols-2">
        <!-- Visi -->
        <div class="space-y-10">
          <div
            class="group relative overflow-hidden rounded-[2.5rem] border border-white/5 bg-white/5 p-10 backdrop-blur-md"
          >
            <div
              class="absolute inset-0 bg-gradient-to-br from-red-600/10 to-transparent opacity-0 transition-opacity group-hover:opacity-100"
            >
            </div>
            <div class="relative z-10">
              <div class="mb-8 flex items-center">
                <div
                  class="mr-6 flex h-14 w-14 items-center justify-center rounded-2xl bg-red-600 text-white shadow-[0_0_20px_rgba(220,38,38,0.4)]"
                >
                  <Icon name="heroicons:eye" class="h-7 w-7" />
                </div>
                <h3
                  class="text-3xl font-black tracking-tight text-white uppercase"
                >
                  Visi
                </h3>
              </div>
              <p class="text-xl leading-relaxed text-neutral-300">
                <span class="font-bold text-white">Menjadi katalis utama</span> dalam
                mewujudkan <span class="font-black text-red-500"
                  >Kedaulatan Data Indonesia</span
                > melalui ekosistem digital yang mandiri dan inovatif.
              </p>
            </div>
          </div>

          <div
            class="group relative overflow-hidden rounded-[2.5rem] border border-white/5 bg-white/5 p-10 backdrop-blur-md"
          >
            <div
              class="absolute inset-0 bg-gradient-to-br from-indigo-600/10 to-transparent opacity-0 transition-opacity group-hover:opacity-100"
            >
            </div>
            <div class="relative z-10">
              <div class="mb-8 flex items-center">
                <div
                  class="mr-6 flex h-14 w-14 items-center justify-center rounded-2xl bg-indigo-600 text-white shadow-[0_0_20px_rgba(79,70,229,0.4)]"
                >
                  <Icon name="heroicons:rocket-launch" class="h-7 w-7" />
                </div>
                <h3
                  class="text-3xl font-black tracking-tight text-white uppercase"
                >
                  Misi
                </h3>
              </div>
              <ul class="space-y-4 text-neutral-300">
                {
                  [
                    "Mempersiapkan SDM teknologi Indonesia world-class",
                    "Menciptakan kondusifitas bisnis startup lokal",
                    "Mendorong kebijakan politik kedaulatan digital",
                    "Membangun infrastruktur cloud dalam negeri",
                  ].map((misi) => (
                    <li class="flex items-center gap-4">
                      <div class="h-1.5 w-1.5 rounded-full bg-indigo-500" />
                      <span class="font-medium">{misi}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>

        <!-- Ilustrasi Ekosistem -->
        <div class="relative">
          <div
            class="absolute -inset-4 -z-10 rounded-[3rem] border border-white/5 bg-white/2"
          >
          </div>
          <div
            class="rounded-[3rem] border border-white/10 bg-neutral-900/50 p-12 backdrop-blur-xl"
          >
            <h4
              class="mb-10 text-center text-sm font-black tracking-[0.4em] text-neutral-500 uppercase"
            >
              Sovereignty Network
            </h4>

            <!-- Indonesia di Tengah -->
            <div class="relative mb-12 flex items-center justify-center">
              <div class="absolute inset-0 rounded-full bg-red-600/20 blur-3xl">
              </div>
              <div
                class="relative flex h-36 w-36 items-center justify-center rounded-full border-2 border-white/20 bg-gradient-to-br from-red-600 to-rose-700 shadow-[0_0_40px_rgba(220,38,38,0.3)]"
              >
                <div class="text-center text-white">
                  <Icon name="heroicons:flag" class="mx-auto mb-2 h-8 w-8" />
                  <div class="text-[10px] font-black tracking-widest uppercase">
                    ID_CORE
                  </div>
                </div>
              </div>
            </div>

            <!-- Orbit Ekosistem -->
            <div class="grid grid-cols-2 gap-4">
              {
                [
                  {
                    label: "Infrastructure",
                    name: "Cloud Lokal",
                    icon: "heroicons:cloud",
                    color: "text-blue-400",
                  },
                  {
                    label: "Open Source",
                    name: "Tech Stack",
                    icon: "heroicons:cpu-chip",
                    color: "text-emerald-400",
                  },
                  {
                    label: "Engineering",
                    name: "Talent Pool",
                    icon: "heroicons:academic-cap",
                    color: "text-purple-400",
                  },
                  {
                    label: "Innovation",
                    name: "Startup Hub",
                    icon: "heroicons:building-office",
                    color: "text-orange-400",
                  },
                ].map((item) => (
                  <div class="group rounded-2xl border border-white/5 bg-white/5 p-4 text-center transition-all hover:border-white/20">
                    <Icon
                      name={item.icon}
                      class={`mx-auto mb-2 h-6 w-6 ${item.color}`}
                    />
                    <div class="text-sm font-black tracking-tight text-white">
                      {item.name}
                    </div>
                    <div class="mt-1 text-[8px] font-bold tracking-widest text-neutral-500 uppercase">
                      {item.label}
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Tiga Pilar Kedaulatan -->
  <section id="tiga-pilar" class="bg-[#0a0a0c] py-24 md:py-32">
    <div class="container">
      <div class="mb-20 text-center">
        <h2
          class="mb-6 text-4xl font-black tracking-tight text-white uppercase md:text-5xl"
        >
          Tiga <span class="text-red-500">Pilar</span> Utama
        </h2>
        <p class="mx-auto max-w-2xl text-lg text-neutral-400">
          Tiga motor penggerak kedaulatan digital. Jika salah satu lumpuh, maka
          infrastruktur lainnya tidak akan berarti apa-apa.
        </p>
      </div>

      <div class="grid gap-8 lg:grid-cols-3">
        {
          [
            {
              title: "Pilar SDM",
              subtitle: "Technical Mastery",
              icon: "heroicons:academic-cap",
              bg: "bg-blue-600/20",
              text: "text-blue-500",
              desc: "Mempersiapkan talenta teknologi Indonesia yang world-class, mandiri, dan bangga pada karya lokal.",
              impact: "1M+ Talents by 2030",
            },
            {
              title: "Pilar Bisnis",
              subtitle: "Economic Growth",
              icon: "heroicons:building-office-2",
              bg: "bg-emerald-600/20",
              text: "text-emerald-500",
              desc: "Membangun ekosistem bisnis yang kondusif agar tech-startup lokal dapat bersaing dengan raksasa global.",
              impact: "Sustainable Ecosystem",
            },
            {
              title: "Pilar Politik",
              subtitle: "State Regulation",
              icon: "heroicons:building-library",
              bg: "bg-red-600/20",
              text: "text-red-500",
              desc: "Kebijakan politik yang berpihak pada kedaulatan digital melalui regulasi data dan infrastruktur nasional.",
              impact: "Data Sovereignty Law",
            },
          ].map((pilar) => (
            <div class="group relative overflow-hidden rounded-3xl border border-white/10 bg-white/5 p-1 transition-all hover:border-white/20">
              <div class="h-full rounded-[1.4rem] bg-[#0f0f12] p-8">
                <div
                  class={`mb-6 flex h-16 w-16 items-center justify-center rounded-2xl ${pilar.bg} ${pilar.text} transition-all group-hover:scale-110`}
                >
                  <Icon name={pilar.icon} class="h-8 w-8" />
                </div>
                <h3 class="text-2xl font-black tracking-tight text-white uppercase">
                  {pilar.title}
                </h3>
                <p
                  class={`mb-4 text-sm font-bold ${pilar.text} tracking-widest uppercase`}
                >
                  {pilar.subtitle}
                </p>
                <p class="mb-8 leading-relaxed font-medium text-neutral-400">
                  {pilar.desc}
                </p>
                <div class="border-t border-white/5 pt-6">
                  <div class="mb-1 text-[10px] font-black tracking-[0.2em] text-neutral-600 uppercase">
                    Projected Impact
                  </div>
                  <div class={`text-lg font-black ${pilar.text}`}>
                    {pilar.impact}
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
    <!-- Interconnection Visualization -->
    <div class="mt-24 text-center">
      <div
        class="mx-auto max-w-3xl rounded-[2.5rem] border border-white/5 bg-white/2 p-12 backdrop-blur-sm"
      >
        <h4
          class="mb-6 text-2xl font-black tracking-tight text-white uppercase"
        >
          Sinergi Tiga Pilar
        </h4>
        <p class="mb-10 leading-relaxed font-medium text-neutral-400">
          Ketiga pilar ini saling terkait dan memperkuat. Tanpa salah satu,
          kedaulatan digital hanyalah sekadar wacana.
        </p>

        <div class="flex items-center justify-center space-x-6">
          <div
            class="flex h-14 w-14 items-center justify-center rounded-2xl border border-blue-500/30 bg-blue-600/20"
          >
            <Icon name="heroicons:academic-cap" class="h-7 w-7 text-blue-500" />
          </div>
          <Icon name="heroicons:plus" class="h-4 w-4 text-neutral-600" />
          <div
            class="flex h-14 w-14 items-center justify-center rounded-2xl border border-emerald-500/30 bg-emerald-600/20"
          >
            <Icon
              name="heroicons:building-office-2"
              class="h-7 w-7 text-emerald-500"
            />
          </div>
          <Icon name="heroicons:plus" class="h-4 w-4 text-neutral-600" />
          <div
            class="flex h-14 w-14 items-center justify-center rounded-2xl border border-red-500/30 bg-red-600/20"
          >
            <Icon
              name="heroicons:building-library"
              class="h-7 w-7 text-red-500"
            />
          </div>
          <Icon name="heroicons:equals" class="h-4 w-4 text-neutral-600" />
          <div
            class="flex h-14 w-20 items-center justify-center rounded-2xl bg-gradient-to-r from-red-600 to-rose-700 shadow-[0_0_20px_rgba(220,38,38,0.3)]"
          >
            <Icon name="heroicons:flag" class="h-8 w-8 text-white" />
          </div>
        </div>

        <div
          class="mt-8 text-[11px] font-black tracking-[0.3em] text-neutral-500 uppercase"
        >
          SDM + Bisnis + Politik = Kedaulatan Digital
        </div>
      </div>
    </div>
  </section>

  <!-- Mengapa Kedaulatan Data Penting -->
  <section class="bg-[#0f0f12] py-24 md:py-32">
    <div class="container">
      <div class="mb-20 text-center">
        <h2
          class="mb-6 text-4xl font-black tracking-tight text-white uppercase md:text-5xl"
        >
          Urgensi <span
            class="bg-gradient-to-r from-amber-500 to-orange-600 bg-clip-text text-transparent italic"
            >Kedaulatan</span
          >
        </h2>
        <p class="mx-auto max-w-2xl text-lg text-neutral-400">
          Data adalah aset paling berharga di era digital. Siapa yang menguasai
          data, menguasai masa depan kedaulatan bangsa.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          [
            {
              title: "Keamanan Nasional",
              icon: "heroicons:shield-check",
              bg: "bg-red-600/20",
              text: "text-red-500",
              desc: "Data warga negara dan infrastruktur kritis harus berada di bawah jurisdiksi nasional.",
            },
            {
              title: "Ekonomi Digital",
              icon: "heroicons:currency-dollar",
              bg: "bg-emerald-600/20",
              text: "text-emerald-500",
              desc: "Nilai ekonomi data harus kembali ke Indonesia, bukan mengalir keluar tanpa kontribusi.",
            },
            {
              title: "Inovasi Lokal",
              icon: "heroicons:light-bulb",
              bg: "bg-blue-600/20",
              text: "text-blue-500",
              desc: "Ketersediaan data lokal mendorong startup untuk membangun solusi yang relevan.",
            },
            {
              title: "Privasi Warga",
              icon: "heroicons:lock-closed",
              bg: "bg-purple-600/20",
              text: "text-purple-500",
              desc: "Hak privasi dilindungi oleh hukum Indonesia, bukan kebijakan perusahaan asing.",
            },
            {
              title: "Ketahanan Tech",
              icon: "heroicons:server",
              bg: "bg-orange-600/20",
              text: "text-orange-500",
              desc: "Kemandirian infrastruktur memastikan keberlangsungan layanan publik saat terjadi eskalasi.",
            },
            {
              title: "Daya Saing",
              icon: "heroicons:globe-asia-australia",
              bg: "bg-teal-600/20",
              text: "text-teal-500",
              desc: "Indonesia tampil sebagai subjek teknologi di panggung global, bukan sekadar objek pasar.",
            },
          ].map((item) => (
            <div class="rounded-[2rem] border border-white/5 bg-white/2 p-8 transition-colors hover:bg-white/5">
              <div
                class={`mb-6 flex h-12 w-12 items-center justify-center rounded-xl ${item.bg} ${item.text}`}
              >
                <Icon name={item.icon} class="h-6 w-6" />
              </div>
              <h3 class="mb-3 text-xl font-bold tracking-tight text-white">
                {item.title}
              </h3>
              <p class="text-sm leading-relaxed font-medium text-neutral-400">
                {item.desc}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <section class="relative overflow-hidden py-32">
    <div class="absolute inset-0 bg-gradient-to-br from-red-600 to-[#120505]">
    </div>
    <div
      class="pointer-events-none absolute inset-0 bg-[url('/images/noise.png')] opacity-20"
    >
    </div>

    <div class="relative z-10 container">
      <div class="mx-auto max-w-4xl text-center">
        <h2
          class="mb-8 text-5xl font-black tracking-tighter text-white uppercase md:text-7xl"
        >
          Join the <br />
          <span class="text-rose-200 italic">Revolution</span>.
        </h2>
        <p
          class="mx-auto mb-12 max-w-2xl text-xl leading-relaxed font-medium text-rose-50/80"
        >
          Kedaulatan tidak akan tercapai tanpa partisipasi aktif setiap elemen
          bangsa. Setiap kontribusi adalah langkah menuju kemandirian.
        </p>

        <div class="mb-16 grid gap-8 md:grid-cols-3">
          {
            [
              {
                label: "Engineering",
                title: "Untuk Developer",
                icon: "heroicons:code-bracket",
              },
              {
                label: "Growth",
                title: "Untuk Bisnis",
                icon: "heroicons:building-office",
              },
              {
                label: "Ecosystem",
                title: "Untuk Masyarakat",
                icon: "heroicons:megaphone",
              },
            ].map((role) => (
              <div class="rounded-2xl border border-white/10 bg-white/5 p-6 text-center backdrop-blur-md">
                <Icon
                  name={role.icon}
                  class="mx-auto mb-4 h-8 w-8 text-rose-300"
                />
                <h3 class="mb-2 text-lg font-black tracking-tight text-white uppercase">
                  {role.title}
                </h3>
                <div class="text-[10px] font-bold tracking-widest text-rose-200/60 uppercase">
                  {role.label}
                </div>
              </div>
            ))
          }
        </div>

        <div class="flex flex-col justify-center gap-6 sm:flex-row">
          <a
            href="/contributors/join"
            class="rounded-xl bg-white px-8 py-4 font-black text-red-600 shadow-xl transition-all hover:bg-neutral-100"
          >
            Bergabung Sekarang
          </a>
          <a
            href="/projects"
            class="rounded-xl border border-white/30 px-8 py-4 font-black text-white backdrop-blur-md transition-all hover:bg-white/10"
          >
            Lihat Lighthouse Projects
          </a>
        </div>
      </div>
    </div>
  </section>

  <style>
    html {
      scroll-behavior: smooth;
    }
  </style>
</UnifiedLayout>
