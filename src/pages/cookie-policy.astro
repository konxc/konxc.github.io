---
import UnifiedLayout from "@layouts/UnifiedLayout.astro";

const title = "Kebijakan Cookie | KonXC - PT Koneksi Jaringan Indonesia";
const description =
  "Kebijakan cookie KonXC menjelaskan bagaimana kami menggunakan cookies dan teknologi pelacakan serupa untuk meningkatkan pengalaman Anda.";
---

<UnifiedLayout
  title={title}
  description={description}
  headerVariant="default"
  footerVariant="extended"
  showNewsletter={false}
>
  <main class="min-h-screen bg-neutral-50">
    <!-- Hero Section -->
    <section class="section from-secondary-50 to-primary-50 bg-gradient-to-br">
      <div class="container">
        <div class="mx-auto max-w-4xl text-center">
          <h1 class="mb-6 text-4xl font-bold lg:text-5xl">
            Kebijakan <span class="text-gradient">Cookie</span>
          </h1>
          <p class="mb-8 text-xl text-neutral-600">
            Informasi tentang penggunaan cookies dan teknologi pelacakan di
            website kami
          </p>
          <div
            class="border-secondary-100 rounded-2xl border bg-white p-6 shadow-lg"
          >
            <p class="text-sm text-neutral-600">
              <strong>Terakhir diperbarui:</strong> 25 Oktober 2024
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Content Section -->
    <section class="section">
      <div class="container">
        <div class="mx-auto max-w-4xl">
          <div class="prose prose-lg max-w-none">
            <!-- Introduction -->
            <div
              class="mb-8 rounded-2xl border border-neutral-100 bg-white p-8 shadow-lg"
            >
              <h2 class="text-secondary-700 mb-4 text-2xl font-bold">
                Apa itu Cookie?
              </h2>
              <p class="mb-4 leading-relaxed text-neutral-600">
                Cookie adalah file teks kecil yang disimpan di perangkat Anda
                (komputer, tablet, atau smartphone) ketika Anda mengunjungi
                website. Cookie membantu website mengingat informasi tentang
                kunjungan Anda, seperti preferensi bahasa dan pengaturan
                lainnya.
              </p>
              <p class="mb-4 leading-relaxed text-neutral-600">
                PT Koneksi Jaringan Indonesia ("KonXC", "kami") menggunakan
                cookies dan teknologi serupa di website <strong
                  >konxc.space</strong
                > untuk meningkatkan pengalaman pengguna, menganalisis traffic, dan
                menyediakan konten yang relevan.
              </p>
              <div
                class="bg-secondary-50 border-secondary-200 rounded-xl border p-4"
              >
                <p class="text-secondary-700 font-medium">
                  <strong>Penting:</strong> Dengan melanjutkan penggunaan website
                  kami, Anda menyetujui penggunaan cookies sesuai dengan kebijakan
                  ini.
                </p>
              </div>
            </div>

            <!-- Types of Cookies -->
            <div
              class="mb-8 rounded-2xl border border-neutral-100 bg-white p-8 shadow-lg"
            >
              <h2 class="text-secondary-700 mb-6 text-2xl font-bold">
                Jenis-Jenis Cookie yang Kami Gunakan
              </h2>

              <!-- Essential Cookies -->
              <div class="mb-8">
                <div class="mb-4 flex items-center">
                  <div class="mr-3 h-4 w-4 rounded-full bg-red-500"></div>
                  <h3 class="text-xl font-semibold text-neutral-800">
                    1. Essential Cookies (Wajib)
                  </h3>
                </div>
                <p class="mb-4 leading-relaxed text-neutral-600">
                  Cookie yang diperlukan untuk fungsi dasar website. Tanpa
                  cookie ini, website tidak dapat berfungsi dengan baik.
                </p>
                <div class="rounded-xl bg-neutral-50 p-4">
                  <h4 class="mb-2 font-semibold text-neutral-700">
                    Contoh Penggunaan:
                  </h4>
                  <ul class="list-inside list-disc space-y-1 text-neutral-600">
                    <li>Menjaga sesi login Anda</li>
                    <li>Mengingat item dalam keranjang belanja</li>
                    <li>Memastikan keamanan dan mencegah penipuan</li>
                    <li>Menyimpan preferensi bahasa</li>
                  </ul>
                </div>
                <p class="mt-2 text-sm text-neutral-500">
                  <strong>Durasi:</strong> Session cookies (dihapus saat browser
                  ditutup) atau hingga 1 tahun
                </p>
              </div>

              <!-- Performance Cookies -->
              <div class="mb-8">
                <div class="mb-4 flex items-center">
                  <div class="mr-3 h-4 w-4 rounded-full bg-yellow-500"></div>
                  <h3 class="text-xl font-semibold text-neutral-800">
                    2. Performance Cookies (Analitik)
                  </h3>
                </div>
                <p class="mb-4 leading-relaxed text-neutral-600">
                  Cookie yang mengumpulkan informasi tentang bagaimana
                  pengunjung menggunakan website kami. Informasi ini membantu
                  kami meningkatkan performa website.
                </p>
                <div class="rounded-xl bg-neutral-50 p-4">
                  <h4 class="mb-2 font-semibold text-neutral-700">
                    Yang Kami Kumpulkan:
                  </h4>
                  <ul class="list-inside list-disc space-y-1 text-neutral-600">
                    <li>Halaman yang paling sering dikunjungi</li>
                    <li>Waktu yang dihabiskan di setiap halaman</li>
                    <li>Pesan error yang mungkin Anda terima</li>
                    <li>Pola navigasi pengguna</li>
                  </ul>
                </div>
                <div
                  class="mt-4 rounded-xl border border-blue-200 bg-blue-50 p-4"
                >
                  <p class="text-sm text-blue-700">
                    <strong>Google Analytics:</strong> Kami menggunakan Google Analytics
                    untuk analisis website. Data dikumpulkan secara anonim dan tidak
                    dapat digunakan untuk mengidentifikasi Anda secara personal.
                  </p>
                </div>
                <p class="mt-2 text-sm text-neutral-500">
                  <strong>Durasi:</strong> Hingga 26 bulan
                </p>
              </div>

              <!-- Functional Cookies -->
              <div class="mb-8">
                <div class="mb-4 flex items-center">
                  <div class="mr-3 h-4 w-4 rounded-full bg-blue-500"></div>
                  <h3 class="text-xl font-semibold text-neutral-800">
                    3. Functional Cookies (Fungsional)
                  </h3>
                </div>
                <p class="mb-4 leading-relaxed text-neutral-600">
                  Cookie yang mengingat pilihan yang Anda buat dan menyediakan
                  fitur yang lebih personal.
                </p>
                <div class="rounded-xl bg-neutral-50 p-4">
                  <h4 class="mb-2 font-semibold text-neutral-700">
                    Fitur yang Didukung:
                  </h4>
                  <ul class="list-inside list-disc space-y-1 text-neutral-600">
                    <li>Mengingat username untuk login</li>
                    <li>Menyimpan preferensi tampilan (dark/light mode)</li>
                    <li>Mengingat pilihan bahasa</li>
                    <li>Menyimpan pengaturan font size</li>
                    <li>Mengingat lokasi geografis untuk konten lokal</li>
                  </ul>
                </div>
                <p class="mt-2 text-sm text-neutral-500">
                  <strong>Durasi:</strong> Hingga 2 tahun
                </p>
              </div>

              <!-- Marketing Cookies -->
              <div class="mb-8">
                <div class="mb-4 flex items-center">
                  <div class="mr-3 h-4 w-4 rounded-full bg-green-500"></div>
                  <h3 class="text-xl font-semibold text-neutral-800">
                    4. Marketing Cookies (Pemasaran)
                  </h3>
                </div>
                <p class="mb-4 leading-relaxed text-neutral-600">
                  Cookie yang digunakan untuk menampilkan iklan yang relevan
                  dengan minat Anda dan mengukur efektivitas kampanye pemasaran
                  kami.
                </p>
                <div class="rounded-xl bg-neutral-50 p-4">
                  <h4 class="mb-2 font-semibold text-neutral-700">
                    Tujuan Penggunaan:
                  </h4>
                  <ul class="list-inside list-disc space-y-1 text-neutral-600">
                    <li>Menampilkan iklan yang relevan di website lain</li>
                    <li>Membatasi frekuensi iklan yang sama</li>
                    <li>Mengukur efektivitas kampanye iklan</li>
                    <li>Menyediakan konten yang dipersonalisasi</li>
                  </ul>
                </div>
                <div
                  class="mt-4 rounded-xl border border-green-200 bg-green-50 p-4"
                >
                  <p class="text-sm text-green-700">
                    <strong>Catatan:</strong> Anda dapat menolak marketing cookies
                    tanpa mempengaruhi fungsi dasar website kami.
                  </p>
                </div>
                <p class="mt-2 text-sm text-neutral-500">
                  <strong>Durasi:</strong> Hingga 1 tahun
                </p>
              </div>
            </div>

            <!-- Third Party Cookies -->
            <div
              class="mb-8 rounded-2xl border border-neutral-100 bg-white p-8 shadow-lg"
            >
              <h2 class="text-secondary-700 mb-6 text-2xl font-bold">
                Cookie Pihak Ketiga
              </h2>

              <p class="mb-6 leading-relaxed text-neutral-600">
                Selain cookie yang kami set langsung, website kami juga
                menggunakan cookie dari pihak ketiga untuk menyediakan layanan
                tambahan.
              </p>

              <div class="grid gap-6 md:grid-cols-2">
                <!-- Google Analytics -->
                <div class="rounded-xl bg-neutral-50 p-6">
                  <div class="mb-4 flex items-center">
                    <div
                      class="mr-3 flex h-8 w-8 items-center justify-center rounded-lg bg-blue-500"
                    >
                      <span class="text-sm font-bold text-white">G</span>
                    </div>
                    <h3 class="font-semibold text-neutral-800">
                      Google Analytics
                    </h3>
                  </div>
                  <p class="mb-3 text-sm text-neutral-600">
                    Menganalisis penggunaan website dan memberikan insights
                    tentang perilaku pengunjung.
                  </p>
                  <ul class="space-y-1 text-xs text-neutral-500">
                    <li>• Cookie: _ga, _gid, _gat</li>
                    <li>• Durasi: 2 tahun</li>
                    <li>
                      • <a
                        href="https://policies.google.com/privacy"
                        target="_blank"
                        class="text-blue-600 underline">Privacy Policy</a
                      >
                    </li>
                  </ul>
                </div>

                <!-- Google Fonts -->
                <div class="rounded-xl bg-neutral-50 p-6">
                  <div class="mb-4 flex items-center">
                    <div
                      class="mr-3 flex h-8 w-8 items-center justify-center rounded-lg bg-red-500"
                    >
                      <span class="text-sm font-bold text-white">F</span>
                    </div>
                    <h3 class="font-semibold text-neutral-800">Google Fonts</h3>
                  </div>
                  <p class="mb-3 text-sm text-neutral-600">
                    Menyediakan font web untuk meningkatkan tampilan dan
                    performa website.
                  </p>
                  <ul class="space-y-1 text-xs text-neutral-500">
                    <li>• Cookie: font-related cookies</li>
                    <li>• Durasi: 1 tahun</li>
                    <li>
                      • <a
                        href="https://policies.google.com/privacy"
                        target="_blank"
                        class="text-blue-600 underline">Privacy Policy</a
                      >
                    </li>
                  </ul>
                </div>

                <!-- Social Media -->
                <div class="rounded-xl bg-neutral-50 p-6">
                  <div class="mb-4 flex items-center">
                    <div
                      class="mr-3 flex h-8 w-8 items-center justify-center rounded-lg bg-purple-500"
                    >
                      <span class="text-sm font-bold text-white">S</span>
                    </div>
                    <h3 class="font-semibold text-neutral-800">Social Media</h3>
                  </div>
                  <p class="mb-3 text-sm text-neutral-600">
                    Widget dan tombol share dari platform media sosial
                    (LinkedIn, Twitter, Facebook).
                  </p>
                  <ul class="space-y-1 text-xs text-neutral-500">
                    <li>• Cookie: Platform-specific</li>
                    <li>• Durasi: Bervariasi</li>
                    <li>• Lihat privacy policy masing-masing platform</li>
                  </ul>
                </div>

                <!-- CDN Services -->
                <div class="rounded-xl bg-neutral-50 p-6">
                  <div class="mb-4 flex items-center">
                    <div
                      class="mr-3 flex h-8 w-8 items-center justify-center rounded-lg bg-orange-500"
                    >
                      <span class="text-sm font-bold text-white">C</span>
                    </div>
                    <h3 class="font-semibold text-neutral-800">CDN Services</h3>
                  </div>
                  <p class="mb-3 text-sm text-neutral-600">
                    Content Delivery Network untuk mempercepat loading website
                    dan optimasi performa.
                  </p>
                  <ul class="space-y-1 text-xs text-neutral-500">
                    <li>• Cookie: Performance-related</li>
                    <li>• Durasi: Session atau 1 tahun</li>
                    <li>• Tujuan: Optimasi performa</li>
                  </ul>
                </div>
              </div>
            </div>

            <!-- Cookie Management -->
            <div
              class="mb-8 rounded-2xl border border-neutral-100 bg-white p-8 shadow-lg"
            >
              <h2 class="text-secondary-700 mb-6 text-2xl font-bold">
                Mengelola Cookie
              </h2>

              <h3 class="mb-4 text-xl font-semibold text-neutral-800">
                Pengaturan Browser
              </h3>
              <p class="mb-4 leading-relaxed text-neutral-600">
                Anda dapat mengontrol dan mengelola cookie melalui pengaturan
                browser Anda. Berikut cara mengatur cookie di browser populer:
              </p>

              <div class="mb-6 grid gap-6 md:grid-cols-2">
                <div class="rounded-xl bg-neutral-50 p-4">
                  <h4 class="mb-2 font-semibold text-neutral-700">
                    Google Chrome
                  </h4>
                  <ol class="space-y-1 text-sm text-neutral-600">
                    <li>1. Klik menu (⋮) → Settings</li>
                    <li>2. Privacy and security → Cookies</li>
                    <li>3. Pilih pengaturan yang diinginkan</li>
                  </ol>
                </div>
                <div class="rounded-xl bg-neutral-50 p-4">
                  <h4 class="mb-2 font-semibold text-neutral-700">
                    Mozilla Firefox
                  </h4>
                  <ol class="space-y-1 text-sm text-neutral-600">
                    <li>1. Klik menu (☰) → Settings</li>
                    <li>2. Privacy & Security</li>
                    <li>3. Cookies and Site Data</li>
                  </ol>
                </div>
                <div class="rounded-xl bg-neutral-50 p-4">
                  <h4 class="mb-2 font-semibold text-neutral-700">Safari</h4>
                  <ol class="space-y-1 text-sm text-neutral-600">
                    <li>1. Safari → Preferences</li>
                    <li>2. Privacy tab</li>
                    <li>3. Cookies and website data</li>
                  </ol>
                </div>
                <div class="rounded-xl bg-neutral-50 p-4">
                  <h4 class="mb-2 font-semibold text-neutral-700">
                    Microsoft Edge
                  </h4>
                  <ol class="space-y-1 text-sm text-neutral-600">
                    <li>1. Menu (⋯) → Settings</li>
                    <li>2. Cookies and site permissions</li>
                    <li>3. Cookies and site data</li>
                  </ol>
                </div>
              </div>

              <h3 class="mb-4 text-xl font-semibold text-neutral-800">
                Opt-out dari Tracking
              </h3>
              <p class="mb-4 leading-relaxed text-neutral-600">
                Anda juga dapat opt-out dari tracking tertentu melalui:
              </p>

              <ul class="mb-6 list-inside list-disc space-y-2 text-neutral-600">
                <li>
                  <strong>Google Analytics:</strong>
                  <a
                    href="https://tools.google.com/dlpage/gaoptout"
                    target="_blank"
                    class="text-secondary-600 hover:text-secondary-700 underline"
                  >
                    Google Analytics Opt-out Browser Add-on
                  </a>
                </li>
                <li>
                  <strong>Network Advertising Initiative:</strong>
                  <a
                    href="https://www.networkadvertising.org/choices/"
                    target="_blank"
                    class="text-secondary-600 hover:text-secondary-700 underline"
                  >
                    NAI Opt-out Tool
                  </a>
                </li>
                <li>
                  <strong>Digital Advertising Alliance:</strong>
                  <a
                    href="https://www.aboutads.info/choices/"
                    target="_blank"
                    class="text-secondary-600 hover:text-secondary-700 underline"
                  >
                    DAA Opt-out Tool
                  </a>
                </li>
              </ul>

              <div
                class="bg-warning-50 border-warning-200 rounded-xl border p-4"
              >
                <p class="text-warning-700 font-medium">
                  <strong>Catatan:</strong> Menonaktifkan cookie tertentu dapat mempengaruhi
                  fungsi dan pengalaman Anda di website kami.
                </p>
              </div>
            </div>

            <!-- Mobile Devices -->
            <div
              class="mb-8 rounded-2xl border border-neutral-100 bg-white p-8 shadow-lg"
            >
              <h2 class="text-secondary-700 mb-6 text-2xl font-bold">
                Cookie di Perangkat Mobile
              </h2>

              <p class="mb-6 leading-relaxed text-neutral-600">
                Untuk perangkat mobile, Anda dapat mengelola cookie melalui
                pengaturan browser mobile atau menggunakan pengaturan privasi
                sistem operasi.
              </p>

              <div class="grid gap-6 md:grid-cols-2">
                <div class="rounded-xl bg-neutral-50 p-6">
                  <h3 class="mb-4 font-semibold text-neutral-800">
                    iOS (iPhone/iPad)
                  </h3>
                  <ol class="space-y-2 text-sm text-neutral-600">
                    <li>1. Settings → Safari</li>
                    <li>2. Privacy & Security</li>
                    <li>3. Block All Cookies (untuk memblokir semua)</li>
                    <li>4. Atau pilih "Prevent Cross-Site Tracking"</li>
                  </ol>
                  <div class="mt-4 rounded-lg bg-blue-50 p-3">
                    <p class="text-xs text-blue-700">
                      <strong>App Tracking:</strong> Settings → Privacy → Tracking
                      untuk mengontrol tracking antar aplikasi.
                    </p>
                  </div>
                </div>

                <div class="rounded-xl bg-neutral-50 p-6">
                  <h3 class="mb-4 font-semibold text-neutral-800">Android</h3>
                  <ol class="space-y-2 text-sm text-neutral-600">
                    <li>1. Chrome: Menu → Settings → Site settings</li>
                    <li>2. Cookies → pilih pengaturan</li>
                    <li>3. Atau Settings → Privacy → Ads</li>
                    <li>4. "Opt out of Ads Personalization"</li>
                  </ol>
                  <div class="mt-4 rounded-lg bg-green-50 p-3">
                    <p class="text-xs text-green-700">
                      <strong>Google Ads:</strong> Kunjungi
                      <a href="https://adssettings.google.com" class="underline"
                        >Google Ads Settings</a
                      >
                      untuk mengontrol iklan yang dipersonalisasi.
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Cookie Consent -->
            <div
              class="mb-8 rounded-2xl border border-neutral-100 bg-white p-8 shadow-lg"
            >
              <h2 class="text-secondary-700 mb-6 text-2xl font-bold">
                Persetujuan Cookie
              </h2>

              <p class="mb-4 leading-relaxed text-neutral-600">
                Ketika Anda pertama kali mengunjungi website kami, Anda akan
                melihat banner cookie yang meminta persetujuan Anda untuk
                penggunaan cookie non-essential.
              </p>

              <h3 class="mb-4 text-xl font-semibold text-neutral-800">
                Pilihan Persetujuan
              </h3>
              <div class="mb-6 space-y-4">
                <div class="flex items-start">
                  <div
                    class="mt-1 mr-3 flex h-6 w-6 items-center justify-center rounded-full bg-green-500"
                  >
                    <span class="text-xs text-white">✓</span>
                  </div>
                  <div>
                    <h4 class="font-semibold text-neutral-800">Accept All</h4>
                    <p class="text-sm text-neutral-600">
                      Menyetujui semua jenis cookie termasuk marketing dan
                      tracking cookies.
                    </p>
                  </div>
                </div>
                <div class="flex items-start">
                  <div
                    class="mt-1 mr-3 flex h-6 w-6 items-center justify-center rounded-full bg-blue-500"
                  >
                    <span class="text-xs text-white">⚙</span>
                  </div>
                  <div>
                    <h4 class="font-semibold text-neutral-800">
                      Customize Settings
                    </h4>
                    <p class="text-sm text-neutral-600">
                      Memilih jenis cookie yang ingin Anda izinkan secara
                      individual.
                    </p>
                  </div>
                </div>
                <div class="flex items-start">
                  <div
                    class="mt-1 mr-3 flex h-6 w-6 items-center justify-center rounded-full bg-red-500"
                  >
                    <span class="text-xs text-white">✗</span>
                  </div>
                  <div>
                    <h4 class="font-semibold text-neutral-800">Reject All</h4>
                    <p class="text-sm text-neutral-600">
                      Menolak semua cookie non-essential. Essential cookies
                      tetap aktif.
                    </p>
                  </div>
                </div>
              </div>

              <h3 class="mb-4 text-xl font-semibold text-neutral-800">
                Mengubah Preferensi
              </h3>
              <p class="mb-4 leading-relaxed text-neutral-600">
                Anda dapat mengubah preferensi cookie Anda kapan saja dengan:
              </p>
              <ul class="list-inside list-disc space-y-2 text-neutral-600">
                <li>Klik link "Cookie Settings" di footer website</li>
                <li>Menghapus cookie melalui pengaturan browser</li>
                <li>
                  Menghubungi kami di <a
                    href="mailto:privacy@konxc.space"
                    class="text-secondary-600 underline">privacy@konxc.space</a
                  >
                </li>
              </ul>
            </div>

            <!-- Impact of Disabling -->
            <div
              class="mb-8 rounded-2xl border border-neutral-100 bg-white p-8 shadow-lg"
            >
              <h2 class="text-secondary-700 mb-6 text-2xl font-bold">
                Dampak Menonaktifkan Cookie
              </h2>

              <p class="mb-6 leading-relaxed text-neutral-600">
                Menonaktifkan cookie dapat mempengaruhi pengalaman Anda di
                website kami:
              </p>

              <div class="grid gap-6 md:grid-cols-2">
                <div class="rounded-xl border border-red-200 bg-red-50 p-6">
                  <h3 class="mb-4 font-semibold text-red-700">
                    Jika Essential Cookies Dinonaktifkan
                  </h3>
                  <ul class="space-y-2 text-sm text-red-600">
                    <li>• Website mungkin tidak berfungsi dengan baik</li>
                    <li>• Tidak dapat login atau menjaga sesi</li>
                    <li>• Form kontak mungkin tidak bekerja</li>
                    <li>• Pengaturan tidak tersimpan</li>
                  </ul>
                </div>

                <div
                  class="rounded-xl border border-yellow-200 bg-yellow-50 p-6"
                >
                  <h3 class="mb-4 font-semibold text-yellow-700">
                    Jika Non-Essential Cookies Dinonaktifkan
                  </h3>
                  <ul class="space-y-2 text-sm text-yellow-600">
                    <li>• Tidak ada personalisasi konten</li>
                    <li>• Analytics tidak dapat melacak kunjungan</li>
                    <li>• Iklan mungkin kurang relevan</li>
                    <li>• Fitur social media terbatas</li>
                  </ul>
                </div>
              </div>
            </div>

            <!-- Updates to Policy -->
            <div
              class="mb-8 rounded-2xl border border-neutral-100 bg-white p-8 shadow-lg"
            >
              <h2 class="text-secondary-700 mb-6 text-2xl font-bold">
                Pembaruan Kebijakan
              </h2>

              <p class="mb-4 leading-relaxed text-neutral-600">
                Kami dapat memperbarui Kebijakan Cookie ini dari waktu ke waktu
                untuk mencerminkan perubahan dalam teknologi, hukum, atau
                praktik bisnis kami.
              </p>

              <p class="mb-4 leading-relaxed text-neutral-600">
                Perubahan akan diberitahukan melalui:
              </p>

              <ul class="mb-6 list-inside list-disc space-y-2 text-neutral-600">
                <li>
                  Update tanggal "Terakhir diperbarui" di bagian atas halaman
                </li>
                <li>Pemberitahuan di website untuk perubahan material</li>
                <li>Email kepada pengguna terdaftar jika diperlukan</li>
              </ul>

