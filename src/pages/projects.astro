---
import UnifiedLayout from "@/layouts/UnifiedLayout.astro";

const projects = [
  {
    title: "SLiMS (Senayan Library Management System)",
    category: "Open Source / Government",
    description:
      "Sistem pengelolaan perpustakaan standar nasional yang telah didigitalisasi di lebih dari 50,000 instansi di Indonesia.",
    tags: ["PHP", "MySQL", "Digital Assets"],
    impact: "50K+ Nodes",
    image: "/images/projects/slims.webp",
    link: "https://slims.web.id",
  },
  {
    title: "DracOS Linux",
    category: "Security / Open Source",
    description:
      "Distribusi Linux karya anak bangsa yang fokus pada penetration testing dan riset keamanan siber.",
    tags: ["Kernel", "Pentest Tools", "Bash"],
    impact: "10K+ Users",
    image: "/images/projects/dracos.webp",
    link: "https://dracos-linux.org",
  },
  {
    title: "OpenSID",
    category: "Open Gov / Web",
    description:
      "Platform digitalisasi desa untuk optimalisasi layanan publik dan transparansi data pemerintahan desa.",
    tags: ["OpenGov", "PHP", "Community Powered"],
    impact: "10,000+ Desa",
    image: "/images/projects/opensid.webp",
    link: "https://opensid.my.id",
  },
  {
    title: "KonXC Core Framework",
    category: "Internal / Infrastructure",
    description:
      "Meta-framework internal untuk mempercepat pengembangan aplikasi enterprise dengan standar arsitektur modular.",
    tags: ["TypeScript", "Microservices", "System Design"],
    impact: "Internal Ops",
    image: "/images/projects/core.webp",
    link: "#",
  },
];

const categories = [
  "All",
  "Web Development",
  "Mobile Apps",
  "Cloud",
  "Open Source",
  "Security",
];
---

<UnifiedLayout
  title="Portfolio Proyek Unggulan - KonXC"
  description="Koleksi proyek mercusuar dan solusi teknologi yang telah kami kembangkan untuk memberdayakan komunitas dan bisnis."
  showNewsletter={false}
  headerVariant="transparent"
>
  <!-- 1. Hero Section -->
  <section class="relative overflow-hidden bg-site pt-24 pb-20 md:pt-32 md:pb-32">
    <div class="absolute inset-0 -z-10 overflow-hidden opacity-30">
      <div
        class="absolute right-1/4 bottom-0 h-[500px] w-[500px] rounded-full bg-teal-500/10 blur-[150px] dark:bg-teal-900/20"
      >
      </div>
    </div>

    <div class="relative z-10 container">
      <div class="text-center">
        <div
          class="text-primary-500 mb-4 inline-flex items-center gap-3 text-xs font-bold tracking-[0.3em] uppercase"
        >
          <span class="bg-primary-500 h-px w-8"></span>
          Lighthouse Projects
          <span class="bg-primary-500 h-px w-8"></span>
        </div>
        <h1
          class="mb-8 text-5xl font-black tracking-tight text-on-site md:text-8xl"
        >
          IMPACT BY <span class="text-gradient-accent px-2">CODE</span>.
        </h1>
        <p class="mx-auto max-w-2xl text-lg text-on-muted">
          Dari sistem pemerintahan desa hingga alat keamanan siber, kode kami
          membangun infrastruktur digital masa depan Indonesia.
        </p>
      </div>
    </div>
  </section>

  <!-- 2. Portfolio Grid -->
  <section class="bg-site py-24">
    <div class="container">
      <!-- Category Filter -->
      <div class="mb-16 flex flex-wrap justify-center gap-4">
        {
          categories.map((cat) => (
            <button class="hover:border-primary-500 rounded-full border border-border-site bg-muted px-6 py-2 text-xs font-black tracking-widest text-on-muted uppercase transition-all hover:bg-surface hover:text-on-site">
              {cat}
            </button>
          ))
        }
      </div>

      <div class="grid gap-12 md:grid-cols-2">
        {
          projects.map((project) => (
            <div class="group relative overflow-hidden rounded-[2.5rem] border border-border-site bg-surface transition-all duration-500 hover:bg-muted">
              {/* Project Image Placeholder/Preview */}
              <div class="relative aspect-video overflow-hidden bg-muted">
                <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent opacity-60" />
                <div class="absolute inset-0 flex rotate-12 items-center justify-center text-4xl font-black tracking-[0.5em] text-on-site/5 uppercase">
                  {project.title.split(" ")[0]}
                </div>
              </div>

              <div class="p-10">
                <div class="mb-4 flex items-center justify-between">
                  <span class="text-primary-500 text-[10px] font-black tracking-widest uppercase">
                    {project.category}
                  </span>
                  <span class="rounded-full bg-teal-500/10 px-3 py-1 text-[10px] font-black text-teal-600 dark:text-teal-400 uppercase ring-1 ring-teal-500/20">
                    {project.impact}
                  </span>
                </div>

                <h3 class="group-hover:text-primary-600 mb-4 text-3xl font-black tracking-tight text-on-site transition-colors dark:group-hover:text-primary-400">
                  {project.title}
                </h3>

                <p class="mb-8 leading-relaxed text-on-muted">
                  {project.description}
                </p>

                <div class="mb-10 flex flex-wrap gap-3">
                  {project.tags.map((tag) => (
                    <span class="border-b border-border-site pb-1 text-[9px] font-black tracking-widest text-on-muted uppercase">
                      #{tag}
                    </span>
                  ))}
                </div>

                <a
                  href={project.link}
                  class="group-hover:text-primary-600 inline-flex items-center gap-3 text-xs font-black tracking-[0.2em] text-on-site uppercase transition-all dark:group-hover:text-primary-400"
                >
                  View Operations
                  <svg
                    class="h-4 w-4 transition-transform group-hover:translate-x-1"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M17 8l4 4m0 0l-4 4m4-4H3"
                    />
                  </svg>
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 3. Collaboration CTA -->
  <section class="bg-muted py-24">
    <div class="container">
      <div class="flex flex-col items-center text-center">
        <h2 class="mb-8 text-4xl font-black text-on-site md:text-6xl">
          Building something <br /> disruptive?
        </h2>
        <p class="mb-12 max-w-xl text-lg text-on-muted">
          Kami selalu mencari proyek inovatif berikutnya untuk dikolaborasikan.
          Mari buat dampak nyata bersama.
        </p>
        <a
          href="/contact"
          class="bg-primary-600 rounded-full px-12 py-5 font-black tracking-widest text-white transition-all hover:scale-105 active:scale-95 hover:shadow-xl"
        >
          INITIATE CONTACT
        </a>
      </div>
    </div>
  </section>

  <style>
    section {
      @apply relative overflow-hidden;
    }
  </style>
</UnifiedLayout>
