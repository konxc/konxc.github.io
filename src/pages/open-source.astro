---
import UnifiedLayout from "@/layouts/UnifiedLayout.astro";

const openSourceProjects = [
    {
        name: "SLiMS",
        desc: "Library management system standard di Indonesia dengan puluhan ribu instalasi.",
        icon: "📚",
        link: "https://github.com/slims/slims9_bulian",
    },
    {
        name: "DracOS",
        desc: "Operating system Indonesia yang dibangun dari Linux kernel untuk riset keamanan.",
        icon: "🐉",
        link: "https://dracos-linux.org",
    },
    {
        name: "OpenSID",
        desc: "Platform keterbukaan data dan layanan mandiri desa di seluruh nusantara.",
        icon: "🏘️",
        link: "https://github.com/OpenSID/OpenSID",
    },
];
---

<UnifiedLayout
    title="Koneksi Open Source - Membangun Ekosistem Digital Berdaulat"
    description="Daftar proyek open source yang dikelola atau didukung oleh Koneksi untuk mempercepat kemandirian teknologi Indonesia."
    showNewsletter={false}
    headerVariant="transparent"
    theme="dark"
>
    <!-- 1. Open Source Hero -->
    <section class="relative overflow-hidden pt-24 pb-20 md:pt-32 md:pb-32">
        <div class="absolute inset-0 -z-10 bg-[#0a0a0b]">
            <div
                class="absolute inset-0 bg-[radial-gradient(circle_at_20%_30%,rgba(34,197,94,0.1)_0%,transparent_50%)]"
            >
            </div>
        </div>

        <div class="relative z-10 container">
            <div class="text-center">
                <div
                    class="text-primary-500 mb-6 text-xs font-black tracking-[0.4em] uppercase"
                >
                    // The Open Collective
                </div>
                <h1
                    class="mb-8 text-5xl font-black tracking-tight text-white uppercase md:text-8xl"
                >
                    Code is <span
                        class="inline-block bg-gradient-to-r from-teal-400 to-green-500 bg-clip-text px-4 text-transparent italic"
                        >Freedom</span
                    >.
                </h1>
                <p class="mx-auto max-w-2xl text-lg text-neutral-400">
                    Membangun teknologi yang inklusif, transparan, dan dapat
                    diakses oleh semua orang melalui inisiatif sumber terbuka
                    yang berkelanjutan.
                </p>
            </div>
        </div>
    </section>

    <!-- 2. Impact Stats Area -->
    <section class="bg-[#0a0a0b] py-24">
        <div class="container">
            <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
                <div>
                    <h2
                        class="mb-8 text-4xl font-black tracking-tight text-white uppercase"
                    >
                        Why we <span class="text-primary-500">Share</span>.
                    </h2>
                    <div class="space-y-6 leading-relaxed text-neutral-400">
                        <p>
                            Di KonXC, kami percaya bahwa inovasi terbaik lahir
                            dari kolaborasi tanpa batas. Inisiatif open source
                            bukan hanya tentang memberikan kode gratis, tapi
                            tentang membangun standar kualitas yang dapat diuji
                            bersama.
                        </p>
                        <p>
                            Kami bangga mendukung proyek-proyek yang telah
                            mendigitalisasi perpustakaan, desa, hingga
                            memperkuat pertahanan siber di tingkat nasional.
                        </p>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    {
                        [
                            { label: "Contributors", value: "1000+" },
                            { label: "Public Repos", value: "50+" },
                            { label: "Stars logged", value: "25K+" },
                            { label: "Community", value: "Global" },
                        ].map((stat) => (
                            <div class="rounded-3xl border border-white/5 bg-white/5 p-8 text-center">
                                <div class="mb-2 text-3xl font-black text-white">
                                    {stat.value}
                                </div>
                                <div class="text-[10px] font-black tracking-widest text-neutral-500 uppercase">
                                    {stat.label}
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </section>

    <!-- 3. Project Cards -->
    <section class="bg-[#0a0a0b] py-24">
        <div class="container">
            <div class="grid gap-8 md:grid-cols-3">
                {
                    openSourceProjects.map((project) => (
                        <a
                            href={project.link}
                            class="group relative block rounded-[2.5rem] border border-white/5 bg-white/5 p-12 transition-all hover:bg-white/10"
                        >
                            <div class="mb-8 text-5xl transition-transform group-hover:scale-110">
                                {project.icon}
                            </div>
                            <h3 class="mb-4 text-2xl font-black text-white">
                                {project.name}
                            </h3>
                            <p class="mb-8 text-sm leading-relaxed text-neutral-400">
                                {project.desc}
                            </p>
                            <span class="text-primary-500 flex items-center gap-2 text-[10px] font-black tracking-widest uppercase">
                                View Repo
                                <svg
                                    class="h-4 w-4 transition-transform group-hover:translate-x-1"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M17 8l4 4m0 0l-4 4m4-4H3"
                                    />
                                </svg>
                            </span>
                        </a>
                    ))
                }
            </div>
        </div>
    </section>

    <style>
        @reference "@/styles/global.css";
        :global(body) {
            @apply bg-[#0a0a0b] antialiased;
        }
    </style>
</UnifiedLayout>
