---
import UnifiedLayout from "@/layouts/UnifiedLayout.astro";

const docCategories = [
  {
    title: "Getting Started",
    links: ["Introduction", "Quick Start Guide", "Architecture Overview"],
  },
  {
    title: "Services Documentation",
    links: ["Cloud Setup", "Software SDK", "Web Guidelines"],
  },
  {
    title: "Community",
    links: ["Contributing Rules", "Code of Conduct", "Security Policy"],
  },
];
---

<UnifiedLayout
  title="Dokumentasi Teknis - KonXC Knowledge Base"
  description="Pusat bantuan dan dokumentasi teknis untuk seluruh layanan, produk, dan inisiatif sumber terbuka KonXC."
  headerVariant="transparent"
>
  <!-- 1. Docs Hero -->
  <section
    class="bg-site relative overflow-hidden pt-24 pb-20 md:pt-32 md:pb-32"
  >
    <div class="absolute inset-0 -z-10 overflow-hidden opacity-30">
      <div
        class="bg-primary-500/10 dark:bg-primary-900/20 absolute top-0 right-1/4 h-96 w-96 rounded-full blur-[120px]"
      >
      </div>
    </div>

    <div class="relative z-10 container">
      <div class="max-w-3xl">
        <div
          class="text-primary-500 mb-6 text-xs font-black tracking-[0.3em] uppercase"
        >
          // Knowledge Base
        </div>
        <h1
          class="text-on-site mb-8 text-5xl font-black tracking-tighter uppercase md:text-8xl"
        >
          Build with <span class="text-gradient px-2 italic">Precision</span>.
        </h1>
        <div class="relative max-w-xl">
          <input
            type="text"
            placeholder="Search documentation..."
            class="focus:border-primary-500 focus:ring-primary-500/10 border-border-site bg-surface text-on-site w-full rounded-2xl border px-8 py-5 backdrop-blur-md focus:ring-4 focus:outline-none"
          />
          <div class="text-on-muted absolute top-1/2 right-6 -translate-y-1/2">
            <svg
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Main Content Grid -->
  <section class="bg-site py-24">
    <div class="container">
      <div class="grid gap-12 lg:grid-cols-[300px_1fr]">
        <!-- Sidebar Nav -->
        <sidebar class="hidden space-y-12 lg:block">
          {
            docCategories.map((cat) => (
              <div>
                <h4 class="text-on-site mb-6 text-xs font-black tracking-[0.2em] uppercase">
                  {cat.title}
                </h4>
                <ul class="space-y-4">
                  {cat.links.map((link) => (
                    <li>
                      <a
                        href="#"
                        class="hover:text-primary-600 dark:hover:text-primary-400 text-on-muted text-sm transition-colors"
                      >
                        {link}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </sidebar>

        <!-- Content Preview -->
        <div class="space-y-16">
          <div
            class="border-border-site bg-surface rounded-[3rem] border p-12 md:p-20"
          >
            <h2 class="text-on-site mb-8 text-4xl font-black tracking-tight">
              Introduction to KonXC Core.
            </h2>
            <div class="text-on-muted max-w-none leading-relaxed font-medium">
              <p class="mb-6">
                Selamat datang di dokumentasi resmi KonXC. Panduan ini dirancang
                untuk membantu Anda memahami standar arsitektur dan metodologi
                kerja kami.
              </p>
              <p class="text-on-site/80 mb-8 font-bold italic">
                "Efficiency through standardization, innovation through
                collaboration."
              </p>

              <div class="mt-12 grid gap-6 md:grid-cols-2">
                <div
                  class="border-border-site bg-muted hover:bg-surface rounded-3xl border p-8 transition-all"
                >
                  <h4 class="text-on-site mb-2 font-bold">
                    Technical Standards
                  </h4>
                  <p class="text-on-muted text-sm">
                    Pelajari konvensi penulisan kode dan standar keamanan yang
                    kami terapkan pada seluruh proyek.
                  </p>
                </div>
                <div
                  class="border-border-site bg-muted hover:bg-surface rounded-3xl border p-8 transition-all"
                >
                  <h4 class="text-on-site mb-2 font-bold">
                    Architecture Patterns
                  </h4>
                  <p class="text-on-muted text-sm">
                    Eksplorasi bagaimana kami membangun sistem terdistribusi
                    yang skalabel dan resilien.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    section {
      @apply relative overflow-hidden;
    }
  </style>
</UnifiedLayout>
