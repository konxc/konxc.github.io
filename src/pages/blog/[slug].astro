---
import { getCollection, type CollectionEntry } from "astro:content";
import BlogSlugLayout from "@layouts/BlogSlugLayout.astro";
import SocialShare from "@components/blog/SocialShare.astro";

import SmartBlogTestingSuite from "@components/blog/SmartBlogTestingSuite.astro";
import ReadingAnalytics from "@components/blog/ReadingAnalytics.astro";
import ArticleSeries from "@components/blog/ArticleSeries.astro";
import InteractiveDemos from "@components/blog/InteractiveDemos.astro";
import ReadingMode from "@components/blog/ReadingMode.astro";
import PerformanceOptimizer from "@components/blog/PerformanceOptimizer.astro";
import RelatedArticles from "@components/blog/RelatedArticles.astro";
import BlogPostHero from "@components/blog/BlogPostHero.astro";
import BlogPostSidebar from "@components/blog/BlogPostSidebar.astro";
import MermaidRenderer from "@components/blog/MermaidRenderer.astro";
import BlogPostComments from "@components/blog/BlogPostComments.astro";
import { getRelatedArticles } from "@utils/blog";

// Type declaration for URL global
declare const URL: typeof globalThis.URL;

export const prerender = true;

type Props = {
  post: CollectionEntry<"blog">;
};

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post: CollectionEntry<"blog">) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post }: Props = Astro.props;
const { Content } = await post.render();

// Generate full URL for SEO/Social
const fullUrl = new URL(Astro.url.pathname, Astro.site).toString();

// Get related articles for current post
const relatedArticles = await getRelatedArticles(post, 4);
---

<BlogSlugLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.coverImage}
  post={post}
  keywords={post.data.tags?.join(", ")}
  author={post.data.author}
  showNewsletter={false}
>
  <!-- Hero Section -->
  <BlogPostHero post={post} />

  <!-- Main Content Layout -->
  <section class="bg-site py-10 md:py-14">
    <div class="container">
      <div class="mx-auto max-w-6xl">
        <ArticleSeries currentPostSlug={post.slug} />

        <div class="grid gap-12 lg:grid-cols-4">
          <!-- Main Article Area -->
          <div class="lg:col-span-3">
            <article
              class="prose prose-lg dark:prose-invert blog-content max-w-none"
            >
              <Content />
            </article>

            <div class="mt-12 space-y-12">
              {
                post.data.interactiveDemos &&
                  post.data.interactiveDemos.length > 0 && (
                    <InteractiveDemos demos={post.data.interactiveDemos} />
                  )
              }
              <SocialShare
                title={post.data.title}
                url={fullUrl}
                description={post.data.description}
              />
            </div>
          </div>

          <!-- Sidebar Area -->
          <aside class="lg:col-span-1">
            <BlogPostSidebar post={post} />
          </aside>
        </div>
      </div>
    </div>
  </section>

  <!-- Support Components -->
  <SmartBlogTestingSuite />
  <ReadingAnalytics postSlug={post.slug} />
  <ReadingMode />
  <PerformanceOptimizer />
  <MermaidRenderer />

  <!-- Footer Sections -->
  {
    relatedArticles.length > 0 && (
      <RelatedArticles
        articles={relatedArticles}
        title="Artikel Terkait"
        columns={2}
        maxArticles={4}
      />
    )
  }

  <BlogPostComments postSlug={post.slug} />
</BlogSlugLayout>

<style>
  @reference "@/styles/global.css";

  /* Professional Blog Content Typography */
  .blog-content {
    @apply text-on-site antialiased;
    font-family: var(--font-body);
    font-size: 1.125rem;
    line-height: 1.55;
  }

  .blog-content :global(h1),
  .blog-content :global(h2),
  .blog-content :global(h3),
  .blog-content :global(h4) {
    @apply text-on-site font-bold tracking-tight;
    font-family: var(--font-heading);
    line-height: 1.2;
    margin-top: 1.25rem;
    margin-bottom: 0px !important;
    padding-bottom: 0px !important;
  }

  .blog-content :global(h1) {
    @apply mt-0 text-4xl lg:text-5xl;
    margin-bottom: 2rem !important;
  }
  .blog-content :global(h2) {
    @apply mt-6 text-2xl lg:text-3xl;
    border-bottom: 1px solid var(--color-border-site);
  }
  .blog-content :global(h3) {
    @apply mt-5 text-xl lg:text-2xl;
  }
  .blog-content :global(h4) {
    @apply mt-4 text-lg lg:text-xl;
  }

  .blog-content :global(p) {
    @apply mb-3;
  }

  /* Lead paragraph special styling */
  .blog-content :global(p:first-of-type) {
    @apply text-on-muted mb-4 text-lg leading-relaxed font-medium lg:text-xl;
  }

  /* Links */
  .blog-content :global(a) {
    @apply text-primary-600 decoration-primary-200 hover:text-primary-700 hover:decoration-primary-600 font-semibold underline decoration-2 underline-offset-4 transition-all;
  }

  /* Lists & Markers */
  .blog-content :global(ul),
  .blog-content :global(ol) {
    @apply mb-4 pl-6;
  }

  .blog-content :global(li) {
    @apply pl-1;
  }

  .blog-content :global(ul li) {
    @apply list-disc;
  }
  .blog-content :global(ol li) {
    @apply list-decimal;
  }
  .blog-content :global(li::marker) {
    @apply text-primary-600 font-bold;
  }

  /* Blockquotes - Modern Minimalist */
  .blog-content :global(blockquote) {
    @apply border-primary-500 bg-muted my-4 rounded-r-2xl border-l-4 px-5 py-3 italic;
    font-size: 1.1rem;
    line-height: 1.5;
    @apply text-on-muted;
  }

  /* Code Blocks */
  .blog-content :global(pre) {
    @apply mt-0 mb-4 overflow-x-auto rounded-xl bg-neutral-900 p-4 text-sm text-neutral-200 shadow-lg;
  }
  .blog-content :global(code) {
    @apply text-primary-700 bg-muted rounded-md px-1 py-0.5 font-mono text-xs font-medium;
  }
  .blog-content :global(pre code) {
    @apply bg-transparent p-0 text-inherit;
  }

  /* Images & Figures */
  .blog-content :global(img) {
    @apply my-5 h-auto w-full rounded-xl shadow-lg transition-transform duration-500 hover:scale-[1.005];
  }
  .blog-content :global(figcaption) {
    @apply text-on-muted mt-2 text-center text-xs italic;
  }

  /* Tables */
  .blog-content :global(table) {
    @apply my-4 w-full border-collapse text-left text-sm;
  }
  .blog-content :global(th) {
    @apply border-border-site bg-muted text-on-site border-b px-2 py-1.5 font-bold;
  }
  .blog-content :global(td) {
    @apply border-border-site text-on-muted border-b px-2 py-1.5;
  }

  /* Dark Mode Overrides - Simplified by Tokens */
  .dark .blog-content :global(code) {
    @apply text-primary-300;
  }
  .dark .blog-content :global(li::marker) {
    @apply text-primary-400;
  }

  /* Mobile Adjustments */
  @media (max-width: 768px) {
    .blog-content {
      font-size: 0.95rem;
    }
    .blog-content :global(h1) {
      font-size: 1.75rem;
    }
    .blog-content :global(h2) {
      font-size: 1.35rem;
      margin-top: 0.75rem;
    }
    .blog-content :global(p:first-of-type) {
      font-size: 1rem;
      @apply mb-3;
    }
    .blog-content :global(blockquote) {
      font-size: 0.95rem;
      @apply my-3 px-4 py-2;
    }
    .blog-content :global(pre),
    .blog-content :global(img),
    .blog-content :global(table) {
      @apply my-3;
    }
  }
</style>
