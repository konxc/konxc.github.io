---
import { getCollection, type CollectionEntry } from "astro:content";
import UnifiedLayout from "@/layouts/UnifiedLayout.astro";
import FeaturedGrid from "@/components/blog/FeaturedGrid.astro";
import PostsGrid from "@/components/blog/PostsGrid.astro";
import BlogSidebar from "@/components/blog/BlogSidebar.astro";
import AdvancedSearch from "@/components/blog/AdvancedSearch.astro";
import Pagination from "@/components/blog/Pagination.astro";
import type { Page, GetStaticPathsOptions } from "astro";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const allPosts = await getCollection("blog");
  const sortedPosts = allPosts.sort(
    (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
  );

  // We paginate with 6 items per page for a compact 2-column grid.
  // On page 1: 2 will be featured, 4 will be regular grid posts (2 rows of 2).
  // On page 2+: all 6 will be regular grid posts (3 rows of 2).
  return paginate(sortedPosts, { pageSize: 6 });
}

interface Props {
  page: Page<CollectionEntry<"blog">>;
}

const { page } = Astro.props;
const currentPagePosts = page.data;

// SEO
const title = `Blog & Wawasan ${page.currentPage > 1 ? `- Halaman ${page.currentPage}` : ""} - KonXC Portfolio`;
const description =
  "Teknologi, tutorial coding, dan wawasan industri dari tim KonXC.";

// Fetch ALL posts for sidebar and search script
const allPosts = await getCollection("blog");
const sortedAllPosts = allPosts.sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

// Group Posts for Page 1 Layout
let featuredPost: CollectionEntry<"blog"> | undefined = undefined;
let secondaryPosts: CollectionEntry<"blog">[] = [];
let remainingPosts = currentPagePosts;

if (page.currentPage === 1) {
  featuredPost = currentPagePosts[0];
  secondaryPosts = currentPagePosts.slice(1, 3);
  remainingPosts = currentPagePosts.slice(3);
}

// Extract Categories and Tags for Sidebar from ALL posts
const categories = [...new Set(allPosts.map((post) => post.data.category))];
const tags = [...new Set(allPosts.flatMap((post) => post.data.tags))].slice(
  0,
  15,
);
---

<UnifiedLayout title={title} description={description} showNewsletter={false}>
  {/* Advanced Search Modal (Hidden by default) */}
  <AdvancedSearch />

  <div class="space-y-16 pt-8 pb-16 md:space-y-24 md:pt-12 md:pb-24">
    {/* 1. Hero Section: Featured Grid (Only on Page 1) */}
    {
      page.currentPage === 1 && (
        <div class="container">
          <div class="mb-8 flex flex-col justify-between gap-4 border-b border-neutral-200 pb-6 md:flex-row md:items-end dark:border-neutral-800">
            <div>
              <h1 class="text-4xl font-bold tracking-tight text-neutral-900 sm:text-5xl dark:text-neutral-100">
                Wawasan & Cerita
              </h1>
              <p class="mt-4 text-lg text-neutral-600 dark:text-neutral-400">
                Artikel terbaru seputar pengembangan web, teknologi, dan desain.
              </p>
            </div>
            <button
              onclick="document.getElementById('advanced-search-modal').classList.remove('hidden'); document.getElementById('advanced-search-input').focus();"
              class="group hover:border-primary-500 hover:text-primary-600 border-border-site bg-surface text-on-muted flex items-center gap-2 rounded-full border px-5 py-2.5 text-sm font-medium transition-all hover:shadow-md"
            >
              <svg
                class="group-hover:text-primary-500 text-on-muted h-4 w-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                />
              </svg>
              <span>Pencarian Cepat...</span>
              <kbd class="border-border-site bg-muted text-on-muted hidden rounded border px-1.5 py-0.5 text-xs sm:inline-block">
                ⌘K
              </kbd>
            </button>
          </div>

          {featuredPost && (
            <FeaturedGrid
              featuredPost={featuredPost as CollectionEntry<"blog">}
              secondaryPosts={secondaryPosts}
            />
          )}
        </div>
      )
    }

    {/* 2. Main Content Area */}
    <div class="container">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        {/* Left Column: Content River */}
        <div class="lg:col-span-8">
          <div class="mb-12">
            <div class="mb-8">
              <h2 class="text-on-site text-2xl font-bold">Artikel Terbaru</h2>
            </div>

            <PostsGrid
              posts={remainingPosts}
              useContainer={false}
              columns={2}
            />

            {/* Pagination Controls */}
            <Pagination page={page} />
          </div>
        </div>

        {/* Right Column: Sidebar */}
        <aside class="lg:col-span-4">
          <BlogSidebar categories={categories} tags={tags} />
        </aside>
      </div>
    </div>
  </div>

  {/* Client-side Search Data Fallback */}
  <script
    is:inline
    id="posts-data"
    type="application/json"
    set:html={JSON.stringify(
      sortedAllPosts.map((p) => ({
        title: p.data.title,
        description: p.data.description,
        slug: p.id,
        publishDate: p.data.publishDate,
        tags: p.data.tags,
        category: p.data.category,
        author: p.data.author,
        readingTime: p.data.readingTime,
        featured: p.data.featured,
      })),
    )}
  />
</UnifiedLayout>
