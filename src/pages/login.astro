---
export const prerender = false;

import Head from "../components/Head.astro";
import "@styles/global.css";
import { LoginForm } from "../components/auth/LoginForm";

if (Astro.locals.session) {
  return Astro.redirect("/app");
}
---

<!doctype html>
<html lang="id">
  <head>
    <Head
      title="Masuk | Konxc Community"
      description="Masuk ke platform komunitas UMKM Konxc."
    />
  </head>
  <body class="flex min-h-screen items-center justify-center bg-gray-50 p-4">
    <div class="w-full max-w-md overflow-hidden rounded-2xl bg-white shadow-xl">
      <div class="p-8">
        <div class="mb-8 text-center">
          <h1
            class="mb-2 bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-3xl font-bold text-transparent"
          >
            KonXC
          </h1>
          <p class="text-gray-500">
            Masuk untuk terhubung dengan komunitas UMKM
          </p>
        </div>

        <LoginForm client:visible />

        <div class="mt-6 text-center text-sm text-gray-500">
          Belum punya akun? <a
            href="/register"
            class="font-medium text-blue-600 hover:underline">Daftar sekarang</a
          >
        </div>
      </div>
      <div
        class="border-t border-gray-100 bg-gray-50 px-8 py-4 text-center text-xs text-gray-400"
      >
        &copy; {new Date().getFullYear()} Konxc. All rights reserved.
      </div>
    </div>
  </body>
</html>
