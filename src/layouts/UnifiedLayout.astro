---
// Unified Layout - Keep It Simple Approach
import "@styles/global.css";
import Head from "@components/Head.astro";
import Header from "@components/ui/Header.astro";
import Footer from "@components/ui/Footer.astro";
import SkipLinks from "@components/accessibility/SkipLinks.astro";
import FocusManager from "@components/accessibility/FocusManager.astro";

export interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  headerVariant?: "default" | "transparent" | "minimal";
  footerVariant?: "default" | "minimal" | "extended";
  showSearch?: boolean;
  showNewsletter?: boolean;
  theme?: "light" | "dark" | "system";
}

const {
  title,
  description,
  image,
  canonical,
  headerVariant = "default",
  footerVariant = "extended",
  showSearch = true,
  showNewsletter = true,
} = Astro.props;
---

<!doctype html>
<html lang="id" class="">
  <head>
    <Head
      title={title}
      description={description}
      image={image}
      canonical={canonical}
    />
    {
      /* Theme initialization disabled for production env
    <script is:inline>
      // Immediately invoked function to set the theme before the page renders
      (function () {
        try {
          const savedTheme = localStorage.getItem("theme");
          const systemPrefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)",
          ).matches;

          const shouldBeDark =
            savedTheme === "dark" || (!savedTheme && systemPrefersDark);

          if (shouldBeDark) {
            document.documentElement.classList.add("dark");
          } else {
            document.documentElement.classList.remove("dark");
          }
        } catch (e) {
          console.error("Theme initialization failed:", e);
        }
      })();
    </script>
    */
    }</head
  >
  <!-- Theme Initialization Script (Prevents Flickering) -->

  <body>
    <SkipLinks />
    <FocusManager />

    <Header variant={headerVariant} showSearch={showSearch} />

    <main id="main-content" role="main">
      <slot />
    </main>

    <Footer variant={footerVariant} showNewsletter={showNewsletter} />
  </body>
</html>
