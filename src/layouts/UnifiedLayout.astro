---
// Unified Layout - Keep It Simple Approach
import "@styles/global.css";
import Head from "@components/Head.astro";
import Header from "@components/ui/Header.astro";
import Footer from "@components/ui/Footer.astro";
import SkipLinks from "@components/accessibility/SkipLinks.astro";
import FocusManager from "@components/accessibility/FocusManager.astro";

export interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  headerVariant?: "default" | "transparent" | "minimal";
  footerVariant?: "default" | "minimal" | "extended";
  showSearch?: boolean;
  showNewsletter?: boolean;
}

const {
  title,
  description,
  image,
  canonical,
  headerVariant = "default",
  footerVariant = "extended",
  showSearch = true,
  showNewsletter = true,
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <Head
      title={title}
      description={description}
      image={image}
      canonical={canonical}
    />
  </head>
  <!-- Theme Initialization Script (Prevents Flickering) -->

  <body>
    <!-- Skip Links & Accessibility -->
    <SkipLinks />
    <FocusManager />

    <Header variant={headerVariant} showSearch={showSearch} />

    <main id="main-content" role="main">
      <slot />
    </main>

    <Footer variant={footerVariant} showNewsletter={showNewsletter} />

    <!-- AOS (Animate On Scroll) Initialization -->
    <link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" />
    <script is:inline src="https://unpkg.com/aos@next/dist/aos.js"></script>
    <script is:inline>
      document.addEventListener("DOMContentLoaded", function () {
        if (typeof AOS !== "undefined") {
          AOS.init({
            duration: 800,
            easing: "ease-in-out",
            once: true,
            offset: 50,
          });
        }
      });
    </script>
  </body>
</html>
