---
import "@styles/global.css";
import Head from "@components/Head.astro";
import Footer from "@components/ui/Footer.astro";
import SmartHeaderFixed from "@components/blog/SmartHeaderFixed.astro";
import type { CollectionEntry } from "astro:content";

export interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  headerVariant?: "default" | "transparent" | "minimal";
  footerVariant?: "default" | "minimal" | "extended";
  post?: CollectionEntry<"blog">;
  keywords?: string;
  author?: string;
  noindex?: boolean;
  showNewsletter?: boolean;
}

const {
  title,
  description,
  image,
  canonical,
  footerVariant = "extended",
  post,
  keywords,
  author,
  noindex = false,
  showNewsletter = true,
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <Head
      title={title}
      description={description}
      image={image}
      canonical={canonical}
      type="article"
      post={post}
      keywords={keywords}
      author={author}
      noindex={noindex}
    />
    {
      /* Theme initialization disabled for production env
    <script is:inline>
      // Immediately invoked function to set the theme before the page renders
      (function () {
        try {
          const savedTheme = localStorage.getItem("theme");
          const systemPrefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)",
          ).matches;

          const shouldBeDark =
            savedTheme === "dark" || (!savedTheme && systemPrefersDark);

          if (shouldBeDark) {
            document.documentElement.classList.add("dark");
          } else {
            document.documentElement.classList.remove("dark");
          }
        } catch (e) {
          console.error("Theme initialization failed:", e);
        }
      })();
    </script>
    */
    }</head
  >
  <!-- Theme Initialization Script (Prevents Flickering) -->

  <body>
    <SmartHeaderFixed />

    <main>
      <slot />
    </main>

    <Footer variant={footerVariant} showNewsletter={showNewsletter} />
  </body>
</html>
